// The execution mode is a nested namespace: nn.mode.fast() and
// nn.mode.deterministic().
public import mode = "./mode.qui"
import math
import internal = "./internal.qui"
import native = "./native.qui"

tensor<real32> relu(tensor<real32> value);
tensor<real32> gelu(tensor<real32> value);

class Parameter<T: floating>(local tensor<T> value)

    private tensor<T> storage
    private autograd.Target gradient_state
    if value.is_tracked()
        storage = value.untrack()
    else
        storage = value
    gradient_state = autograd.target()

    tensor<T> raw()
        if storage.is_tracked()
            return storage.untrack()
        return storage

    tensor<T> .track()
        return storage.track(&gradient_state)

    bool has_grad()
        return gradient_state.has_grad()

    tensor<T> gradient()
        return gradient_state.gradient<T>()

    void .clear_grad()
        .gradient_state.clear_grad()

    void .replace(tensor<T> value)
        if value.is_tracked()
            storage = value.untrack()
        else
            storage = value

class State<T: floating>(local tensor<T> value)

    private tensor<T> storage
    if value.is_tracked()
        storage = value.untrack()
    else
        storage = value

    tensor<T> raw()
        if storage.is_tracked()
            return storage.untrack()
        return storage

    void .replace(tensor<T> value)
        if value.is_tracked()
            storage = value.untrack()
        else
            storage = value

// Explicit NN distributed-training collective. `devices` gives the destination
// of each reduced value: -1 means CPU, otherwise the explicit GPU index.
// Fast mode uses package-owned NCCL when every input is already on its matching
// CUDA destination. Other placements and deterministic mode preserve the
// portable host-staged path without teaching Core collective semantics.
void | error all_reduce_sum<T: floating>(
    tensor<T>[] &values,
    int[] devices
)
    if len(values) != len(devices)
        return error("nn.all_reduce_sum requires one destination device per tensor", code = "NN_SHAPE")
    if len(values) == 0
        return

    nat[] shape = values[0].shape()
    for 0 <= nat index < len(values)
        if values[index].is_tracked()
            return error("nn.all_reduce_sum requires untracked tensors; reduce gradients after backward or call untrack() explicitly", code = "NN_TRACKED")
        if values[index].shape() != shape
            return error("nn.all_reduce_sum requires identical tensor shapes", code = "NN_SHAPE")
        if devices[index] < -1
            return error("nn.all_reduce_sum device must be -1 for CPU or a nonnegative GPU index", code = "NN_DEVICE")

    bool all_gpu_destinations = len(values) > 1
    for auto device = devices[]
        if device < 0
            all_gpu_destinations = false

    // A collective can use its existing placement only when every tensor is
    // already on the requested device. Other placements keep the host path.
    if all_gpu_destinations
        for 0 <= nat index < len(values)
            if int(values[index].device()) != devices[index]
                all_gpu_destinations = false

    if all_gpu_destinations
        int32 status = native.nccl_collective<T>(&values)
        if status == int32(0)
            return
        if status == int32(2)
            return error("nn.all_reduce_sum failed to start NCCL collective", code = "NN_COLLECTIVE")
        if status == int32(4)
            return error("nn.all_reduce_sum failed to queue output validation", code = "NN_COLLECTIVE")
        if status != int32(1)
            return error("nn.all_reduce_sum NCCL collective failed", code = "NN_COLLECTIVE")

    tensor<T> total = values[0].cpu()
    for 1 <= nat index < len(values)
        total = total + values[index].cpu()

    // Build every destination first so an invalid GPU destination cannot leave
    // only a prefix of the caller's array replaced.
    tensor<T>[] reduced = []
    for auto device = devices[]
        if device == -1
            reduced = reduced.append(total)
        else
            reduced = reduced.append(total.gpu(nat(device)))

    for 0 <= nat index < len(values)
        values[index] = reduced[index]
    return



private Parameter<T>[] parameter_values<T: floating, M>(M model)
    Parameter<T>[] result = []
    for Parameter<T> value = reflect.each<Parameter<T>>(model)[]
        result = result.append(value)
    return result

private State<T>[] state_values<T: floating, M>(M model)
    State<T>[] result = []
    for State<T> value = reflect.each<State<T>>(model)[]
        result = result.append(value)
    return result

private internal.StateEntrySchema[] model_schema<M>(M &model)
    internal.StateEntrySchema[] entries = []
    string[] parameter_paths16 = reflect.each_paths<Parameter<real16>>(model)
    for Parameter<real16> &value = &reflect.each<Parameter<real16>>(&model)[nat index]
        entries = entries.append(internal.StateEntrySchema(kind_initial = "Parameter", dtype_initial = "real16", path_initial = parameter_paths16[index], shape_initial = value.raw().shape()))
    string[] parameter_paths16b = reflect.each_paths<Parameter<real16b>>(model)
    for Parameter<real16b> &value = &reflect.each<Parameter<real16b>>(&model)[nat index]
        entries = entries.append(internal.StateEntrySchema(kind_initial = "Parameter", dtype_initial = "real16b", path_initial = parameter_paths16b[index], shape_initial = value.raw().shape()))
    string[] parameter_paths32 = reflect.each_paths<Parameter<real32>>(model)
    for Parameter<real32> &value = &reflect.each<Parameter<real32>>(&model)[nat index]
        entries = entries.append(internal.StateEntrySchema(kind_initial = "Parameter", dtype_initial = "real32", path_initial = parameter_paths32[index], shape_initial = value.raw().shape()))
    string[] parameter_paths64 = reflect.each_paths<Parameter<real64>>(model)
    for Parameter<real64> &value = &reflect.each<Parameter<real64>>(&model)[nat index]
        entries = entries.append(internal.StateEntrySchema(kind_initial = "Parameter", dtype_initial = "real64", path_initial = parameter_paths64[index], shape_initial = value.raw().shape()))
    string[] state_paths16 = reflect.each_paths<State<real16>>(model)
    for State<real16> &value = &reflect.each<State<real16>>(&model)[nat index]
        entries = entries.append(internal.StateEntrySchema(kind_initial = "State", dtype_initial = "real16", path_initial = state_paths16[index], shape_initial = value.raw().shape()))
    string[] state_paths16b = reflect.each_paths<State<real16b>>(model)
    for State<real16b> &value = &reflect.each<State<real16b>>(&model)[nat index]
        entries = entries.append(internal.StateEntrySchema(kind_initial = "State", dtype_initial = "real16b", path_initial = state_paths16b[index], shape_initial = value.raw().shape()))
    string[] state_paths32 = reflect.each_paths<State<real32>>(model)
    for State<real32> &value = &reflect.each<State<real32>>(&model)[nat index]
        entries = entries.append(internal.StateEntrySchema(kind_initial = "State", dtype_initial = "real32", path_initial = state_paths32[index], shape_initial = value.raw().shape()))
    string[] state_paths64 = reflect.each_paths<State<real64>>(model)
    for State<real64> &value = &reflect.each<State<real64>>(&model)[nat index]
        entries = entries.append(internal.StateEntrySchema(kind_initial = "State", dtype_initial = "real64", path_initial = state_paths64[index], shape_initial = value.raw().shape()))
    return entries

private void | error write_model_entries<M>(file.Handle &output, internal.StateChecksum &checksum, M &model)
    string[] parameter_paths16 = reflect.each_paths<Parameter<real16>>(model)
    for Parameter<real16> &value = &reflect.each<Parameter<real16>>(&model)[nat index]
        try internal.write_state_entry(&output, &checksum, "Parameter", "real16", parameter_paths16[index], value.raw())
    string[] parameter_paths16b = reflect.each_paths<Parameter<real16b>>(model)
    for Parameter<real16b> &value = &reflect.each<Parameter<real16b>>(&model)[nat index]
        try internal.write_state_entry(&output, &checksum, "Parameter", "real16b", parameter_paths16b[index], value.raw())
    string[] parameter_paths32 = reflect.each_paths<Parameter<real32>>(model)
    for Parameter<real32> &value = &reflect.each<Parameter<real32>>(&model)[nat index]
        try internal.write_state_entry(&output, &checksum, "Parameter", "real32", parameter_paths32[index], value.raw())
    string[] parameter_paths64 = reflect.each_paths<Parameter<real64>>(model)
    for Parameter<real64> &value = &reflect.each<Parameter<real64>>(&model)[nat index]
        try internal.write_state_entry(&output, &checksum, "Parameter", "real64", parameter_paths64[index], value.raw())
    string[] state_paths16 = reflect.each_paths<State<real16>>(model)
    for State<real16> &value = &reflect.each<State<real16>>(&model)[nat index]
        try internal.write_state_entry(&output, &checksum, "State", "real16", state_paths16[index], value.raw())
    string[] state_paths16b = reflect.each_paths<State<real16b>>(model)
    for State<real16b> &value = &reflect.each<State<real16b>>(&model)[nat index]
        try internal.write_state_entry(&output, &checksum, "State", "real16b", state_paths16b[index], value.raw())
    string[] state_paths32 = reflect.each_paths<State<real32>>(model)
    for State<real32> &value = &reflect.each<State<real32>>(&model)[nat index]
        try internal.write_state_entry(&output, &checksum, "State", "real32", state_paths32[index], value.raw())
    string[] state_paths64 = reflect.each_paths<State<real64>>(model)
    for State<real64> &value = &reflect.each<State<real64>>(&model)[nat index]
        try internal.write_state_entry(&output, &checksum, "State", "real64", state_paths64[index], value.raw())
    return

void | error save<M>(M model, string path)
    internal.StateEntrySchema[] expected = model_schema(&model)
    try internal.validate_model_schema(expected, "nn.save")
    file.Handle output = try file.create(path)
    internal.StateChecksum checksum = internal.StateChecksum()
    try internal.write_checked_line(&output, &checksum, "QUIDRA_DNN_STATE")
    try internal.write_checked_line(&output, &checksum, "5")
    try internal.write_checked_line(&output, &checksum, "model")
    try internal.write_checked_line(&output, &checksum, reflect.type_name(model))
    try internal.write_checked_line(&output, &checksum, len(expected).string())
    try write_model_entries(&output, &checksum, &model)
    try internal.finish_state_write(&output, checksum)
    return

void | error load<M>(M &model, string path)
    internal.StateEntrySchema[] expected = model_schema(&model)
    try internal.validate_model_schema(expected, "nn.load")
    file.Handle input = try file.open(path)
    internal.StateChecksum checksum = internal.StateChecksum()
    string magic = try internal.read_checked_line(&input, &checksum, "magic")
    if magic != "QUIDRA_DNN_STATE"
        return error("nn.load state file has an unsupported magic", code = "NN_CHECKPOINT_FILE")
    string version = try internal.read_checked_line(&input, &checksum, "format version")
    if version != "2" and version != "5"
        return error("nn.load state file has an unsupported format version", code = "NN_CHECKPOINT_FILE")
    string container_kind = try internal.read_checked_line(&input, &checksum, "container kind")
    if container_kind != "model"
        return error("nn.load state file is not a model-only container", code = "NN_CHECKPOINT_FILE")
    string root_type = try internal.read_checked_line(&input, &checksum, "root model type")
    internal.StateTable stored = try internal.read_model_entries(&input, &checksum, version)
    try internal.verify_state_checksum(&input, checksum)
    try internal.compare_state_schema(expected, stored.schemas, root_type, reflect.type_name(model), "nn.load", path)
    tensor<real16>[] loaded_parameter16 = []
    for auto entry_path = reflect.each_paths<Parameter<real16>>(model)[]
        tensor<real16> value = try internal.select_stored_tensor<real16>(stored.values16, entry_path)
        loaded_parameter16 = loaded_parameter16.append(value)
    tensor<real16b>[] loaded_parameter16b = []
    for auto entry_path = reflect.each_paths<Parameter<real16b>>(model)[]
        tensor<real16b> value = try internal.select_stored_tensor<real16b>(stored.values16b, entry_path)
        loaded_parameter16b = loaded_parameter16b.append(value)
    tensor<real32>[] loaded_parameter32 = []
    for auto entry_path = reflect.each_paths<Parameter<real32>>(model)[]
        tensor<real32> value = try internal.select_stored_tensor<real32>(stored.values32, entry_path)
        loaded_parameter32 = loaded_parameter32.append(value)
    tensor<real64>[] loaded_parameter64 = []
    for auto entry_path = reflect.each_paths<Parameter<real64>>(model)[]
        tensor<real64> value = try internal.select_stored_tensor<real64>(stored.values64, entry_path)
        loaded_parameter64 = loaded_parameter64.append(value)
    tensor<real16>[] loaded_state16 = []
    for auto entry_path = reflect.each_paths<State<real16>>(model)[]
        tensor<real16> value = try internal.select_stored_tensor<real16>(stored.values16, entry_path)
        loaded_state16 = loaded_state16.append(value)
    tensor<real16b>[] loaded_state16b = []
    for auto entry_path = reflect.each_paths<State<real16b>>(model)[]
        tensor<real16b> value = try internal.select_stored_tensor<real16b>(stored.values16b, entry_path)
        loaded_state16b = loaded_state16b.append(value)
    tensor<real32>[] loaded_state32 = []
    for auto entry_path = reflect.each_paths<State<real32>>(model)[]
        tensor<real32> value = try internal.select_stored_tensor<real32>(stored.values32, entry_path)
        loaded_state32 = loaded_state32.append(value)
    tensor<real64>[] loaded_state64 = []
    for auto entry_path = reflect.each_paths<State<real64>>(model)[]
        tensor<real64> value = try internal.select_stored_tensor<real64>(stored.values64, entry_path)
        loaded_state64 = loaded_state64.append(value)
    // All fallible reads, comparisons and preparation precede this commit.
    for Parameter<real16> &entry = &reflect.each<Parameter<real16>>(&model)[nat index]
        .entry.replace(loaded_parameter16[index])
    for Parameter<real16b> &entry = &reflect.each<Parameter<real16b>>(&model)[nat index]
        .entry.replace(loaded_parameter16b[index])
    for Parameter<real32> &entry = &reflect.each<Parameter<real32>>(&model)[nat index]
        .entry.replace(loaded_parameter32[index])
    for Parameter<real64> &entry = &reflect.each<Parameter<real64>>(&model)[nat index]
        .entry.replace(loaded_parameter64[index])
    for State<real16> &entry = &reflect.each<State<real16>>(&model)[nat index]
        .entry.replace(loaded_state16[index])
    for State<real16b> &entry = &reflect.each<State<real16b>>(&model)[nat index]
        .entry.replace(loaded_state16b[index])
    for State<real32> &entry = &reflect.each<State<real32>>(&model)[nat index]
        .entry.replace(loaded_state32[index])
    for State<real64> &entry = &reflect.each<State<real64>>(&model)[nat index]
        .entry.replace(loaded_state64[index])
    return

tensor<real32> | error uniform_weights(int count, real64 bound, int seed)
    if count < 0
        return error("nn.uniform_weights count must be nonnegative", code = "NN_ARGUMENT")
    if not math.is_finite(bound) or bound < 0.0
        return error("nn.uniform_weights bound must be finite and nonnegative", code = "NN_ARGUMENT")
    tensor<real32> values = tensor.zeros<real32>([nat(count)])
    random.Generator generator = random.generator(seed = seed)
    for 0 <= int index < count
        real64 unit = .generator.real64()
        values[index] = real32((unit * 2.0 - 1.0) * bound)
    return values

tensor<real32> | error normal_weights(
    int count,
    real64 standard_deviation,
    int seed
)
    if count < 0
        return error("nn.normal_weights count must be nonnegative", code = "NN_ARGUMENT")
    if not math.is_finite(standard_deviation) or standard_deviation < 0.0
        return error("nn.normal_weights standard deviation must be finite and nonnegative", code = "NN_ARGUMENT")
    tensor<real32> values = tensor.zeros<real32>([nat(count)])
    if standard_deviation == 0.0
        return values

    random.Generator generator = random.generator(seed = seed)
    for 0 <= int index < count
        // 1-u avoids the common zero endpoint; the guard also keeps
        // Box-Muller defined for any future generator endpoint policy.
        real64 radius_uniform = 1.0 - .generator.real64()
        if radius_uniform <= 0.0
            radius_uniform = 0.0000000000000001
        real64 angle_uniform = .generator.real64()
        real64 log_radius = try math.log(radius_uniform)
        real64 radius = try math.sqrt(real64(-2.0) * log_radius)
        real64 standard_normal = (
            radius
            * math.cos(
                real64(6.283185307179586476925286766559005768)
                * angle_uniform
            )
        )
        values[index] = real32(standard_normal * standard_deviation)
    return values

// A layer is a class whose constructor can fail: `nn.FC(128, 64)` fails
// fast on an invalid shape, `try nn.FC(128, 64)` propagates the error.
// Supply both initial_weight and initial_bias to generate a layer from
// prepared Parameters without generating uniform weights.
class FC(
    local int features_in,
    local int features_out,
    local int seed = 1,
    local Parameter<real32> | none initial_weight = none,
    local Parameter<real32> | none initial_bias = none
) | error

    Parameter<real32> weight
    Parameter<real32> bias
    if features_in <= 0 or features_out <= 0
        return error("nn.FC requires positive input and output feature counts", code = "NN_SHAPE")
    if features_out > 9223372036854775807 / features_in
        return error("nn.FC dimensions are too large", code = "NN_SHAPE")
    match initial_weight
        Parameter<real32> provided_weight
            match initial_bias
                Parameter<real32> provided_bias
                    weight = provided_weight
                    bias = provided_bias
                none
                    return error("nn.FC initial values must be supplied together", code = "NN_ARGUMENT")
        none
            match initial_bias
                Parameter<real32> provided_bias
                    return error("nn.FC initial values must be supplied together", code = "NN_ARGUMENT")
                none
                    local int weight_count = features_out * features_in
                    local real64 feature_root = try math.sqrt(real64(features_in))
                    local real64 bound = 1.0 / feature_root
                    local tensor<real32> weight_values = try uniform_weights(
                        weight_count, bound, seed
                    )
                    weight_values = weight_values.reshape([nat(features_out), nat(features_in)])
                    weight = Parameter<real32>(value = weight_values)
                    bias = Parameter<real32>(
                        value = tensor.zeros<real32>([nat(features_out)])
                    )

    tensor<real32> .forward(tensor<real32> value)
        int[] input_shape = int(value.shape())
        int rank = int(len(input_shape))
        if rank < 1
            error("nn.FC requires input rank >= 1", code = "NN_SHAPE")
        int features_in = input_shape[rank - 1]
        int[] weight_shape = int(weight.raw().shape())
        int[] bias_shape = int(bias.raw().shape())
        if len(weight_shape) != 2 or len(bias_shape) != 1
            error("nn.FC requires rank-2 weight and rank-1 bias", code = "NN_SHAPE")
        int features_out = weight_shape[0]
        if weight_shape[1] != features_in or bias_shape[0] != features_out
            error("nn.FC input, weight, and bias dimensions do not match", code = "NN_SHAPE")

        tensor<real32> parameter_weight
        tensor<real32> parameter_bias
        if value.is_tracked()
            parameter_weight = .weight.track()
            parameter_bias = .bias.track()
        else
            parameter_weight = weight.raw()
            parameter_bias = bias.raw()

        tensor<real32> output = math.matmul(
            value,
            parameter_weight.transpose(0, 1)
        )

        // Bias broadcasting is structural: reshape the rank-1 bias to
        // singleton leading axes instead of building an element index array.
        int[] bias_broadcast_shape = array(nat(rank), fill = 1)
        bias_broadcast_shape[rank - 1] = features_out
        return output + parameter_bias.reshape(nat(bias_broadcast_shape))

    // Package-owned compiler fusion target. Untracked CPU inference uses one
    // native linear+bias+ReLU loop. Other calls run forward() and then NN's
    // fused ReLU, whose package-owned custom autograd keeps first- and
    // higher-order semantics without a NN semantic primitive in Core.
    private tensor<real32> .forward_relu(tensor<real32> value)
        if not value.is_tracked()
            int[] input_shape = int(value.shape())
            int rank = int(len(input_shape))
            if rank < 1
                error("nn.FC requires input rank >= 1", code = "NN_SHAPE")
            int features_in = input_shape[rank - 1]
            int[] weight_shape = int(weight.raw().shape())
            int[] bias_shape = int(bias.raw().shape())
            if len(weight_shape) != 2 or len(bias_shape) != 1
                error("nn.FC requires rank-2 weight and rank-1 bias", code = "NN_SHAPE")
            int features_out = weight_shape[0]
            if weight_shape[1] != features_in or bias_shape[0] != features_out
                error("nn.FC input, weight, and bias dimensions do not match", code = "NN_SHAPE")

            tensor<real32> native_input = value
            tensor<real32> native_weight = weight.raw()
            tensor<real32> native_bias = bias.raw()
            if native.is_cpu_f32(native_input) == int32(1) and native.is_cpu_f32(native_weight) == int32(1) and native.is_cpu_f32(native_bias) == int32(1)
                if not native_input.is_contiguous()
                    native_input = native_input.contiguous()
                if not native_weight.is_contiguous()
                    native_weight = native_weight.contiguous()
                if not native_bias.is_contiguous()
                    native_bias = native_bias.contiguous()
                int[] output_shape = input_shape
                output_shape[rank - 1] = features_out
                tensor<real32> native_output = tensor.zeros<real32>(nat(output_shape))
                int32 native_status = native.fc_relu_inference_f32(
                    native_input,
                    native_weight,
                    native_bias,
                    &native_output
                )
                if native_status == int32(0)
                    return native_output

        tensor<real32> output = .forward(value)
        return internal.relu_fused(output)

    // Package-owned compiler fusion target for linear+bias+GELU. The native
    // inference path removes the intermediate FC tensor and activation pass.
    // Other calls apply NN's fused GELU, which evaluates the exact package
    // GELU expression and carries its own first- and second-order autograd.
    private tensor<real32> .forward_gelu(tensor<real32> value)
        if not value.is_tracked()
            int[] input_shape = int(value.shape())
            int rank = int(len(input_shape))
            if rank < 1
                error("nn.FC requires input rank >= 1", code = "NN_SHAPE")
            int features_in = input_shape[rank - 1]
            int[] weight_shape = int(weight.raw().shape())
            int[] bias_shape = int(bias.raw().shape())
            if len(weight_shape) != 2 or len(bias_shape) != 1
                error("nn.FC requires rank-2 weight and rank-1 bias", code = "NN_SHAPE")
            int features_out = weight_shape[0]
            if weight_shape[1] != features_in or bias_shape[0] != features_out
                error("nn.FC input, weight, and bias dimensions do not match", code = "NN_SHAPE")

            tensor<real32> native_input = value
            tensor<real32> native_weight = weight.raw()
            tensor<real32> native_bias = bias.raw()
            if native.is_cpu_f32(native_input) == int32(1) and native.is_cpu_f32(native_weight) == int32(1) and native.is_cpu_f32(native_bias) == int32(1)
                if not native_input.is_contiguous()
                    native_input = native_input.contiguous()
                if not native_weight.is_contiguous()
                    native_weight = native_weight.contiguous()
                if not native_bias.is_contiguous()
                    native_bias = native_bias.contiguous()
                int[] output_shape = input_shape
                output_shape[rank - 1] = features_out
                tensor<real32> native_output = tensor.zeros<real32>(nat(output_shape))
                int32 native_status = native.fc_gelu_inference_f32(
                    native_input,
                    native_weight,
                    native_bias,
                    &native_output
                )
                if native_status == int32(0)
                    return native_output

        tensor<real32> output = .forward(value)
        return internal.gelu_fused(output)


    // Compiler-private inference targets. They deliberately keep the same
    // source contract as forward_relu/forward_gelu; Core may select them only
    // from package descriptor rules. CPU targets reach the package-native
    // fused loop, while the Math targets preserve the portable Math backend.
    private tensor<real32> .forward_relu_inference(tensor<real32> value)
        return .forward_relu(value)

    private tensor<real32> .forward_relu_cpu(tensor<real32> value)
        return .forward_relu(value)

    private tensor<real32> .forward_relu_cuda(tensor<real32> value)
        tensor<real32> output = .forward(value)
        if not output.is_tracked() and output.is_contiguous() and native.cuda_device_f32(output) >= int32(0)
            int32 status = native.cuda_activation_inplace_f32(&output, 1)
            if status == int32(0)
                return output
        return internal.relu_fused(output)

    private tensor<real32> .forward_gelu_inference(tensor<real32> value)
        return .forward_gelu(value)

    private tensor<real32> .forward_gelu_cpu(tensor<real32> value)
        return .forward_gelu(value)

    private tensor<real32> .forward_gelu_cuda(tensor<real32> value)
        tensor<real32> output = .forward(value)
        if not output.is_tracked() and output.is_contiguous() and native.cuda_device_f32(output) >= int32(0)
            int32 status = native.cuda_activation_inplace_f32(&output, 2)
            if status == int32(0)
                return output
        return internal.gelu_fused(output)

class Conv2D(
    local int channels_in,
    local int channels_out,
    local int kernel,
    local int stride = 1,
    local int padding = 0,
    local int seed = 1,
    local int groups = 1,
    local Parameter<real32> | none initial_weight = none,
    local Parameter<real32> | none initial_bias = none
) | error

    Parameter<real32> weight
    Parameter<real32> bias
    int step
    int border
    int group_count = 1
    if channels_in <= 0 or channels_out <= 0
        return error("nn.Conv2D requires positive input and output channel counts", code = "NN_SHAPE")
    if kernel <= 0
        return error("nn.Conv2D kernel must be positive", code = "NN_ARGUMENT")
    if stride <= 0
        return error("nn.Conv2D stride must be positive", code = "NN_ARGUMENT")
    if padding < 0
        return error("nn.Conv2D padding must be nonnegative", code = "NN_ARGUMENT")
    if groups <= 0
        return error("nn.Conv2D groups must be positive", code = "NN_ARGUMENT")
    if channels_in % groups != 0 or channels_out % groups != 0
        return error("nn.Conv2D input and output channels must be divisible by groups", code = "NN_SHAPE")
    if kernel > 9223372036854775807 / kernel
        return error("nn.Conv2D dimensions are too large", code = "NN_SHAPE")
    local int kernel_area = kernel * kernel
    local int channels_per_group = channels_in / groups
    if channels_per_group > 9223372036854775807 / kernel_area
        return error("nn.Conv2D dimensions are too large", code = "NN_SHAPE")
    local int fan_in = channels_per_group * kernel_area
    if channels_out > 9223372036854775807 / fan_in
        return error("nn.Conv2D dimensions are too large", code = "NN_SHAPE")
    match initial_weight
        Parameter<real32> provided_weight
            match initial_bias
                Parameter<real32> provided_bias
                    weight = provided_weight
                    bias = provided_bias
                none
                    return error("nn.Conv2D initial values must be supplied together", code = "NN_ARGUMENT")
        none
            match initial_bias
                Parameter<real32> provided_bias
                    return error("nn.Conv2D initial values must be supplied together", code = "NN_ARGUMENT")
                none
                    local int weight_count = channels_out * fan_in
                    local real64 fan_root = try math.sqrt(real64(fan_in))
                    local real64 bound = 1.0 / fan_root
                    local tensor<real32> weight_values = try uniform_weights(
                        weight_count, bound, seed
                    )
                    weight_values = weight_values.reshape(
                        [nat(channels_out), nat(channels_per_group), nat(kernel), nat(kernel)]
                    )
                    weight = Parameter<real32>(value = weight_values)
                    bias = Parameter<real32>(
                        value = tensor.zeros<real32>([nat(channels_out)])
                    )

    step = stride
    border = padding
    group_count = groups

    private tensor<real32> extract_patches(
        tensor<real32> group_input,
        int batches,
        int weight_channels,
        int padded_height,
        int padded_width,
        int kernel_height,
        int kernel_width,
        int output_height,
        int output_width
    )
        int patch_width = weight_channels * kernel_height * kernel_width
        int patch_rows = batches * output_height * output_width

        if not group_input.is_tracked() and kernel_height == 1 and kernel_width == 1 and step == 1
            // 1x1/stride-1 needs no patch index map. The NHWC transpose is a
            // view, so materialize it explicitly before flattening the rows.
            return group_input.transpose(1, 2).transpose(2, 3).contiguous().reshape(
                [nat(patch_rows), nat(patch_width)]
            )

        if patch_width > 0 and patch_rows > 9223372036854775807 / patch_width
            error("nn.Conv2D patch matrix is too large", code = "NN_SIZE")
        int patch_count = patch_rows * patch_width

        // Native patch extraction is NN-owned and CPU-only today. Probe the
        // borrowed tensor before allocating an output so a GPU fallback never
        // creates an unrelated host patch buffer.
        if not group_input.is_tracked()
            if native.is_cpu_f32(group_input) == int32(1)
                tensor<real32> native_input = group_input
                if not native_input.is_contiguous()
                    native_input = native_input.contiguous()
                tensor<real32> native_patches = tensor.zeros<real32>(
                    [nat(patch_rows), nat(patch_width)]
                )
                int32 native_status = native.im2col_f32(
                    native_input,
                    &native_patches,
                    int64(weight_channels),
                    int64(padded_height),
                    int64(padded_width),
                    int64(kernel_height),
                    int64(kernel_width),
                    int64(step),
                    int64(output_height),
                    int64(output_width)
                )
                if native_status == int32(0)
                    return native_patches

        // Tracked tensors and unsupported native placements stay expressed as
        // generic Core operations so autograd and device semantics remain
        // visible instead of being hidden behind a NN-specific Core primitive.
        int[] patch_indices = array(nat(patch_count), fill = 0)
        for 0 <= int flat_index < patch_count
            int patch_column = flat_index % patch_width
            int patch_row = flat_index / patch_width

            int kernel_x = patch_column % kernel_width
            int patch_remaining = patch_column / kernel_width
            int kernel_y = patch_remaining % kernel_height
            int local_channel = patch_remaining / kernel_height

            int output_x = patch_row % output_width
            int output_remaining = patch_row / output_width
            int output_y = output_remaining % output_height
            int batch = output_remaining / output_height

            int source_y = output_y * step + kernel_y
            int source_x = output_x * step + kernel_x
            patch_indices[flat_index] = (
                ((batch * weight_channels + local_channel) * padded_height
                + source_y) * padded_width + source_x
            )
        return group_input.gather(
            patch_indices,
            [patch_rows, patch_width]
        )

    private tensor<real32> convolve_group(
        tensor<real32> padded_input,
        tensor<real32> parameter_weight,
        int group_index,
        int batches,
        int channels_in,
        int channels_out,
        int weight_channels,
        int padded_height,
        int padded_width,
        int kernel_height,
        int kernel_width,
        int output_height,
        int output_width
    )
        int outputs_per_group = channels_out / group_count
        int input_channel_start = group_index * weight_channels
        int output_channel_start = group_index * outputs_per_group
        int patch_width = weight_channels * kernel_height * kernel_width
        int patch_rows = batches * output_height * output_width

        // NN owns Conv2D patch extraction. Keep grouped channel isolation
        // inside the package rather than depending on a Core image/NN-shaped
        // primitive.
        tensor<real32> group_input = padded_input
        if group_count > 1
            if padded_input.is_tracked()
                // Core tensor slices are views but are not yet differentiable.
                // Preserve grouped training semantics by using the existing
                // autograd-aware gather path only while the input is tracked.
                int input_count = batches * weight_channels * padded_height * padded_width
                int[] input_indices = array(nat(input_count), fill = 0)
                for 0 <= int flat_index < input_count
                    int x = flat_index % padded_width
                    int remaining = flat_index / padded_width
                    int y = remaining % padded_height
                    remaining = remaining / padded_height
                    int local_channel = remaining % weight_channels
                    int batch = remaining / weight_channels
                    int input_channel = input_channel_start + local_channel
                    input_indices[flat_index] = (
                        ((batch * channels_in + input_channel) * padded_height + y)
                        * padded_width + x
                    )
                group_input = padded_input.gather(
                    input_indices,
                    [batches, weight_channels, padded_height, padded_width]
                )
            else
                group_input = padded_input[
                    :,
                    input_channel_start:<input_channel_start + weight_channels,
                    :,
                    :
                ]

        tensor<real32> patches = extract_patches(
            group_input,
            batches,
            weight_channels,
            padded_height,
            padded_width,
            kernel_height,
            kernel_width,
            output_height,
            output_width
        )

        tensor<real32> group_weight
        if group_count == 1
            group_weight = parameter_weight.reshape(
                [nat(outputs_per_group), nat(patch_width)]
            )
        else
            if parameter_weight.is_tracked()
                // As with the grouped input, retain the autograd-aware gather
                // path for tracked Parameters until Core slice views carry a
                // differentiable view graph.
                int weight_count = outputs_per_group * patch_width
                int weight_offset = output_channel_start * patch_width
                int[] weight_indices = array(nat(weight_count), fill = 0)
                for 0 <= int index < weight_count
                    weight_indices[index] = weight_offset + index
                group_weight = parameter_weight.gather(
                    weight_indices, [outputs_per_group, patch_width]
                )
            else
                // Output-channel groups are contiguous OIHW slices. Keep the
                // untracked view and reshape it directly instead of building a
                // second index array.
                tensor<real32> weight_view = parameter_weight[
                    output_channel_start:<output_channel_start + outputs_per_group,
                    :,
                    :,
                    :
                ]
                group_weight = weight_view.reshape(
                    [nat(outputs_per_group), nat(patch_width)]
                )

        tensor<real32> matrix = math.matmul(
            patches,
            group_weight.transpose(0, 1)
        )

        // For the common ungrouped case the matrix is already NHWC in logical
        // order. Reinterpret and transpose it into NCHW instead of building a
        // second index array and launching a scatter.
        if group_count == 1
            return matrix.reshape(
                [nat(batches), nat(output_height), nat(output_width), nat(channels_out)]
            ).transpose(1, 3).transpose(2, 3)

        int output_count = patch_rows * outputs_per_group
        int[] output_indices = array(nat(output_count), fill = 0)
        for 0 <= int flat_index < output_count
            int local_output_channel = flat_index % outputs_per_group
            int patch_index = flat_index / outputs_per_group
            int output_x = patch_index % output_width
            int patch_remaining = patch_index / output_width
            int output_y = patch_remaining % output_height
            int batch = patch_remaining / output_height
            int output_channel = output_channel_start + local_output_channel
            output_indices[flat_index] = (
                ((batch * channels_out + output_channel) * output_height
                + output_y) * output_width + output_x
            )

        return matrix.scatter(
            output_indices,
            [batches, channels_out, output_height, output_width]
        )

    tensor<real32> .forward(tensor<real32> value)
        int[] input_shape = int(value.shape())
        int[] weight_shape = int(weight.raw().shape())
        int[] bias_shape = int(bias.raw().shape())
        if len(input_shape) != 4
            error("nn.Conv2D requires NCHW rank-4 input", code = "NN_SHAPE")
        if len(weight_shape) != 4 or len(bias_shape) != 1
            error("nn.Conv2D requires OIHW rank-4 weight and rank-1 bias", code = "NN_SHAPE")

        int batches = input_shape[0]
        int channels_in = input_shape[1]
        int height = input_shape[2]
        int width = input_shape[3]
        int channels_out = weight_shape[0]
        int weight_channels = weight_shape[1]
        int kernel_height = weight_shape[2]
        int kernel_width = weight_shape[3]
        if batches <= 0 or channels_in <= 0 or channels_out <= 0
            error("nn.Conv2D requires positive batch and channel dimensions", code = "NN_SHAPE")
        if height <= 0 or width <= 0
            error("nn.Conv2D requires positive spatial dimensions", code = "NN_SHAPE")
        if group_count <= 0
            error("nn.Conv2D groups must be positive", code = "NN_ARGUMENT")
        if channels_in % group_count != 0 or channels_out % group_count != 0
            error("nn.Conv2D input and output channels must be divisible by groups", code = "NN_SHAPE")
        if weight_channels != channels_in / group_count
            error("nn.Conv2D input and grouped weight channel dimensions do not match", code = "NN_SHAPE")
        if kernel_height <= 0 or kernel_width <= 0 or kernel_height != kernel_width
            error("nn.Conv2D requires a positive square kernel", code = "NN_SHAPE")
        if bias_shape[0] != channels_out
            error("nn.Conv2D bias dimension does not match output channels", code = "NN_SHAPE")
        if step <= 0 or border < 0
            error("nn.Conv2D requires stride > 0 and padding >= 0", code = "NN_ARGUMENT")

        int padded_height = height + border * 2
        int padded_width = width + border * 2
        if padded_height < kernel_height or padded_width < kernel_width
            error("nn.Conv2D kernel is larger than padded input", code = "NN_SHAPE")
        int output_height = (padded_height - kernel_height) / step + 1
        int output_width = (padded_width - kernel_width) / step + 1

        tensor<real32> parameter_weight
        tensor<real32> parameter_bias
        if value.is_tracked()
            parameter_weight = .weight.track()
            parameter_bias = .bias.track()
        else
            parameter_weight = weight.raw()
            parameter_bias = bias.raw()

        // NVIDIA forward and first-order training are package-owned. Core
        // exposes only backend-neutral borrowed device handles plus the generic
        // custom-autograd attachment point; cuDNN forward/backward, descriptors,
        // algorithm choice, groups, padding, and bias stay entirely in NN.
        int32 cuda_device = native.cuda_device_f32(value)
        if cuda_device >= int32(0)
            int device_index = int(cuda_device)
            tensor<real32> cuda_input = value
            tensor<real32> cuda_weight = parameter_weight
            tensor<real32> cuda_bias = parameter_bias
            // Tracked tensors cannot be silently materialized because that
            // would cut their graph. A non-contiguous tracked input therefore
            // falls through to the portable graph; untracked inference may
            // explicitly materialize dense package inputs.
            if not value.is_tracked()
                if not cuda_input.is_contiguous()
                    cuda_input = cuda_input.contiguous()
                if not cuda_weight.is_contiguous()
                    cuda_weight = cuda_weight.contiguous()
                if not cuda_bias.is_contiguous()
                    cuda_bias = cuda_bias.contiguous()
            tensor<real32> cuda_output = tensor.zeros<real32>(
                [nat(batches), nat(channels_out), nat(output_height), nat(output_width)],
                gpu = nat(device_index)
            )
            int32 cuda_status = native.conv2d_cuda_f32(
                cuda_input,
                cuda_weight,
                cuda_bias,
                &cuda_output,
                int64(step),
                int64(border),
                int64(group_count)
            )
            if cuda_status == int32(0)
                return cuda_output

        // CPU and Metal share one package-native dispatcher: NN's direct
        // convolution plus one custom autograd node (first- and higher-order
        // callbacks), with the result on the input's device. Never materialize
        // a tracked non-contiguous tensor because that would cut its graph; the
        // native bridge rejects it and we fall through to the portable graph.
        // Untracked inference may explicitly densify inputs.
        int32 native_device = native.fused_device_f32(value)
        if native_device >= int32(-1)
            tensor<real32> native_input = value
            tensor<real32> native_weight = parameter_weight
            tensor<real32> native_bias = parameter_bias
            if not value.is_tracked()
                if not native_input.is_contiguous()
                    native_input = native_input.contiguous()
                if not native_weight.is_contiguous()
                    native_weight = native_weight.contiguous()
                if not native_bias.is_contiguous()
                    native_bias = native_bias.contiguous()
            // The Metal kernel stores every output element, so the device
            // output is allocated without a fill (a write-only output). Core
            // lends CPU kernels only initialized storage, so the CPU output
            // stays zeroed.
            tensor<real32> native_output
            if native_device == int32(-1)
                native_output = tensor.zeros<real32>(
                    [nat(batches), nat(channels_out), nat(output_height), nat(output_width)]
                )
            else
                native_output = tensor<real32>(
                    [nat(batches), nat(channels_out), nat(output_height), nat(output_width)],
                    gpu = nat(native_device)
                )
            int32 native_status = native.conv2d_f32(
                native_input,
                native_weight,
                native_bias,
                &native_output,
                int64(step),
                int64(border),
                int64(group_count)
            )
            if native_status == int32(0)
                return native_output

        // Padding is common to every output channel. Build it once instead of
        // rebuilding the same mapping for every output channel.
        tensor<real32> padded_input = value
        if border > 0
            int input_count = batches * channels_in * height * width
            int[] padded_indices = array(nat(input_count), fill = 0)
            for 0 <= int flat_index < input_count
                int x = flat_index % width
                int remaining = flat_index / width
                int y = remaining % height
                remaining = remaining / height
                int channel = remaining % channels_in
                int batch = remaining / channels_in
                padded_indices[flat_index] = (
                    ((batch * channels_in + channel) * padded_height
                    + y + border) * padded_width + x + border
                )
            padded_input = value.scatter(
                padded_indices,
                [batches, channels_in, padded_height, padded_width]
            )

        tensor<real32> output = convolve_group(
            padded_input,
            parameter_weight,
            0,
            batches,
            channels_in,
            channels_out,
            weight_channels,
            padded_height,
            padded_width,
            kernel_height,
            kernel_width,
            output_height,
            output_width
        )
        for 1 <= int group_index < group_count
            output = output + convolve_group(
                padded_input,
                parameter_weight,
                group_index,
                batches,
                channels_in,
                channels_out,
                weight_channels,
                padded_height,
                padded_width,
                kernel_height,
                kernel_width,
                output_height,
                output_width
            )

        // NCHW bias is a [1,C,1,1] singleton view. Core broadcasting
        // expands it without constructing or transferring an index tensor.
        tensor<real32> broadcast_bias = parameter_bias.reshape(
            [1, nat(channels_out), 1, 1]
        )
        return output + broadcast_bias

    // Metal Conv2D followed by NN's fused activation in one native call,
    // for tracked and untracked values. It produces the same tensors and
    // autograd nodes as forward() then the activation; false leaves every
    // other case (and any invalid shape) to that sequence.
    private bool .metal_activation(
        tensor<real32> value,
        int activation,
        tensor<real32> &result
    )
        if native.metal_device_f32(value) < int32(0)
            return false
        int[] input_shape = int(value.shape())
        int[] weight_shape = int(weight.raw().shape())
        if len(input_shape) != 4 or len(weight_shape) != 4
            return false
        if step <= 0 or border < 0
            return false
        int padded_height = input_shape[2] + border * 2
        int padded_width = input_shape[3] + border * 2
        if padded_height < weight_shape[2] or padded_width < weight_shape[3]
            return false
        int[] output_shape = [
            input_shape[0],
            weight_shape[0],
            (padded_height - weight_shape[2]) / step + 1,
            (padded_width - weight_shape[3]) / step + 1
        ]
        tensor<real32> metal_input = value
        tensor<real32> metal_weight
        tensor<real32> metal_bias
        if value.is_tracked()
            metal_weight = .weight.track()
            metal_bias = .bias.track()
        else
            metal_weight = weight.raw()
            metal_bias = bias.raw()
            if not metal_input.is_contiguous()
                metal_input = metal_input.contiguous()
            if not metal_weight.is_contiguous()
                metal_weight = metal_weight.contiguous()
            if not metal_bias.is_contiguous()
                metal_bias = metal_bias.contiguous()
        // Both outputs are write-only: the kernels store every element.
        int device_index = int(native.metal_device_f32(value))
        tensor<real32> convolved = tensor<real32>(nat(output_shape), gpu = nat(device_index))
        tensor<real32> activated = tensor<real32>(nat(output_shape), gpu = nat(device_index))
        int32 status = native.conv2d_activation_f32(
            metal_input,
            metal_weight,
            metal_bias,
            &convolved,
            &activated,
            int64(step),
            int64(border),
            int64(group_count),
            int64(activation)
        )
        if status != int32(0)
            return false
        result = activated
        return true

    // Package-owned compiler fusion target. Untracked CPU inference uses a
    // single native Conv+bias+ReLU loop, eliminating the intermediate tensor
    // and second elementwise pass. Metal runs the convolution and the fused
    // ReLU in one native call; other tracked and GPU execution runs forward()
    // and then NN's fused ReLU. Both keep package-owned custom autograd that
    // reproduces the compositional first- and higher-order semantics.
    private tensor<real32> .forward_relu(tensor<real32> value)
        if not value.is_tracked()
            tensor<real32> parameter_weight = weight.raw()
            tensor<real32> parameter_bias = bias.raw()
            int[] input_shape = int(value.shape())
            int[] weight_shape = int(parameter_weight.shape())
            int[] bias_shape = int(parameter_bias.shape())
            if len(input_shape) != 4
                error("nn.Conv2D requires NCHW rank-4 input", code = "NN_SHAPE")
            if len(weight_shape) != 4 or len(bias_shape) != 1
                error("nn.Conv2D requires OIHW rank-4 weight and rank-1 bias", code = "NN_SHAPE")

            int batches = input_shape[0]
            int channels_in = input_shape[1]
            int height = input_shape[2]
            int width = input_shape[3]
            int channels_out = weight_shape[0]
            int weight_channels = weight_shape[1]
            int kernel_height = weight_shape[2]
            int kernel_width = weight_shape[3]
            if batches <= 0 or channels_in <= 0 or channels_out <= 0
                error("nn.Conv2D requires positive batch and channel dimensions", code = "NN_SHAPE")
            if height <= 0 or width <= 0
                error("nn.Conv2D requires positive spatial dimensions", code = "NN_SHAPE")
            if group_count <= 0
                error("nn.Conv2D groups must be positive", code = "NN_ARGUMENT")
            if channels_in % group_count != 0 or channels_out % group_count != 0
                error("nn.Conv2D input and output channels must be divisible by groups", code = "NN_SHAPE")
            if weight_channels != channels_in / group_count
                error("nn.Conv2D input and grouped weight channel dimensions do not match", code = "NN_SHAPE")
            if kernel_height <= 0 or kernel_width <= 0 or kernel_height != kernel_width
                error("nn.Conv2D requires a positive square kernel", code = "NN_SHAPE")
            if bias_shape[0] != channels_out
                error("nn.Conv2D bias dimension does not match output channels", code = "NN_SHAPE")
            if step <= 0 or border < 0
                error("nn.Conv2D requires stride > 0 and padding >= 0", code = "NN_ARGUMENT")

            int padded_height = height + border * 2
            int padded_width = width + border * 2
            if padded_height < kernel_height or padded_width < kernel_width
                error("nn.Conv2D kernel is larger than padded input", code = "NN_SHAPE")
            int output_height = (padded_height - kernel_height) / step + 1
            int output_width = (padded_width - kernel_width) / step + 1

            // cuDNN's built-in ReLU is max-like and is not exactly the
            // package expression (x + abs(x)) / 2 for all IEEE values.
            // GPU inference therefore falls through to forward(value) below,
            // then applies NN's exact activation semantics through Math.

            if native.is_cpu_f32(value) == int32(1) and native.is_cpu_f32(parameter_weight) == int32(1) and native.is_cpu_f32(parameter_bias) == int32(1)
                tensor<real32> native_input = value
                tensor<real32> native_weight = parameter_weight
                tensor<real32> native_bias = parameter_bias
                if not native_input.is_contiguous()
                    native_input = native_input.contiguous()
                if not native_weight.is_contiguous()
                    native_weight = native_weight.contiguous()
                if not native_bias.is_contiguous()
                    native_bias = native_bias.contiguous()
                tensor<real32> native_output = tensor.zeros<real32>(
                    [nat(batches), nat(channels_out), nat(output_height), nat(output_width)]
                )
                int32 native_status = native.conv2d_relu_inference_f32(
                    native_input,
                    native_weight,
                    native_bias,
                    &native_output,
                    int64(step),
                    int64(border),
                    int64(group_count)
                )
                if native_status == int32(0)
                    return native_output

        tensor<real32> fused = value
        if .metal_activation(value, 1, &fused)
            return fused

        // Keep the input borrowed, as forward() does, and own its result.
        tensor<real32> output = .forward(value)
        return internal.relu_fused(output)

    // Package-owned Conv+bias+GELU fusion target. CPU inference applies GELU
    // while each convolution result is still in the native output loop; Metal
    // runs the convolution and the fused GELU in one native call.
    private tensor<real32> .forward_gelu(tensor<real32> value)
        if not value.is_tracked()
            tensor<real32> parameter_weight = weight.raw()
            tensor<real32> parameter_bias = bias.raw()
            int[] input_shape = int(value.shape())
            int[] weight_shape = int(parameter_weight.shape())
            int[] bias_shape = int(parameter_bias.shape())
            if len(input_shape) != 4
                error("nn.Conv2D requires NCHW rank-4 input", code = "NN_SHAPE")
            if len(weight_shape) != 4 or len(bias_shape) != 1
                error("nn.Conv2D requires OIHW rank-4 weight and rank-1 bias", code = "NN_SHAPE")

            int batches = input_shape[0]
            int channels_in = input_shape[1]
            int height = input_shape[2]
            int width = input_shape[3]
            int channels_out = weight_shape[0]
            int weight_channels = weight_shape[1]
            int kernel_height = weight_shape[2]
            int kernel_width = weight_shape[3]
            if batches <= 0 or channels_in <= 0 or channels_out <= 0
                error("nn.Conv2D requires positive batch and channel dimensions", code = "NN_SHAPE")
            if height <= 0 or width <= 0
                error("nn.Conv2D requires positive spatial dimensions", code = "NN_SHAPE")
            if group_count <= 0
                error("nn.Conv2D groups must be positive", code = "NN_ARGUMENT")
            if channels_in % group_count != 0 or channels_out % group_count != 0
                error("nn.Conv2D input and output channels must be divisible by groups", code = "NN_SHAPE")
            if weight_channels != channels_in / group_count
                error("nn.Conv2D input and grouped weight channel dimensions do not match", code = "NN_SHAPE")
            if kernel_height <= 0 or kernel_width <= 0 or kernel_height != kernel_width
                error("nn.Conv2D requires a positive square kernel", code = "NN_SHAPE")
            if bias_shape[0] != channels_out
                error("nn.Conv2D bias dimension does not match output channels", code = "NN_SHAPE")
            if step <= 0 or border < 0
                error("nn.Conv2D requires stride > 0 and padding >= 0", code = "NN_ARGUMENT")

            int padded_height = height + border * 2
            int padded_width = width + border * 2
            if padded_height < kernel_height or padded_width < kernel_width
                error("nn.Conv2D kernel is larger than padded input", code = "NN_SHAPE")
            int output_height = (padded_height - kernel_height) / step + 1
            int output_width = (padded_width - kernel_width) / step + 1

            if native.is_cpu_f32(value) == int32(1) and native.is_cpu_f32(parameter_weight) == int32(1) and native.is_cpu_f32(parameter_bias) == int32(1)
                tensor<real32> native_input = value
                tensor<real32> native_weight = parameter_weight
                tensor<real32> native_bias = parameter_bias
                if not native_input.is_contiguous()
                    native_input = native_input.contiguous()
                if not native_weight.is_contiguous()
                    native_weight = native_weight.contiguous()
                if not native_bias.is_contiguous()
                    native_bias = native_bias.contiguous()
                tensor<real32> native_output = tensor.zeros<real32>(
                    [nat(batches), nat(channels_out), nat(output_height), nat(output_width)]
                )
                int32 native_status = native.conv2d_gelu_inference_f32(
                    native_input,
                    native_weight,
                    native_bias,
                    &native_output,
                    int64(step),
                    int64(border),
                    int64(group_count)
                )
                if native_status == int32(0)
                    return native_output

        tensor<real32> fused = value
        if .metal_activation(value, 2, &fused)
            return fused

        tensor<real32> output = .forward(value)
        return internal.gelu_fused(output)


    // Compiler-private specialization/backend targets. Static untracked calls
    // may be redirected here; every target retains the portable fallback in
    // forward()/forward_relu()/forward_gelu(), so backend availability never
    // changes NN semantics.
    private tensor<real32> .forward_inference(tensor<real32> value)
        return .forward(value)

    private tensor<real32> .forward_cpu_inference(tensor<real32> value)
        return .forward(value)

    private tensor<real32> .forward_cuda_inference(tensor<real32> value)
        return .forward(value)

    private tensor<real32> .forward_cuda_fast_inference(tensor<real32> value)
        return .forward(value)

    private tensor<real32> .forward_cuda_deterministic_inference(tensor<real32> value)
        return .forward(value)

    private tensor<real32> .forward_relu_inference(tensor<real32> value)
        return .forward_relu(value)

    private tensor<real32> .forward_relu_cpu_inference(tensor<real32> value)
        return .forward_relu(value)

    private tensor<real32> .forward_relu_cuda(tensor<real32> value)
        tensor<real32> output = .forward(value)
        if not output.is_tracked() and output.is_contiguous() and native.cuda_device_f32(output) >= int32(0)
            int32 status = native.cuda_activation_inplace_f32(&output, 1)
            if status == int32(0)
                return output
        return internal.relu_fused(output)

    private tensor<real32> .forward_gelu_inference(tensor<real32> value)
        return .forward_gelu(value)

    private tensor<real32> .forward_gelu_cpu_inference(tensor<real32> value)
        return .forward_gelu(value)

    private tensor<real32> .forward_gelu_cuda(tensor<real32> value)
        tensor<real32> output = .forward(value)
        if not output.is_tracked() and output.is_contiguous() and native.cuda_device_f32(output) >= int32(0)
            int32 status = native.cuda_activation_inplace_f32(&output, 2)
            if status == int32(0)
                return output
        return internal.gelu_fused(output)

FC | error normal_fc(
    int features_in,
    int features_out,
    real64 standard_deviation,
    real64 bias_value = 0.0,
    int seed = 1
)
    if features_in <= 0 or features_out <= 0
        return error("nn.normal_fc requires positive input and output feature counts", code = "NN_SHAPE")
    if features_out > 9223372036854775807 / features_in
        return error("nn.normal_fc dimensions are too large", code = "NN_SHAPE")
    if not math.is_finite(bias_value)
        return error("nn.normal_fc bias must be finite", code = "NN_ARGUMENT")

    int weight_count = features_out * features_in
    tensor<real32> weight_values = try normal_weights(
        weight_count, standard_deviation, seed
    )

    real32 bias32 = try real32(bias_value)
    Parameter<real32> prepared_weight = Parameter<real32>(
        value = weight_values.reshape([nat(features_out), nat(features_in)])
    )
    Parameter<real32> prepared_bias = Parameter<real32>(
        value = tensor.ones<real32>([nat(features_out)]) * bias32
    )
    FC layer = try FC(
        features_in, features_out, seed = seed,
        initial_weight = prepared_weight, initial_bias = prepared_bias
    )
    return layer

Conv2D | error normal_conv2d(
    int channels_in,
    int channels_out,
    int kernel,
    real64 standard_deviation,
    real64 bias_value = 0.0,
    int stride = 1,
    int padding = 0,
    int seed = 1,
    int groups = 1
)
    if channels_in <= 0 or channels_out <= 0
        return error("nn.normal_conv2d requires positive input and output channel counts", code = "NN_SHAPE")
    if kernel <= 0
        return error("nn.normal_conv2d kernel must be positive", code = "NN_ARGUMENT")
    if stride <= 0
        return error("nn.normal_conv2d stride must be positive", code = "NN_ARGUMENT")
    if padding < 0
        return error("nn.normal_conv2d padding must be nonnegative", code = "NN_ARGUMENT")
    if groups <= 0
        return error("nn.normal_conv2d groups must be positive", code = "NN_ARGUMENT")
    if channels_in % groups != 0 or channels_out % groups != 0
        return error("nn.normal_conv2d input and output channels must be divisible by groups", code = "NN_SHAPE")
    if not math.is_finite(bias_value)
        return error("nn.normal_conv2d bias must be finite", code = "NN_ARGUMENT")
    if kernel > 9223372036854775807 / kernel
        return error("nn.normal_conv2d dimensions are too large", code = "NN_SHAPE")

    int kernel_area = kernel * kernel
    int channels_per_group = channels_in / groups
    if channels_per_group > 9223372036854775807 / kernel_area
        return error("nn.normal_conv2d dimensions are too large", code = "NN_SHAPE")
    int fan_in = channels_per_group * kernel_area
    if channels_out > 9223372036854775807 / fan_in
        return error("nn.normal_conv2d dimensions are too large", code = "NN_SHAPE")
    int weight_count = channels_out * fan_in

    tensor<real32> weight_values = try normal_weights(
        weight_count, standard_deviation, seed
    )
    real32 bias32 = try real32(bias_value)
    Parameter<real32> prepared_weight = Parameter<real32>(
        value = weight_values.reshape(
            [nat(channels_out), nat(channels_per_group), nat(kernel), nat(kernel)]
        )
    )
    Parameter<real32> prepared_bias = Parameter<real32>(
        value = tensor.ones<real32>([nat(channels_out)]) * bias32
    )
    Conv2D layer = try Conv2D(
        channels_in, channels_out, kernel, stride = stride, padding = padding, seed = seed, groups = groups,
        initial_weight = prepared_weight, initial_bias = prepared_bias
    )
    return layer


tensor<real32> max_pool2d(
    tensor<real32> value,
    int kernel,
    int stride,
    int padding = 0
)
    int[] shape = int(value.shape())
    if len(shape) != 4
        error("nn.max_pool2d requires NCHW rank-4 input", code = "NN_SHAPE")
    if kernel <= 0 or stride <= 0 or padding < 0
        error("nn.max_pool2d requires kernel/stride > 0 and padding >= 0", code = "NN_ARGUMENT")
    int batches = shape[0]
    int channels = shape[1]
    int height = shape[2]
    int width = shape[3]
    if batches <= 0 or channels <= 0 or height <= 0 or width <= 0
        error("nn.max_pool2d requires positive input dimensions", code = "NN_SHAPE")
    int padded_height = height + padding * 2
    int padded_width = width + padding * 2
    if padded_height < kernel or padded_width < kernel
        error("nn.max_pool2d kernel is larger than padded input", code = "NN_SHAPE")
    int output_height = (padded_height - kernel) / stride + 1
    int output_width = (padded_width - kernel) / stride + 1
    int[] output_shape = [batches, channels, output_height, output_width]
    tensor<real32> output = (
        value.untrack().gather([0], [1]) * real32(0)
    ).scatter([0], output_shape)

    for 0 <= int channel < channels
        for 0 <= int output_y < output_height
            for 0 <= int output_x < output_width
                int start_y = output_y * stride - padding
                int start_x = output_x * stride - padding
                int valid_count = 0
                for 0 <= int kernel_y < kernel
                    int source_y = start_y + kernel_y
                    if source_y >= 0 and source_y < height
                        for 0 <= int kernel_x < kernel
                            int source_x = start_x + kernel_x
                            if source_x >= 0 and source_x < width
                                valid_count = valid_count + 1
                if valid_count <= 0
                    error("nn.max_pool2d produced an empty pooling window", code = "NN_SHAPE")

                int[] input_indices = array(
                    nat(batches * valid_count), fill = 0
                )
                int cursor = 0
                for 0 <= int batch < batches
                    for 0 <= int kernel_y < kernel
                        int source_y = start_y + kernel_y
                        if source_y >= 0 and source_y < height
                            for 0 <= int kernel_x < kernel
                                int source_x = start_x + kernel_x
                                if source_x >= 0 and source_x < width
                                    input_indices[cursor] = (
                                        ((batch * channels + channel) * height + source_y)
                                        * width + source_x
                                    )
                                    cursor = cursor + 1

                tensor<real32> window = value.gather(
                    input_indices, [batches, valid_count]
                )
                // max_last preserves shape by broadcasting each row maximum;
                // gather one representative value per batch for the pool output.
                tensor<real32> maxima = math.max_last(window)
                int[] maximum_indices = array(nat(batches), fill = 0)
                for 0 <= int batch < batches
                    maximum_indices[batch] = batch * valid_count
                tensor<real32> pooled = maxima.gather(
                    maximum_indices, [batches]
                )
                int[] output_indices = array(nat(batches), fill = 0)
                for 0 <= int batch < batches
                    output_indices[batch] = (
                        ((batch * channels + channel) * output_height + output_y)
                        * output_width + output_x
                    )
                output = output + pooled.scatter(output_indices, output_shape)
    return output

tensor<real32> global_average_pool2d(tensor<real32> value)
    int[] shape = int(value.shape())
    if len(shape) != 4
        error("nn.global_average_pool2d requires NCHW rank-4 input", code = "NN_SHAPE")
    int batches = shape[0]
    int channels = shape[1]
    int height = shape[2]
    int width = shape[3]
    if batches <= 0 or channels <= 0 or height <= 0 or width <= 0
        error("nn.global_average_pool2d requires positive input dimensions", code = "NN_SHAPE")
    if height > 9223372036854775807 / width
        error("nn.global_average_pool2d input is too large", code = "NN_SIZE")
    int count = height * width
    if channels > 9223372036854775807 / count
        error("nn.global_average_pool2d input is too large", code = "NN_SIZE")
    int batch_count = channels * count
    if batches > 9223372036854775807 / batch_count
        error("nn.global_average_pool2d input is too large", code = "NN_SIZE")
    int total_count = batches * batch_count

    // NN's pooling kernel on CPU and Metal: one pass per plane and one custom
    // autograd node (any order) instead of the gather/sum_last graph below.
    // Only untracked views are densified; tracked views keep the graph.
    int32 device = native.fused_device_f32(value)
    if device >= int32(-1)
        tensor<real32> input = value
        bool dense = input.is_contiguous()
        if not dense and not input.is_tracked()
            input = input.contiguous()
            dense = true
        if dense
            // The device output is write-only (the kernel stores every row);
            // the CPU output stays zeroed.
            tensor<real32> pooled
            if device == int32(-1)
                pooled = tensor.zeros<real32>([nat(batches), nat(channels)])
            else
                pooled = tensor<real32>([nat(batches), nat(channels)], gpu = nat(device))
            if native.global_average_pool2d_f32(input, &pooled) == int32(0)
                return pooled

    // gather() works on logical tensor indices and preserves autograd, so it
    // makes a contiguous reduction view without cutting a tracked graph.
    int[] flatten_indices = array(nat(total_count), fill = 0)
    for 0 <= int index < total_count
        flatten_indices[index] = index
    tensor<real32> flattened = value.gather(
        flatten_indices, [batches, channels, count]
    )

    // sum_last preserves the reduced axis by broadcasting the sum. Select
    // one representative from each spatial plane after dividing by its size.
    tensor<real32> spatial_sums = math.sum_last(flattened)
    real32 spatial_count = real32(count)
    tensor<real32> means = spatial_sums / spatial_count
    int output_count = batches * channels
    int[] indices = array(nat(output_count), fill = 0)
    for 0 <= int index < output_count
        indices[index] = index * count
    return means.gather(indices, [batches, channels])

tensor<real32> local_response_normalization(
    tensor<real32> value,
    int size = 5,
    real64 alpha = 0.0001,
    real64 beta = 0.75,
    real64 k = 2.0
)
    int[] shape = int(value.shape())
    if len(shape) != 4
        error("nn.local_response_normalization requires NCHW rank-4 input", code = "NN_SHAPE")
    if size <= 0 or size % 2 == 0
        error("nn.local_response_normalization size must be positive and odd", code = "NN_ARGUMENT")
    if not math.is_finite(alpha) or alpha < 0.0
        error("nn.local_response_normalization alpha must be finite and nonnegative", code = "NN_ARGUMENT")
    if not math.is_finite(beta) or beta <= 0.0
        error("nn.local_response_normalization beta must be finite and positive", code = "NN_ARGUMENT")
    if not math.is_finite(k) or k <= 0.0
        error("nn.local_response_normalization k must be finite and positive", code = "NN_ARGUMENT")

    int batches = shape[0]
    int channels = shape[1]
    int height = shape[2]
    int width = shape[3]
    if batches <= 0 or channels <= 0 or height <= 0 or width <= 0
        error("nn.local_response_normalization requires positive input dimensions", code = "NN_SHAPE")

    tensor<real32> output = (
        value.untrack().gather([0], [1]) * real32(0)
    ).scatter([0], shape)
    int plane_count = batches * height * width
    int radius = size / 2

    for 0 <= int channel < channels
        int first_channel = channel - radius
        if first_channel < 0
            first_channel = 0
        int last_channel = channel + radius
        if last_channel >= channels
            last_channel = channels - 1

        int[] current_indices = array(nat(plane_count), fill = 0)
        for 0 <= int flat_index < plane_count
            int x = flat_index % width
            int remaining = flat_index / width
            int y = remaining % height
            int batch = remaining / height
            current_indices[flat_index] = (
                ((batch * channels + channel) * height + y) * width + x
            )
        tensor<real32> current = value.gather(
            current_indices, [batches, height, width]
        )
        tensor<real32> square_sum = current.untrack() * real32(0)

        for first_channel <= int neighbor < last_channel + 1
            int[] neighbor_indices = array(nat(plane_count), fill = 0)
            for 0 <= int flat_index < plane_count
                int x = flat_index % width
                int remaining = flat_index / width
                int y = remaining % height
                int batch = remaining / height
                neighbor_indices[flat_index] = (
                    ((batch * channels + neighbor) * height + y) * width + x
                )
            tensor<real32> neighbor_value = value.gather(
                neighbor_indices, [batches, height, width]
            )
            square_sum = square_sum + neighbor_value * neighbor_value

        real32 base_k = real32(k)
        real32 coefficient = real32(alpha)
        real32 exponent = real32(beta)
        tensor<real32> base = base_k + square_sum * coefficient
        tensor<real32> denominator = math.exp(
            math.log(base) * exponent
        )
        tensor<real32> normalized = current / denominator
        output = output + normalized.scatter(current_indices, shape)

    return output

class BatchNorm(
    local int features,
    local real64 momentum = 0.1,
    local real64 epsilon = 0.00001,
    local Parameter<real32> | none initial_scale = none,
    local Parameter<real32> | none initial_bias = none,
    local State<real32> | none initial_mean = none,
    local State<real32> | none initial_variance = none,
    local real32 | none initial_momentum = none,
    local real32 | none initial_epsilon = none
) | error

    Parameter<real32> scale
    Parameter<real32> bias
    State<real32> running_mean
    State<real32> running_variance
    real32 running_momentum
    real32 variance_epsilon
    if features <= 0
        return error("nn.BatchNorm features must be positive", code = "NN_ARGUMENT")
    if not math.is_finite(momentum) or momentum < 0.0 or momentum >= 1.0
        return error("nn.BatchNorm momentum must be finite and in [0, 1)", code = "NN_ARGUMENT")
    if not math.is_finite(epsilon) or epsilon <= 0.0
        return error("nn.BatchNorm epsilon must be finite and positive", code = "NN_ARGUMENT")
    match initial_scale
        Parameter<real32> provided_scale
            match initial_bias
                Parameter<real32> provided_bias
                    match initial_mean
                        State<real32> provided_mean
                            match initial_variance
                                State<real32> provided_variance
                                    match initial_momentum
                                        real32 provided_momentum
                                            match initial_epsilon
                                                real32 provided_epsilon
                                                    if not math.is_finite(provided_momentum) or provided_momentum < real32(0.0) or provided_momentum >= real32(1.0)
                                                        return error("nn.BatchNorm initial momentum must be finite and in [0, 1)", code = "NN_ARGUMENT")
                                                    if not math.is_finite(provided_epsilon) or provided_epsilon <= real32(0.0)
                                                        return error("nn.BatchNorm initial epsilon must be finite and positive", code = "NN_ARGUMENT")
                                                    scale = provided_scale
                                                    bias = provided_bias
                                                    running_mean = provided_mean
                                                    running_variance = provided_variance
                                                    running_momentum = provided_momentum
                                                    variance_epsilon = provided_epsilon
                                                none
                                                    return error("nn.BatchNorm initial values must be supplied together", code = "NN_ARGUMENT")
                                        none
                                            return error("nn.BatchNorm initial values must be supplied together", code = "NN_ARGUMENT")
                                none
                                    return error("nn.BatchNorm initial values must be supplied together", code = "NN_ARGUMENT")
                        none
                            return error("nn.BatchNorm initial values must be supplied together", code = "NN_ARGUMENT")
                none
                    return error("nn.BatchNorm initial values must be supplied together", code = "NN_ARGUMENT")
        none
            match initial_bias
                Parameter<real32> provided_bias
                    return error("nn.BatchNorm initial values must be supplied together", code = "NN_ARGUMENT")
                none
                    match initial_mean
                        State<real32> provided_mean
                            return error("nn.BatchNorm initial values must be supplied together", code = "NN_ARGUMENT")
                        none
                            match initial_variance
                                State<real32> provided_variance
                                    return error("nn.BatchNorm initial values must be supplied together", code = "NN_ARGUMENT")
                                none
                                    match initial_momentum
                                        real32 provided_momentum
                                            return error("nn.BatchNorm initial values must be supplied together", code = "NN_ARGUMENT")
                                        none
                                            match initial_epsilon
                                                real32 provided_epsilon
                                                    return error("nn.BatchNorm initial values must be supplied together", code = "NN_ARGUMENT")
                                                none
                                                    scale = Parameter<real32>(
                                                        value = tensor.ones<real32>([nat(features)])
                                                    )
                                                    bias = Parameter<real32>(
                                                        value = tensor.zeros<real32>([nat(features)])
                                                    )
                                                    running_mean = State<real32>(value = tensor.zeros<real32>([nat(features)]))
                                                    running_variance = State<real32>(value = tensor.ones<real32>([nat(features)]))
                                                    running_momentum = try real32(momentum)
                                                    variance_epsilon = try real32(epsilon)

    private (tensor<real32>, tensor<real32>, tensor<real32>) .normalize_value(
        tensor<real32> value,
        bool training
    )
        int[] shape = int(value.shape())
        int rank = int(len(shape))
        if rank < 2
            error("nn.BatchNorm requires rank >= 2 with feature/channel axis 1", code = "NN_SHAPE")

        int features = shape[1]
        if features <= 0
            error("nn.BatchNorm feature/channel dimension must be positive", code = "NN_SHAPE")
        int[] scale_shape = int(scale.raw().shape())
        int[] bias_shape = int(bias.raw().shape())
        int[] mean_shape = int(running_mean.raw().shape())
        int[] variance_shape = int(running_variance.raw().shape())
        if len(scale_shape) != 1 or len(bias_shape) != 1
            error("nn.BatchNorm requires rank-1 scale and bias", code = "NN_SHAPE")
        if len(mean_shape) != 1 or len(variance_shape) != 1
            error("nn.BatchNorm requires rank-1 running state", code = "NN_SHAPE")
        if scale_shape[0] != features or bias_shape[0] != features
            error("nn.BatchNorm parameter dimensions do not match input features", code = "NN_SHAPE")
        if mean_shape[0] != features or variance_shape[0] != features
            error("nn.BatchNorm running state dimensions do not match input features", code = "NN_SHAPE")

        int inner = 1
        for 2 <= int axis < rank
            if shape[axis] < 0
                error("nn.BatchNorm received an invalid tensor shape", code = "NN_INTERNAL")
            if shape[axis] != 0 and inner > 9223372036854775807 / shape[axis]
                error("nn.BatchNorm tensor shape is too large", code = "NN_SIZE")
            inner = inner * shape[axis]
        if shape[0] < 0
            error("nn.BatchNorm received an invalid tensor shape", code = "NN_INTERNAL")
        if inner != 0 and shape[0] > 9223372036854775807 / inner
            error("nn.BatchNorm tensor shape is too large", code = "NN_SIZE")
        int samples = shape[0] * inner
        if training and samples == 0
            error("nn.BatchNorm training requires at least one sample per feature", code = "NN_SHAPE")

        tensor<real32> parameter_scale
        tensor<real32> parameter_bias
        if value.is_tracked()
            parameter_scale = .scale.track()
            parameter_bias = .bias.track()
        else
            parameter_scale = scale.raw()
            parameter_bias = bias.raw()

        tensor<real32> output = value * real32(0)
        tensor<real32> next_running_mean = running_mean.raw() * real32(0)
        tensor<real32> next_running_variance = running_variance.raw() * real32(0)

        for 0 <= int feature < features
            int[] indices = array(nat(samples), fill = 0)
            for 0 <= int sample < samples
                int outer = sample / inner
                int offset = sample % inner
                indices[sample] = ((outer * features + feature) * inner) + offset

            tensor<real32> feature_values = value.gather(indices, [samples])
            tensor<real32> mean
            tensor<real32> variance

            if training
                mean = internal.mean_all(feature_values).reshape([1])
                tensor<real32> centered = feature_values - mean
                variance = internal.mean_all(centered * centered).reshape([1])

                tensor<real32> old_mean = running_mean.raw().gather(
                    [feature], [1]
                )
                tensor<real32> old_variance = running_variance.raw().gather(
                    [feature], [1]
                )
                tensor<real32> updated_mean = (
                    old_mean * (real32(1) - running_momentum)
                    + mean.untrack() * running_momentum
                )
                tensor<real32> updated_variance = (
                    old_variance * (real32(1) - running_momentum)
                    + variance.untrack() * running_momentum
                )

                tensor<real32> mean_piece = updated_mean.scatter(
                    [feature], [features]
                )
                tensor<real32> variance_piece = updated_variance.scatter(
                    [feature], [features]
                )
                next_running_mean = next_running_mean + mean_piece
                next_running_variance = next_running_variance + variance_piece
            else
                mean = running_mean.raw().gather([feature], [1])
                variance = running_variance.raw().gather([feature], [1])

            tensor<real32> shifted_variance = variance + variance_epsilon
            tensor<real32> denominator = math.exp(
                math.log(shifted_variance) * real32(0.5)
            )
            tensor<real32> feature_scale = parameter_scale.gather(
                [feature], [1]
            )
            tensor<real32> feature_bias = parameter_bias.gather(
                [feature], [1]
            )
            tensor<real32> normalized = (
                (feature_values - mean) / denominator
            ) * feature_scale + feature_bias
            tensor<real32> piece = normalized.scatter(indices, shape)
            output = output + piece

        return (output, next_running_mean, next_running_variance)

    tensor<real32> .forward(tensor<real32> value)
        (tensor<real32> output, tensor<real32> next_running_mean, tensor<real32> next_running_variance) = .normalize_value(value, true)
        .running_mean.replace(next_running_mean)
        .running_variance.replace(next_running_variance)
        return output

    tensor<real32> .infer(tensor<real32> value)
        (tensor<real32> output, _, _) = .normalize_value(value, false)
        return output

    // Compiler-private inference fusion targets. Core sees only the generic
    // side-input/replacement contract; NN owns Conv2D/BatchNorm semantics.
    // Keep the Conv2D side input as an ordinary value parameter. Its body-only
    // use is inferred as borrowed, matching the implicit method-receiver
    // contract of Conv2D.forward without introducing an explicit reference ABI.
    private tensor<real32> .infer_conv(
        Conv2D convolution,
        tensor<real32> value
    )
        tensor<real32> convolved = .convolution.forward(value)
        (tensor<real32> output, _, _) = .normalize_value(convolved, false)
        return output

    private tensor<real32> .infer_conv_relu(
        Conv2D convolution,
        tensor<real32> value
    )
        tensor<real32> convolved = .convolution.forward(value)
        (tensor<real32> output, _, _) = .normalize_value(convolved, false)
        return relu(output)

    private tensor<real32> .infer_conv_gelu(
        Conv2D convolution,
        tensor<real32> value
    )
        tensor<real32> convolved = .convolution.forward(value)
        (tensor<real32> output, _, _) = .normalize_value(convolved, false)
        return gelu(output)

class Dropout(local real64 rate, local int seed = 0, local bool inverted = true) | error

    real64 drop_rate
    random.Generator rng
    bool inverted_scaling
    if not math.is_finite(rate) or rate < 0.0 or rate >= 1.0
        return error("nn.Dropout rate must be finite and in [0, 1)", code = "NN_ARGUMENT")
    drop_rate = rate
    rng = random.generator(seed = seed)
    inverted_scaling = inverted

    tensor<real32> .forward(tensor<real32> value)
        if drop_rate == 0.0
            return value

        int[] shape = int(value.shape())
        int count = 1
        for 0 <= nat axis < len(shape)
            if shape[axis] < 0
                error("nn.Dropout received an invalid tensor shape", code = "NN_INTERNAL")
            if shape[axis] != 0 and count > 9223372036854775807 / shape[axis]
                error("nn.Dropout tensor is too large", code = "NN_SIZE")
            count = count * shape[axis]

        tensor<real32> mask = (value.untrack() * real32(0)).reshape([nat(count)])
        real64 scale = 1.0
        if inverted_scaling
            scale = 1.0 / (1.0 - drop_rate)
        for 0 <= int index < count
            if (.rng.real64()) < drop_rate
                mask[index] = real32(0)
            else
                mask[index] = real32(scale)

        return value * mask.reshape(nat(shape))

    tensor<real32> infer(tensor<real32> value)
        if inverted_scaling
            return value
        real32 keep = real32(1.0 - drop_rate)
        return value * keep

// ReLU is the expression (x + |x|) / 2 and GELU is
// x * 0.5 * (1 + nn.tanh(0.7978845608028654 * (x + 0.044715 * x^3))).
// internal.qui keeps both source expressions; on CPU and Metal they run as
// one fused package-native kernel with custom autograd.
tensor<real32> relu(tensor<real32> value)
    return internal.relu_fused(value)

tensor<real32> tanh(tensor<real32> value)
    tensor<real32> lifted = (value - 20.0 + math.abs(value + 20.0)) / 2.0
    tensor<real32> limited = (lifted + 20.0 - math.abs(lifted - 20.0)) / 2.0
    tensor<real32> exponent = math.exp(limited * 2.0)
    return (exponent - 1.0) / (exponent + 1.0)

tensor<real32> sigmoid(tensor<real32> value)
    return (tanh(value * 0.5) + 1.0) * 0.5

tensor<real32> softmax(tensor<real32> value)
    tensor<real32> shifted = value - math.max_last(value)
    tensor<real32> weights = math.exp(shifted)
    return weights / math.sum_last(weights)

tensor<real32> gelu(tensor<real32> value)
    return internal.gelu_fused(value)

tensor<real32> mse(tensor<real32> prediction, tensor<real32> target)
    tensor<real32> difference = prediction - target
    return internal.mean_all(difference * difference)

tensor<real32> binary_cross_entropy(
    tensor<real32> prediction,
    tensor<real32> target
)
    tensor<real32> lifted = (
        prediction + real32(0.000001)
        + math.abs(prediction - real32(0.000001))
    ) / 2.0
    tensor<real32> limited = (
        lifted + real32(0.999999)
        - math.abs(lifted - real32(0.999999))
    ) / 2.0
    tensor<real32> first = target * math.log(limited)
    tensor<real32> second = (1.0 - target) * math.log(1.0 - limited)
    return internal.mean_all(0.0 - first - second)

tensor<real32> binary_cross_entropy_with_logits(
    tensor<real32> logits,
    tensor<real32> target
)
    tensor<real32> magnitude = math.abs(logits)
    tensor<real32> positive = (logits + magnitude) / 2.0
    tensor<real32> tail = math.log(1.0 + math.exp(0.0 - magnitude))
    return internal.mean_all(positive - logits * target + tail)

tensor<real32> cross_entropy(
    tensor<real32> logits,
    tensor<real32> target
)
    tensor<real32> shifted = logits - math.max_last(logits)
    tensor<real32> total = math.sum_last(math.exp(shifted))
    tensor<real32> log_probabilities = shifted - math.log(total)
    tensor<real32> per_class = target * log_probabilities
    return internal.mean_all(0.0 - math.sum_last(per_class))




// Optimizers hold a reference to the model and visit its Parameters in place.
// Copies of Parameters own independent values and gradient destinations.
// Construction records each visit's shape and device and allocates its state.
// A changed structure requires a new optimizer. Parameters without a gradient
// keep their value, moments and step count; successful updates consume only
// the gradients they used. Validation finishes before any update begins.

// Discards the gradient of every Parameter of `model` without updating
// anything: afterwards no Parameter of `model` has a gradient. It reflects
// over the model each time; an optimizer's update() clears the gradients it
// consumed by itself.
reflect.Each<Parameter<T>> parameters<T: floating, M>(M &model)
    return reflect.each<Parameter<T>>(&model)

void clear_grad<M>(M &model)
    for Parameter<real16> &parameter = &parameters(&model)[]
        .parameter.clear_grad()
    for Parameter<real16b> &parameter = &parameters(&model)[]
        .parameter.clear_grad()
    for Parameter<real32> &parameter = &parameters(&model)[]
        .parameter.clear_grad()
    for Parameter<real64> &parameter = &parameters(&model)[]
        .parameter.clear_grad()

class SGD<M>(local M &model_initial, local real64 rate = 0.01) | error

    real64 learning_rate
    private M &model
    private nat[][] shapes16
    private int64[] devices16
    private string[] paths16
    private tensor<real16>[] next16
    private nat[][] shapes16b
    private int64[] devices16b
    private string[] paths16b
    private tensor<real16b>[] next16b
    private nat[][] shapes32
    private int64[] devices32
    private string[] paths32
    private tensor<real32>[] next32
    private nat[][] shapes64
    private int64[] devices64
    private string[] paths64
    private tensor<real64>[] next64
    &model = &model_initial
    if not math.is_finite(rate) or rate <= 0.0
        return error("nn.SGD rate must be finite and positive", code = "NN_ARGUMENT")
    learning_rate = rate
    .record_binding()

    private void .record_binding()
        shapes16 = []
        devices16 = []
        next16 = []
        paths16 = reflect.each_paths<Parameter<real16>>(model)
        for Parameter<real16> &parameter = &reflect.each<Parameter<real16>>(&model)[nat index]
            tensor<real16> raw = parameter.raw()
            nat[] shape = raw.shape()
            int64 device = int64(raw.device())
            shapes16 = shapes16.append(shape)
            devices16 = devices16.append(device)
            if device >= 0
                next16 = next16.append(tensor<real16>(shape, gpu = nat(device)))
            else
                next16 = next16.append(tensor.zeros<real16>(shape))
        shapes16b = []
        devices16b = []
        next16b = []
        paths16b = reflect.each_paths<Parameter<real16b>>(model)
        for Parameter<real16b> &parameter = &reflect.each<Parameter<real16b>>(&model)[nat index]
            tensor<real16b> raw = parameter.raw()
            nat[] shape = raw.shape()
            int64 device = int64(raw.device())
            shapes16b = shapes16b.append(shape)
            devices16b = devices16b.append(device)
            if device >= 0
                next16b = next16b.append(tensor<real16b>(shape, gpu = nat(device)))
            else
                next16b = next16b.append(tensor.zeros<real16b>(shape))
        shapes32 = []
        devices32 = []
        next32 = []
        paths32 = reflect.each_paths<Parameter<real32>>(model)
        for Parameter<real32> &parameter = &reflect.each<Parameter<real32>>(&model)[nat index]
            tensor<real32> raw = parameter.raw()
            nat[] shape = raw.shape()
            int64 device = int64(raw.device())
            shapes32 = shapes32.append(shape)
            devices32 = devices32.append(device)
            if device >= 0
                next32 = next32.append(tensor<real32>(shape, gpu = nat(device)))
            else
                next32 = next32.append(tensor.zeros<real32>(shape))
        shapes64 = []
        devices64 = []
        next64 = []
        paths64 = reflect.each_paths<Parameter<real64>>(model)
        for Parameter<real64> &parameter = &reflect.each<Parameter<real64>>(&model)[nat index]
            tensor<real64> raw = parameter.raw()
            nat[] shape = raw.shape()
            int64 device = int64(raw.device())
            shapes64 = shapes64.append(shape)
            devices64 = devices64.append(device)
            if device >= 0
                next64 = next64.append(tensor<real64>(shape, gpu = nat(device)))
            else
                next64 = next64.append(tensor.zeros<real64>(shape))

    private bool same_device(int observed_device, int64 recorded_device)
        int64 observed = int64(observed_device)
        return observed == recorded_device

    private void | error check_binding(string operation)
        nat count16 = 0
        for Parameter<real16> &parameter = &reflect.each<Parameter<real16>>(&model)[nat index]
            if index >= len(shapes16)
                return error("nn.SGD.{operation}: Parameter<real16> count changed at index {index}; create a new optimizer; nothing changed", code = "NN_STRUCTURE")
            tensor<real16> raw = parameter.raw()
            if raw.shape() != shapes16[index] or not same_device(raw.device(), devices16[index])
                return error("nn.SGD.{operation}: Parameter<real16> at index {index}, " + paths16[index] + ", changed shape or device; create a new optimizer; nothing changed", code = "NN_STRUCTURE")
            count16 += 1
        if count16 != len(shapes16)
            return error("nn.SGD.{operation}: Parameter<real16> count changed at index {count16}; create a new optimizer; nothing changed", code = "NN_STRUCTURE")
        nat count16b = 0
        for Parameter<real16b> &parameter = &reflect.each<Parameter<real16b>>(&model)[nat index]
            if index >= len(shapes16b)
                return error("nn.SGD.{operation}: Parameter<real16b> count changed at index {index}; create a new optimizer; nothing changed", code = "NN_STRUCTURE")
            tensor<real16b> raw = parameter.raw()
            if raw.shape() != shapes16b[index] or not same_device(raw.device(), devices16b[index])
                return error("nn.SGD.{operation}: Parameter<real16b> at index {index}, " + paths16b[index] + ", changed shape or device; create a new optimizer; nothing changed", code = "NN_STRUCTURE")
            count16b += 1
        if count16b != len(shapes16b)
            return error("nn.SGD.{operation}: Parameter<real16b> count changed at index {count16b}; create a new optimizer; nothing changed", code = "NN_STRUCTURE")
        nat count32 = 0
        for Parameter<real32> &parameter = &reflect.each<Parameter<real32>>(&model)[nat index]
            if index >= len(shapes32)
                return error("nn.SGD.{operation}: Parameter<real32> count changed at index {index}; create a new optimizer; nothing changed", code = "NN_STRUCTURE")
            tensor<real32> raw = parameter.raw()
            if raw.shape() != shapes32[index] or not same_device(raw.device(), devices32[index])
                return error("nn.SGD.{operation}: Parameter<real32> at index {index}, " + paths32[index] + ", changed shape or device; create a new optimizer; nothing changed", code = "NN_STRUCTURE")
            count32 += 1
        if count32 != len(shapes32)
            return error("nn.SGD.{operation}: Parameter<real32> count changed at index {count32}; create a new optimizer; nothing changed", code = "NN_STRUCTURE")
        nat count64 = 0
        for Parameter<real64> &parameter = &reflect.each<Parameter<real64>>(&model)[nat index]
            if index >= len(shapes64)
                return error("nn.SGD.{operation}: Parameter<real64> count changed at index {index}; create a new optimizer; nothing changed", code = "NN_STRUCTURE")
            tensor<real64> raw = parameter.raw()
            if raw.shape() != shapes64[index] or not same_device(raw.device(), devices64[index])
                return error("nn.SGD.{operation}: Parameter<real64> at index {index}, " + paths64[index] + ", changed shape or device; create a new optimizer; nothing changed", code = "NN_STRUCTURE")
            count64 += 1
        if count64 != len(shapes64)
            return error("nn.SGD.{operation}: Parameter<real64> count changed at index {count64}; create a new optimizer; nothing changed", code = "NN_STRUCTURE")
        return

    private void | error check_gradients(string operation)
        for Parameter<real16> &parameter = &reflect.each<Parameter<real16>>(&model)[nat index]
            if parameter.has_grad()
                tensor<real16> gradient = parameter.gradient()
                if gradient.shape() != shapes16[index] or not same_device(gradient.device(), devices16[index])
                    return error("nn.SGD.{operation}: gradient of Parameter<real16> at index {index}, " + paths16[index] + ", has a different shape or device; nothing changed", code = "NN_GRADIENT")
        for Parameter<real16b> &parameter = &reflect.each<Parameter<real16b>>(&model)[nat index]
            if parameter.has_grad()
                tensor<real16b> gradient = parameter.gradient()
                if gradient.shape() != shapes16b[index] or not same_device(gradient.device(), devices16b[index])
                    return error("nn.SGD.{operation}: gradient of Parameter<real16b> at index {index}, " + paths16b[index] + ", has a different shape or device; nothing changed", code = "NN_GRADIENT")
        for Parameter<real32> &parameter = &reflect.each<Parameter<real32>>(&model)[nat index]
            if parameter.has_grad()
                tensor<real32> gradient = parameter.gradient()
                if gradient.shape() != shapes32[index] or not same_device(gradient.device(), devices32[index])
                    return error("nn.SGD.{operation}: gradient of Parameter<real32> at index {index}, " + paths32[index] + ", has a different shape or device; nothing changed", code = "NN_GRADIENT")
        for Parameter<real64> &parameter = &reflect.each<Parameter<real64>>(&model)[nat index]
            if parameter.has_grad()
                tensor<real64> gradient = parameter.gradient()
                if gradient.shape() != shapes64[index] or not same_device(gradient.device(), devices64[index])
                    return error("nn.SGD.{operation}: gradient of Parameter<real64> at index {index}, " + paths64[index] + ", has a different shape or device; nothing changed", code = "NN_GRADIENT")
        return

    private void | error .compute16(nat index, tensor<real16> value, tensor<real16> gradient)
        int32 status = int32(-1)
        tensor<real16> dense = gradient
        if native.is_cpu_floating<real16>(value) == int32(1)
            status = native.sgd_update<real16>(value, dense, &next16[index], learning_rate)
        elif value.device() >= int(0) and value.is_contiguous()
            if not dense.is_contiguous()
                dense = dense.contiguous()
            status = native.sgd_half_metal_update<real16>(value, dense, &next16[index], learning_rate)
        if status == int32(0)
            return
        if status >= int32(6)
            return error("nn.SGD.update failed during computation at " + paths16[index] + "; model and optimizer state are unspecified; reload a checkpoint and create a new optimizer", code = "NN_UPDATE_FAILED")
        next16[index] = real16(real32(value) - real32(dense) * try real32(learning_rate))
        return

    private void | error .compute16b(nat index, tensor<real16b> value, tensor<real16b> gradient)
        int32 status = int32(-1)
        tensor<real16b> dense = gradient
        if native.is_cpu_floating<real16b>(value) == int32(1)
            status = native.sgd_update<real16b>(value, dense, &next16b[index], learning_rate)
        elif value.device() >= int(0) and value.is_contiguous()
            if not dense.is_contiguous()
                dense = dense.contiguous()
            status = native.sgd_half_metal_update<real16b>(value, dense, &next16b[index], learning_rate)
        if status == int32(0)
            return
        if status >= int32(6)
            return error("nn.SGD.update failed during computation at " + paths16b[index] + "; model and optimizer state are unspecified; reload a checkpoint and create a new optimizer", code = "NN_UPDATE_FAILED")
        next16b[index] = real16b(real32(value) - real32(dense) * try real32(learning_rate))
        return

    private void | error .compute32(nat index, tensor<real32> value, tensor<real32> gradient)
        int32 status = int32(-1)
        tensor<real32> dense = gradient
        if native.is_cpu_floating<real32>(value) == int32(1)
            status = native.sgd_update<real32>(value, dense, &next32[index], learning_rate)
        elif value.is_contiguous() and native.metal_device_f32(value) >= int32(0)
            if not dense.is_contiguous()
                dense = dense.contiguous()
            status = native.sgd_metal_update(value, dense, &next32[index], learning_rate)
        if status == int32(0)
            return
        if status >= int32(6)
            return error("nn.SGD.update failed during computation at " + paths32[index] + "; model and optimizer state are unspecified; reload a checkpoint and create a new optimizer", code = "NN_UPDATE_FAILED")
        next32[index] = value - dense * try real32(learning_rate)
        return

    private void | error .compute64(nat index, tensor<real64> value, tensor<real64> gradient)
        int32 status = int32(-1)
        tensor<real64> dense = gradient
        if native.is_cpu_floating<real64>(value) == int32(1)
            status = native.sgd_update<real64>(value, dense, &next64[index], learning_rate)
        if status == int32(0)
            return
        if status >= int32(6)
            return error("nn.SGD.update failed during computation at " + paths64[index] + "; model and optimizer state are unspecified; reload a checkpoint and create a new optimizer", code = "NN_UPDATE_FAILED")
        next64[index] = value - dense * learning_rate
        return

    void | error .update()
        try check_binding("update")
        try check_gradients("update")
        for Parameter<real16> &parameter = &reflect.each<Parameter<real16>>(&model)[nat index]
            if parameter.has_grad()
                try .compute16(index, parameter.raw(), parameter.gradient().untrack())
                if native.optimizer_update_completed() != int32(0)
                    return error("nn.SGD.update failed during computation at " + paths16[index] + "; model and optimizer state are unspecified; reload a checkpoint and create a new optimizer", code = "NN_UPDATE_FAILED")
                tensor<real16> old = parameter.raw()
                tensor<real16> next = next16[index]
                next16[index] = old
                .parameter.replace(next)
                .parameter.clear_grad()
        for Parameter<real16b> &parameter = &reflect.each<Parameter<real16b>>(&model)[nat index]
            if parameter.has_grad()
                try .compute16b(index, parameter.raw(), parameter.gradient().untrack())
                if native.optimizer_update_completed() != int32(0)
                    return error("nn.SGD.update failed during computation at " + paths16b[index] + "; model and optimizer state are unspecified; reload a checkpoint and create a new optimizer", code = "NN_UPDATE_FAILED")
                tensor<real16b> old = parameter.raw()
                tensor<real16b> next = next16b[index]
                next16b[index] = old
                .parameter.replace(next)
                .parameter.clear_grad()
        for Parameter<real32> &parameter = &reflect.each<Parameter<real32>>(&model)[nat index]
            if parameter.has_grad()
                try .compute32(index, parameter.raw(), parameter.gradient().untrack())
                if native.optimizer_update_completed() != int32(0)
                    return error("nn.SGD.update failed during computation at " + paths32[index] + "; model and optimizer state are unspecified; reload a checkpoint and create a new optimizer", code = "NN_UPDATE_FAILED")
                tensor<real32> old = parameter.raw()
                tensor<real32> next = next32[index]
                next32[index] = old
                .parameter.replace(next)
                .parameter.clear_grad()
        for Parameter<real64> &parameter = &reflect.each<Parameter<real64>>(&model)[nat index]
            if parameter.has_grad()
                try .compute64(index, parameter.raw(), parameter.gradient().untrack())
                if native.optimizer_update_completed() != int32(0)
                    return error("nn.SGD.update failed during computation at " + paths64[index] + "; model and optimizer state are unspecified; reload a checkpoint and create a new optimizer", code = "NN_UPDATE_FAILED")
                tensor<real64> old = parameter.raw()
                tensor<real64> next = next64[index]
                next64[index] = old
                .parameter.replace(next)
                .parameter.clear_grad()
        return

class Adam<M>(local M &model_initial, local real64 rate = 0.001, local real64 beta1 = 0.9, local real64 beta2 = 0.999, local real64 epsilon = 0.00000001) | error

    real64 learning_rate
    real64 first_decay
    real64 second_decay
    real64 stability
    private M &model
    private nat coefficient_used
    private nat[] coefficient_steps
    private real64[] coefficient_first
    private real64[] coefficient_second
    private real64[] coefficient_scales
    private real64[] coefficient_epsilons
    private nat[][] shapes16
    private int64[] devices16
    private string[] paths16
    private tensor<real16>[] next16
    private nat[] steps16
    private real64[] first_corrections16
    private real64[] second_corrections16
    private tensor<real32>[] first16
    private tensor<real32>[] second16
    private nat[][] shapes16b
    private int64[] devices16b
    private string[] paths16b
    private tensor<real16b>[] next16b
    private nat[] steps16b
    private real64[] first_corrections16b
    private real64[] second_corrections16b
    private tensor<real32>[] first16b
    private tensor<real32>[] second16b
    private nat[][] shapes32
    private int64[] devices32
    private string[] paths32
    private tensor<real32>[] next32
    private nat[] steps32
    private real64[] first_corrections32
    private real64[] second_corrections32
    private tensor<real32>[] first32
    private tensor<real32>[] second32
    private nat[][] shapes64
    private int64[] devices64
    private string[] paths64
    private tensor<real64>[] next64
    private nat[] steps64
    private real64[] first_corrections64
    private real64[] second_corrections64
    private tensor<real64>[] first64
    private tensor<real64>[] second64
    &model = &model_initial
    if not math.is_finite(rate) or rate <= 0.0
        return error("nn.Adam rate must be finite and positive", code = "NN_ARGUMENT")
    if not math.is_finite(beta1) or beta1 < 0.0 or beta1 >= 1.0
        return error("nn.Adam beta1 must be finite and in [0, 1)", code = "NN_ARGUMENT")
    if not math.is_finite(beta2) or beta2 < 0.0 or beta2 >= 1.0
        return error("nn.Adam beta2 must be finite and in [0, 1)", code = "NN_ARGUMENT")
    if not math.is_finite(epsilon) or epsilon <= 0.0
        return error("nn.Adam epsilon must be finite and positive", code = "NN_ARGUMENT")
    learning_rate = rate
    first_decay = beta1
    second_decay = beta2
    stability = epsilon
    .record_binding()
    local nat slots = len(shapes16) + len(shapes16b) + len(shapes32) + len(shapes64)
    coefficient_used = 0
    coefficient_steps = array(slots, fill = nat(0))
    coefficient_first = array(slots, fill = 0.0)
    coefficient_second = array(slots, fill = 0.0)
    coefficient_scales = array(slots, fill = 0.0)
    coefficient_epsilons = array(slots, fill = 0.0)

    private void .record_binding()
        shapes16 = []
        devices16 = []
        next16 = []
        steps16 = []
        first_corrections16 = []
        second_corrections16 = []
        first16 = []
        second16 = []
        paths16 = reflect.each_paths<Parameter<real16>>(model)
        for Parameter<real16> &parameter = &reflect.each<Parameter<real16>>(&model)[nat index]
            tensor<real16> raw = parameter.raw()
            nat[] shape = raw.shape()
            int64 device = int64(raw.device())
            shapes16 = shapes16.append(shape)
            devices16 = devices16.append(device)
            steps16 = steps16.append(0)
            first_corrections16 = first_corrections16.append(0.0)
            second_corrections16 = second_corrections16.append(0.0)
            first16 = first16.append(real32(raw) * real32(0.0))
            second16 = second16.append(real32(raw) * real32(0.0))
            if device >= 0
                next16 = next16.append(tensor<real16>(shape, gpu = nat(device)))
            else
                next16 = next16.append(tensor.zeros<real16>(shape))
        shapes16b = []
        devices16b = []
        next16b = []
        steps16b = []
        first_corrections16b = []
        second_corrections16b = []
        first16b = []
        second16b = []
        paths16b = reflect.each_paths<Parameter<real16b>>(model)
        for Parameter<real16b> &parameter = &reflect.each<Parameter<real16b>>(&model)[nat index]
            tensor<real16b> raw = parameter.raw()
            nat[] shape = raw.shape()
            int64 device = int64(raw.device())
            shapes16b = shapes16b.append(shape)
            devices16b = devices16b.append(device)
            steps16b = steps16b.append(0)
            first_corrections16b = first_corrections16b.append(0.0)
            second_corrections16b = second_corrections16b.append(0.0)
            first16b = first16b.append(real32(raw) * real32(0.0))
            second16b = second16b.append(real32(raw) * real32(0.0))
            if device >= 0
                next16b = next16b.append(tensor<real16b>(shape, gpu = nat(device)))
            else
                next16b = next16b.append(tensor.zeros<real16b>(shape))
        shapes32 = []
        devices32 = []
        next32 = []
        steps32 = []
        first_corrections32 = []
        second_corrections32 = []
        first32 = []
        second32 = []
        paths32 = reflect.each_paths<Parameter<real32>>(model)
        for Parameter<real32> &parameter = &reflect.each<Parameter<real32>>(&model)[nat index]
            tensor<real32> raw = parameter.raw()
            nat[] shape = raw.shape()
            int64 device = int64(raw.device())
            shapes32 = shapes32.append(shape)
            devices32 = devices32.append(device)
            steps32 = steps32.append(0)
            first_corrections32 = first_corrections32.append(0.0)
            second_corrections32 = second_corrections32.append(0.0)
            first32 = first32.append(raw * real32(0.0))
            second32 = second32.append(raw * real32(0.0))
            if device >= 0
                next32 = next32.append(tensor<real32>(shape, gpu = nat(device)))
            else
                next32 = next32.append(tensor.zeros<real32>(shape))
        shapes64 = []
        devices64 = []
        next64 = []
        steps64 = []
        first_corrections64 = []
        second_corrections64 = []
        first64 = []
        second64 = []
        paths64 = reflect.each_paths<Parameter<real64>>(model)
        for Parameter<real64> &parameter = &reflect.each<Parameter<real64>>(&model)[nat index]
            tensor<real64> raw = parameter.raw()
            nat[] shape = raw.shape()
            int64 device = int64(raw.device())
            shapes64 = shapes64.append(shape)
            devices64 = devices64.append(device)
            steps64 = steps64.append(0)
            first_corrections64 = first_corrections64.append(0.0)
            second_corrections64 = second_corrections64.append(0.0)
            first64 = first64.append(raw * 0.0)
            second64 = second64.append(raw * 0.0)
            if device >= 0
                next64 = next64.append(tensor<real64>(shape, gpu = nat(device)))
            else
                next64 = next64.append(tensor.zeros<real64>(shape))

    private bool same_device(int observed_device, int64 recorded_device)
        int64 observed = int64(observed_device)
        return observed == recorded_device

    private void | error check_binding(string operation)
        nat count16 = 0
        for Parameter<real16> &parameter = &reflect.each<Parameter<real16>>(&model)[nat index]
            if index >= len(shapes16)
                return error("nn.Adam.{operation}: Parameter<real16> count changed at index {index}; create a new optimizer; nothing changed", code = "NN_STRUCTURE")
            tensor<real16> raw = parameter.raw()
            if raw.shape() != shapes16[index] or not same_device(raw.device(), devices16[index])
                return error("nn.Adam.{operation}: Parameter<real16> at index {index}, " + paths16[index] + ", changed shape or device; create a new optimizer; nothing changed", code = "NN_STRUCTURE")
            count16 += 1
        if count16 != len(shapes16)
            return error("nn.Adam.{operation}: Parameter<real16> count changed at index {count16}; create a new optimizer; nothing changed", code = "NN_STRUCTURE")
        nat count16b = 0
        for Parameter<real16b> &parameter = &reflect.each<Parameter<real16b>>(&model)[nat index]
            if index >= len(shapes16b)
                return error("nn.Adam.{operation}: Parameter<real16b> count changed at index {index}; create a new optimizer; nothing changed", code = "NN_STRUCTURE")
            tensor<real16b> raw = parameter.raw()
            if raw.shape() != shapes16b[index] or not same_device(raw.device(), devices16b[index])
                return error("nn.Adam.{operation}: Parameter<real16b> at index {index}, " + paths16b[index] + ", changed shape or device; create a new optimizer; nothing changed", code = "NN_STRUCTURE")
            count16b += 1
        if count16b != len(shapes16b)
            return error("nn.Adam.{operation}: Parameter<real16b> count changed at index {count16b}; create a new optimizer; nothing changed", code = "NN_STRUCTURE")
        nat count32 = 0
        for Parameter<real32> &parameter = &reflect.each<Parameter<real32>>(&model)[nat index]
            if index >= len(shapes32)
                return error("nn.Adam.{operation}: Parameter<real32> count changed at index {index}; create a new optimizer; nothing changed", code = "NN_STRUCTURE")
            tensor<real32> raw = parameter.raw()
            if raw.shape() != shapes32[index] or not same_device(raw.device(), devices32[index])
                return error("nn.Adam.{operation}: Parameter<real32> at index {index}, " + paths32[index] + ", changed shape or device; create a new optimizer; nothing changed", code = "NN_STRUCTURE")
            count32 += 1
        if count32 != len(shapes32)
            return error("nn.Adam.{operation}: Parameter<real32> count changed at index {count32}; create a new optimizer; nothing changed", code = "NN_STRUCTURE")
        nat count64 = 0
        for Parameter<real64> &parameter = &reflect.each<Parameter<real64>>(&model)[nat index]
            if index >= len(shapes64)
                return error("nn.Adam.{operation}: Parameter<real64> count changed at index {index}; create a new optimizer; nothing changed", code = "NN_STRUCTURE")
            tensor<real64> raw = parameter.raw()
            if raw.shape() != shapes64[index] or not same_device(raw.device(), devices64[index])
                return error("nn.Adam.{operation}: Parameter<real64> at index {index}, " + paths64[index] + ", changed shape or device; create a new optimizer; nothing changed", code = "NN_STRUCTURE")
            count64 += 1
        if count64 != len(shapes64)
            return error("nn.Adam.{operation}: Parameter<real64> count changed at index {count64}; create a new optimizer; nothing changed", code = "NN_STRUCTURE")
        return

    private void | error check_gradients(string operation)
        for Parameter<real16> &parameter = &reflect.each<Parameter<real16>>(&model)[nat index]
            if parameter.has_grad()
                tensor<real16> gradient = parameter.gradient()
                if gradient.shape() != shapes16[index] or not same_device(gradient.device(), devices16[index])
                    return error("nn.Adam.{operation}: gradient of Parameter<real16> at index {index}, " + paths16[index] + ", has a different shape or device; nothing changed", code = "NN_GRADIENT")
        for Parameter<real16b> &parameter = &reflect.each<Parameter<real16b>>(&model)[nat index]
            if parameter.has_grad()
                tensor<real16b> gradient = parameter.gradient()
                if gradient.shape() != shapes16b[index] or not same_device(gradient.device(), devices16b[index])
                    return error("nn.Adam.{operation}: gradient of Parameter<real16b> at index {index}, " + paths16b[index] + ", has a different shape or device; nothing changed", code = "NN_GRADIENT")
        for Parameter<real32> &parameter = &reflect.each<Parameter<real32>>(&model)[nat index]
            if parameter.has_grad()
                tensor<real32> gradient = parameter.gradient()
                if gradient.shape() != shapes32[index] or not same_device(gradient.device(), devices32[index])
                    return error("nn.Adam.{operation}: gradient of Parameter<real32> at index {index}, " + paths32[index] + ", has a different shape or device; nothing changed", code = "NN_GRADIENT")
        for Parameter<real64> &parameter = &reflect.each<Parameter<real64>>(&model)[nat index]
            if parameter.has_grad()
                tensor<real64> gradient = parameter.gradient()
                if gradient.shape() != shapes64[index] or not same_device(gradient.device(), devices64[index])
                    return error("nn.Adam.{operation}: gradient of Parameter<real64> at index {index}, " + paths64[index] + ", has a different shape or device; nothing changed", code = "NN_GRADIENT")
        return

    private void | error check_model(string operation, M &model_argument)
        if &model_argument != &model
            return error("nn.Adam.{operation}: model differs from the bound model; nothing changed", code = "NN_BINDING")
        try check_binding(operation)
        return
    void | error save(M &model_argument, string path)
        try check_model("save", &model_argument)
        internal.StateEntrySchema[] expected = model_schema(&model_argument)
        try internal.validate_model_schema(expected, "nn.Adam.save")
        file.Handle output = try file.create(path)
        internal.StateChecksum checksum = internal.StateChecksum()
        try internal.write_checked_line(&output, &checksum, "QUIDRA_DNN_STATE")
        try internal.write_checked_line(&output, &checksum, "5")
        try internal.write_checked_line(&output, &checksum, "model+Adam")
        try internal.write_checked_line(&output, &checksum, reflect.type_name(model_argument))
        try internal.write_checked_line(&output, &checksum, len(expected).string())
        try write_model_entries(&output, &checksum, &model_argument)
        try internal.write_checked_line(&output, &checksum, "Adam")
        try internal.write_checked_line(&output, &checksum, learning_rate.string())
        try internal.write_checked_line(&output, &checksum, first_decay.string())
        try internal.write_checked_line(&output, &checksum, second_decay.string())
        try internal.write_checked_line(&output, &checksum, stability.string())
        try internal.write_checked_line(&output, &checksum, (len(paths16) + len(paths16b) + len(paths32) + len(paths64)).string())
        for auto entry_path = paths16[nat index]
            try internal.write_adam_step(&output, &checksum, entry_path, steps16[index], first_corrections16[index], second_corrections16[index])
            try internal.write_state_entry(&output, &checksum, "AdamFirst", "real32", entry_path, first16[index])
            try internal.write_state_entry(&output, &checksum, "AdamSecond", "real32", entry_path, second16[index])
        for auto entry_path = paths16b[nat index]
            try internal.write_adam_step(&output, &checksum, entry_path, steps16b[index], first_corrections16b[index], second_corrections16b[index])
            try internal.write_state_entry(&output, &checksum, "AdamFirst", "real32", entry_path, first16b[index])
            try internal.write_state_entry(&output, &checksum, "AdamSecond", "real32", entry_path, second16b[index])
        for auto entry_path = paths32[nat index]
            try internal.write_adam_step(&output, &checksum, entry_path, steps32[index], first_corrections32[index], second_corrections32[index])
            try internal.write_state_entry(&output, &checksum, "AdamFirst", "real32", entry_path, first32[index])
            try internal.write_state_entry(&output, &checksum, "AdamSecond", "real32", entry_path, second32[index])
        for auto entry_path = paths64[nat index]
            try internal.write_adam_step(&output, &checksum, entry_path, steps64[index], first_corrections64[index], second_corrections64[index])
            try internal.write_state_entry(&output, &checksum, "AdamFirst", "real64", entry_path, first64[index])
            try internal.write_state_entry(&output, &checksum, "AdamSecond", "real64", entry_path, second64[index])
        try internal.finish_state_write(&output, checksum)
        return

    void | error .load(M &model_argument, string path)
        try check_model("load", &model_argument)
        internal.StateEntrySchema[] expected = model_schema(&model_argument)
        try internal.validate_model_schema(expected, "nn.Adam.load")
        for auto entry_path = paths16[nat index]
            expected = expected.append(internal.adam_step_schema(internal.StoredAdamStep(path_initial = entry_path, step_initial = internal.adam_step(0, 0.0, 0.0))))
            expected = expected.append(internal.adam_state_schema(internal.StateEntrySchema(kind_initial = "AdamFirst", dtype_initial = "real32", path_initial = entry_path, shape_initial = shapes16[index]), "first"))
            expected = expected.append(internal.adam_state_schema(internal.StateEntrySchema(kind_initial = "AdamSecond", dtype_initial = "real32", path_initial = entry_path, shape_initial = shapes16[index]), "second"))
        for auto entry_path = paths16b[nat index]
            expected = expected.append(internal.adam_step_schema(internal.StoredAdamStep(path_initial = entry_path, step_initial = internal.adam_step(0, 0.0, 0.0))))
            expected = expected.append(internal.adam_state_schema(internal.StateEntrySchema(kind_initial = "AdamFirst", dtype_initial = "real32", path_initial = entry_path, shape_initial = shapes16b[index]), "first"))
            expected = expected.append(internal.adam_state_schema(internal.StateEntrySchema(kind_initial = "AdamSecond", dtype_initial = "real32", path_initial = entry_path, shape_initial = shapes16b[index]), "second"))
        for auto entry_path = paths32[nat index]
            expected = expected.append(internal.adam_step_schema(internal.StoredAdamStep(path_initial = entry_path, step_initial = internal.adam_step(0, 0.0, 0.0))))
            expected = expected.append(internal.adam_state_schema(internal.StateEntrySchema(kind_initial = "AdamFirst", dtype_initial = "real32", path_initial = entry_path, shape_initial = shapes32[index]), "first"))
            expected = expected.append(internal.adam_state_schema(internal.StateEntrySchema(kind_initial = "AdamSecond", dtype_initial = "real32", path_initial = entry_path, shape_initial = shapes32[index]), "second"))
        for auto entry_path = paths64[nat index]
            expected = expected.append(internal.adam_step_schema(internal.StoredAdamStep(path_initial = entry_path, step_initial = internal.adam_step(0, 0.0, 0.0))))
            expected = expected.append(internal.adam_state_schema(internal.StateEntrySchema(kind_initial = "AdamFirst", dtype_initial = "real64", path_initial = entry_path, shape_initial = shapes64[index]), "first"))
            expected = expected.append(internal.adam_state_schema(internal.StateEntrySchema(kind_initial = "AdamSecond", dtype_initial = "real64", path_initial = entry_path, shape_initial = shapes64[index]), "second"))
        file.Handle input = try file.open(path)
        internal.StateChecksum checksum = internal.StateChecksum()
        string magic = try internal.read_checked_line(&input, &checksum, "magic")
        if magic != "QUIDRA_DNN_STATE"
            return error("nn.Adam.load state file has an unsupported magic", code = "NN_CHECKPOINT_FILE")
        string version = try internal.read_checked_line(&input, &checksum, "format version")
        if version != "2" and version != "3" and version != "5"
            return error("nn.Adam.load state file has an unsupported format version", code = "NN_CHECKPOINT_FILE")
        string container_kind = try internal.read_checked_line(&input, &checksum, "container kind")
        if container_kind != "model+Adam"
            return error("nn.Adam.load state file is not an Adam checkpoint", code = "NN_CHECKPOINT_FILE")
        string root_type = try internal.read_checked_line(&input, &checksum, "root model type")
        internal.StateTable stored = try internal.read_model_entries(&input, &checksum, version)
        internal.StateEntrySchema[] actual = stored.schemas
        string optimizer_kind = try internal.read_checked_line(&input, &checksum, "optimizer kind")
        if optimizer_kind != "Adam"
            return error("nn.Adam.load invalid optimizer kind", code = "NN_CHECKPOINT_FILE")
        real64 loaded_learning_rate = try internal.parse_state_real64(try internal.read_checked_line(&input, &checksum, "Adam learning rate"), "Adam learning rate")
        real64 loaded_first_decay = try internal.parse_state_real64(try internal.read_checked_line(&input, &checksum, "Adam beta1"), "Adam beta1")
        real64 loaded_second_decay = try internal.parse_state_real64(try internal.read_checked_line(&input, &checksum, "Adam beta2"), "Adam beta2")
        real64 loaded_stability = try internal.parse_state_real64(try internal.read_checked_line(&input, &checksum, "Adam epsilon"), "Adam epsilon")
        nat loaded_iteration = 0
        real64 loaded_first_correction = 0.0
        real64 loaded_second_correction = 0.0
        int slot_count = 0
        int legacy_count32 = 0
        if version == "5"
            slot_count = try internal.parse_nonnegative_state_int(try internal.read_checked_line(&input, &checksum, "Adam slot count"), "Adam slot count")
        else
            loaded_iteration = nat(try internal.parse_nonnegative_state_int(try internal.read_checked_line(&input, &checksum, "Adam iteration"), "Adam iteration"))
            if version == "3"
                loaded_first_correction = try internal.parse_state_real64(try internal.read_checked_line(&input, &checksum, "Adam beta1 correction"), "Adam beta1 correction")
                loaded_second_correction = try internal.parse_state_real64(try internal.read_checked_line(&input, &checksum, "Adam beta2 correction"), "Adam beta2 correction")
            legacy_count32 = try internal.parse_nonnegative_state_int(try internal.read_checked_line(&input, &checksum, "Adam real32 count"), "Adam real32 count")
            int legacy_count64 = try internal.parse_nonnegative_state_int(try internal.read_checked_line(&input, &checksum, "Adam real64 count"), "Adam real64 count")
            if legacy_count32 > 9223372036854775807 - legacy_count64
                return error("nn.Adam.load Adam slot count overflows the storage limit", code = "NN_CHECKPOINT_FILE")
            slot_count = legacy_count32 + legacy_count64
        internal.StoredAdamStep[] stored_steps = []
        internal.StateTable stored_first = internal.StateTable()
        internal.StateTable stored_second = internal.StateTable()
        for 0 <= int index < slot_count
            internal.StoredAdamStep step
            if version == "5"
                step = try internal.read_stored_adam_step(&input, &checksum)
                try .stored_first.read_entry(&input, &checksum, "AdamFirst")
                try .stored_second.read_entry(&input, &checksum, "AdamSecond")
            else
                if index < legacy_count32
                    try .stored_first.read_legacy32(&input, &checksum, "AdamFirst")
                    try .stored_second.read_legacy32(&input, &checksum, "AdamSecond")
                else
                    try .stored_first.read_legacy64(&input, &checksum, "AdamFirst")
                    try .stored_second.read_legacy64(&input, &checksum, "AdamSecond")
                nat legacy_schema_index = nat(index)
                step = internal.StoredAdamStep(path_initial = stored_first.schemas[legacy_schema_index].path, step_initial = internal.adam_step(loaded_iteration, loaded_first_correction, loaded_second_correction))
            nat first_schema_index = nat(index)
            internal.StateEntrySchema first = stored_first.schemas[first_schema_index]
            nat second_schema_index = nat(index)
            internal.StateEntrySchema second = stored_second.schemas[second_schema_index]
            if first.path != step.path or second.path != step.path
                return error("nn.Adam.load Adam step and moments must carry one path", code = "NN_CHECKPOINT_FILE")
            stored_steps = stored_steps.append(step)
            actual = actual.append(internal.adam_step_schema(step))
            actual = actual.append(internal.adam_state_schema(first, "first"))
            actual = actual.append(internal.adam_state_schema(second, "second"))
        try internal.verify_state_checksum(&input, checksum)
        try internal.compare_state_schema(expected, actual, root_type, reflect.type_name(model_argument), "nn.Adam.load", path)
        if not math.is_finite(loaded_learning_rate) or loaded_learning_rate <= 0.0
            return error("nn.Adam.load learning rate must be finite and positive", code = "NN_CHECKPOINT_FILE")
        if not math.is_finite(loaded_first_decay) or loaded_first_decay < 0.0 or loaded_first_decay >= 1.0
            return error("nn.Adam.load beta1 must be finite and in [0, 1)", code = "NN_CHECKPOINT_FILE")
        if not math.is_finite(loaded_second_decay) or loaded_second_decay < 0.0 or loaded_second_decay >= 1.0
            return error("nn.Adam.load beta2 must be finite and in [0, 1)", code = "NN_CHECKPOINT_FILE")
        if not math.is_finite(loaded_stability) or loaded_stability <= 0.0
            return error("nn.Adam.load epsilon must be finite and positive", code = "NN_CHECKPOINT_FILE")
        if version == "2" and loaded_iteration > 0
            // Reconstruct only after the schema and hyperparameters are valid.
            loaded_first_correction = 1.0 - math.pow(loaded_first_decay, real64(loaded_iteration))
            loaded_second_correction = 1.0 - math.pow(loaded_second_decay, real64(loaded_iteration))
            for 0 <= nat index < len(stored_steps)
                stored_steps[index].step = internal.adam_step(loaded_iteration, loaded_first_correction, loaded_second_correction)
        for auto step = stored_steps[]
            try internal.check_adam_step(step.step.count, step.step.first_correction, step.step.second_correction)
        string[] parameter_paths16 = reflect.each_paths<Parameter<real16>>(model_argument)
        tensor<real16>[] loaded_parameter16 = []
        for auto entry_path = parameter_paths16[]
            tensor<real16> value = try internal.select_stored_tensor<real16>(stored.values16, entry_path)
            loaded_parameter16 = loaded_parameter16.append(value)
        string[] parameter_paths16b = reflect.each_paths<Parameter<real16b>>(model_argument)
        tensor<real16b>[] loaded_parameter16b = []
        for auto entry_path = parameter_paths16b[]
            tensor<real16b> value = try internal.select_stored_tensor<real16b>(stored.values16b, entry_path)
            loaded_parameter16b = loaded_parameter16b.append(value)
        string[] parameter_paths32 = reflect.each_paths<Parameter<real32>>(model_argument)
        tensor<real32>[] loaded_parameter32 = []
        for auto entry_path = parameter_paths32[]
            tensor<real32> value = try internal.select_stored_tensor<real32>(stored.values32, entry_path)
            loaded_parameter32 = loaded_parameter32.append(value)
        string[] parameter_paths64 = reflect.each_paths<Parameter<real64>>(model_argument)
        tensor<real64>[] loaded_parameter64 = []
        for auto entry_path = parameter_paths64[]
            tensor<real64> value = try internal.select_stored_tensor<real64>(stored.values64, entry_path)
            loaded_parameter64 = loaded_parameter64.append(value)
        string[] state_paths16 = reflect.each_paths<State<real16>>(model_argument)
        tensor<real16>[] loaded_state16 = []
        for auto entry_path = state_paths16[]
            tensor<real16> value = try internal.select_stored_tensor<real16>(stored.values16, entry_path)
            loaded_state16 = loaded_state16.append(value)
        string[] state_paths16b = reflect.each_paths<State<real16b>>(model_argument)
        tensor<real16b>[] loaded_state16b = []
        for auto entry_path = state_paths16b[]
            tensor<real16b> value = try internal.select_stored_tensor<real16b>(stored.values16b, entry_path)
            loaded_state16b = loaded_state16b.append(value)
        string[] state_paths32 = reflect.each_paths<State<real32>>(model_argument)
        tensor<real32>[] loaded_state32 = []
        for auto entry_path = state_paths32[]
            tensor<real32> value = try internal.select_stored_tensor<real32>(stored.values32, entry_path)
            loaded_state32 = loaded_state32.append(value)
        string[] state_paths64 = reflect.each_paths<State<real64>>(model_argument)
        tensor<real64>[] loaded_state64 = []
        for auto entry_path = state_paths64[]
            tensor<real64> value = try internal.select_stored_tensor<real64>(stored.values64, entry_path)
            loaded_state64 = loaded_state64.append(value)
        nat[] loaded_steps16 = []
        real64[] loaded_first_corrections16 = []
        real64[] loaded_second_corrections16 = []
        tensor<real32>[] loaded_first16 = []
        tensor<real32>[] loaded_second16 = []
        for auto entry_path = parameter_paths16[nat index]
            internal.AdamStep step = try internal.select_adam_step(stored_steps, entry_path)
            loaded_steps16 = loaded_steps16.append(step.count)
            loaded_first_corrections16 = loaded_first_corrections16.append(step.first_correction)
            loaded_second_corrections16 = loaded_second_corrections16.append(step.second_correction)
            tensor<real16> value = loaded_parameter16[index]
            tensor<real32> first = try internal.select_stored_tensor<real32>(stored_first.values32, entry_path)
            tensor<real32> second = try internal.select_stored_tensor<real32>(stored_second.values32, entry_path)
            int64 device = devices16[index]
            if device >= 0
                value = value.gpu(nat(device))
                first = first.gpu(nat(device))
                second = second.gpu(nat(device))
            loaded_parameter16[index] = value
            loaded_first16 = loaded_first16.append(first)
            loaded_second16 = loaded_second16.append(second)
        nat[] loaded_steps16b = []
        real64[] loaded_first_corrections16b = []
        real64[] loaded_second_corrections16b = []
        tensor<real32>[] loaded_first16b = []
        tensor<real32>[] loaded_second16b = []
        for auto entry_path = parameter_paths16b[nat index]
            internal.AdamStep step = try internal.select_adam_step(stored_steps, entry_path)
            loaded_steps16b = loaded_steps16b.append(step.count)
            loaded_first_corrections16b = loaded_first_corrections16b.append(step.first_correction)
            loaded_second_corrections16b = loaded_second_corrections16b.append(step.second_correction)
            tensor<real16b> value = loaded_parameter16b[index]
            tensor<real32> first = try internal.select_stored_tensor<real32>(stored_first.values32, entry_path)
            tensor<real32> second = try internal.select_stored_tensor<real32>(stored_second.values32, entry_path)
            int64 device = devices16b[index]
            if device >= 0
                value = value.gpu(nat(device))
                first = first.gpu(nat(device))
                second = second.gpu(nat(device))
            loaded_parameter16b[index] = value
            loaded_first16b = loaded_first16b.append(first)
            loaded_second16b = loaded_second16b.append(second)
        nat[] loaded_steps32 = []
        real64[] loaded_first_corrections32 = []
        real64[] loaded_second_corrections32 = []
        tensor<real32>[] loaded_first32 = []
        tensor<real32>[] loaded_second32 = []
        for auto entry_path = parameter_paths32[nat index]
            internal.AdamStep step = try internal.select_adam_step(stored_steps, entry_path)
            loaded_steps32 = loaded_steps32.append(step.count)
            loaded_first_corrections32 = loaded_first_corrections32.append(step.first_correction)
            loaded_second_corrections32 = loaded_second_corrections32.append(step.second_correction)
            tensor<real32> value = loaded_parameter32[index]
            tensor<real32> first = try internal.select_stored_tensor<real32>(stored_first.values32, entry_path)
            tensor<real32> second = try internal.select_stored_tensor<real32>(stored_second.values32, entry_path)
            int64 device = devices32[index]
            if device >= 0
                value = value.gpu(nat(device))
                first = first.gpu(nat(device))
                second = second.gpu(nat(device))
            loaded_parameter32[index] = value
            loaded_first32 = loaded_first32.append(first)
            loaded_second32 = loaded_second32.append(second)
        nat[] loaded_steps64 = []
        real64[] loaded_first_corrections64 = []
        real64[] loaded_second_corrections64 = []
        tensor<real64>[] loaded_first64 = []
        tensor<real64>[] loaded_second64 = []
        for auto entry_path = parameter_paths64[nat index]
            internal.AdamStep step = try internal.select_adam_step(stored_steps, entry_path)
            loaded_steps64 = loaded_steps64.append(step.count)
            loaded_first_corrections64 = loaded_first_corrections64.append(step.first_correction)
            loaded_second_corrections64 = loaded_second_corrections64.append(step.second_correction)
            tensor<real64> value = loaded_parameter64[index]
            tensor<real64> first = try internal.select_stored_tensor<real64>(stored_first.values64, entry_path)
            tensor<real64> second = try internal.select_stored_tensor<real64>(stored_second.values64, entry_path)
            int64 device = devices64[index]
            if device >= 0
                value = value.gpu(nat(device))
                first = first.gpu(nat(device))
                second = second.gpu(nat(device))
            loaded_parameter64[index] = value
            loaded_first64 = loaded_first64.append(first)
            loaded_second64 = loaded_second64.append(second)
        // The validated temporaries are complete before any model or optimizer write.
        for Parameter<real16> &entry = &reflect.each<Parameter<real16>>(&model_argument)[nat index]
            .entry.replace(loaded_parameter16[index])
        for Parameter<real16b> &entry = &reflect.each<Parameter<real16b>>(&model_argument)[nat index]
            .entry.replace(loaded_parameter16b[index])
        for Parameter<real32> &entry = &reflect.each<Parameter<real32>>(&model_argument)[nat index]
            .entry.replace(loaded_parameter32[index])
        for Parameter<real64> &entry = &reflect.each<Parameter<real64>>(&model_argument)[nat index]
            .entry.replace(loaded_parameter64[index])
        for State<real16> &entry = &reflect.each<State<real16>>(&model_argument)[nat index]
            .entry.replace(loaded_state16[index])
        for State<real16b> &entry = &reflect.each<State<real16b>>(&model_argument)[nat index]
            .entry.replace(loaded_state16b[index])
        for State<real32> &entry = &reflect.each<State<real32>>(&model_argument)[nat index]
            .entry.replace(loaded_state32[index])
        for State<real64> &entry = &reflect.each<State<real64>>(&model_argument)[nat index]
            .entry.replace(loaded_state64[index])
        steps16 = loaded_steps16
        first_corrections16 = loaded_first_corrections16
        second_corrections16 = loaded_second_corrections16
        first16 = loaded_first16
        second16 = loaded_second16
        steps16b = loaded_steps16b
        first_corrections16b = loaded_first_corrections16b
        second_corrections16b = loaded_second_corrections16b
        first16b = loaded_first16b
        second16b = loaded_second16b
        steps32 = loaded_steps32
        first_corrections32 = loaded_first_corrections32
        second_corrections32 = loaded_second_corrections32
        first32 = loaded_first32
        second32 = loaded_second32
        steps64 = loaded_steps64
        first_corrections64 = loaded_first_corrections64
        second_corrections64 = loaded_second_corrections64
        first64 = loaded_first64
        second64 = loaded_second64
        learning_rate = loaded_learning_rate
        first_decay = loaded_first_decay
        second_decay = loaded_second_decay
        stability = loaded_stability
        return

    // Equal step counts share coefficients only when their stored correction
    // state is equal as well. Loaded checkpoints may carry different state.
    private nat .coefficients(nat count, real64 first, real64 second)
        for 0 <= nat index < coefficient_used
            if coefficient_steps[index] == count and coefficient_first[index] == first and coefficient_second[index] == second
                return index
        nat index = coefficient_used
        if index >= len(coefficient_steps)
            error("nn.Adam coefficient cache exceeds the recorded Parameter count", code = "NN_INTERNAL")
        real64 first_correction = advanced(first, first_decay)
        real64 second_correction = advanced(second, second_decay)
        real64 correction2_root = math.sqrt(second_correction)
        coefficient_steps[index] = count
        coefficient_first[index] = first
        coefficient_second[index] = second
        coefficient_scales[index] = learning_rate * correction2_root / first_correction
        coefficient_epsilons[index] = stability * correction2_root
        coefficient_used += 1
        return index

    private real64 advanced(real64 correction, real64 decay)
        return correction + (1.0 - correction) * (1.0 - decay)

    private void | error .compute16(nat index, tensor<real16> raw, tensor<real16> gradient)
        nat coefficient = .coefficients(steps16[index] + 1, first_corrections16[index], second_corrections16[index])
        real32 step_scale = real32(coefficient_scales[coefficient])
        real32 adjusted_epsilon = real32(coefficient_epsilons[coefficient])
        real32 beta1 = real32(first_decay)
        real32 beta2 = real32(second_decay)
        real32 one_minus_beta1 = real32(1.0 - first_decay)
        real32 one_minus_beta2 = real32(1.0 - second_decay)
        tensor<real16> dense_source = gradient
        if not dense_source.is_contiguous()
            dense_source = dense_source.contiguous()
        int32 status = native.adam_half_update<real16>(raw, dense_source, &first16[index], &second16[index], &next16[index], first_decay, second_decay, 1.0 - first_decay, 1.0 - second_decay, coefficient_epsilons[coefficient], coefficient_scales[coefficient])
        if status == int32(0)
            return
        if status >= int32(6)
            return error("nn.Adam.update failed during computation at " + paths16[index] + "; model and optimizer state are unspecified; reload a checkpoint and create a new optimizer", code = "NN_UPDATE_FAILED")
        tensor<real32> value = real32(raw)
        tensor<real32> dense = real32(gradient)
        tensor<real32> next_first = first16[index] * beta1 + dense * one_minus_beta1
        tensor<real32> next_second = second16[index] * beta2 + dense * dense * one_minus_beta2
        tensor<real32> denominator = math.sqrt(next_second) + adjusted_epsilon
        next16[index] = real16(value - (next_first / denominator) * step_scale)
        first16[index] = next_first
        second16[index] = next_second
        return

    private void .commit16(nat index, Parameter<real16> &parameter)
        steps16[index] += 1
        first_corrections16[index] = advanced(first_corrections16[index], first_decay)
        second_corrections16[index] = advanced(second_corrections16[index], second_decay)
        tensor<real16> next = next16[index]
        next16[index] = parameter.raw()
        .parameter.replace(next)

    private void | error .compute16b(nat index, tensor<real16b> raw, tensor<real16b> gradient)
        nat coefficient = .coefficients(steps16b[index] + 1, first_corrections16b[index], second_corrections16b[index])
        real32 step_scale = real32(coefficient_scales[coefficient])
        real32 adjusted_epsilon = real32(coefficient_epsilons[coefficient])
        real32 beta1 = real32(first_decay)
        real32 beta2 = real32(second_decay)
        real32 one_minus_beta1 = real32(1.0 - first_decay)
        real32 one_minus_beta2 = real32(1.0 - second_decay)
        tensor<real16b> dense_source = gradient
        if not dense_source.is_contiguous()
            dense_source = dense_source.contiguous()
        int32 status = native.adam_half_update<real16b>(raw, dense_source, &first16b[index], &second16b[index], &next16b[index], first_decay, second_decay, 1.0 - first_decay, 1.0 - second_decay, coefficient_epsilons[coefficient], coefficient_scales[coefficient])
        if status == int32(0)
            return
        if status >= int32(6)
            return error("nn.Adam.update failed during computation at " + paths16b[index] + "; model and optimizer state are unspecified; reload a checkpoint and create a new optimizer", code = "NN_UPDATE_FAILED")
        tensor<real32> value = real32(raw)
        tensor<real32> dense = real32(gradient)
        tensor<real32> next_first = first16b[index] * beta1 + dense * one_minus_beta1
        tensor<real32> next_second = second16b[index] * beta2 + dense * dense * one_minus_beta2
        tensor<real32> denominator = math.sqrt(next_second) + adjusted_epsilon
        next16b[index] = real16b(value - (next_first / denominator) * step_scale)
        first16b[index] = next_first
        second16b[index] = next_second
        return

    private void .commit16b(nat index, Parameter<real16b> &parameter)
        steps16b[index] += 1
        first_corrections16b[index] = advanced(first_corrections16b[index], first_decay)
        second_corrections16b[index] = advanced(second_corrections16b[index], second_decay)
        tensor<real16b> next = next16b[index]
        next16b[index] = parameter.raw()
        .parameter.replace(next)
    private void | error .compute32(
        nat index,
        tensor<real32> value,
        tensor<real32> gradient
    )
        nat coefficient = .coefficients(steps32[index] + 1, first_corrections32[index], second_corrections32[index])
        real64 step_scale = coefficient_scales[coefficient]
        real64 adjusted_epsilon = coefficient_epsilons[coefficient]
        real64 one_minus_beta1 = 1.0 - first_decay
        real64 one_minus_beta2 = 1.0 - second_decay
        tensor<real32> dense = gradient
        int32 native_status = int32(-1)
        if native.is_cpu_floating<real32>(value) == int32(1)
            native_status = native.adam_update<real32>(
                value,
                dense,
                &first32[index],
                &second32[index],
                &next32[index],
                first_decay,
                second_decay,
                one_minus_beta1,
                one_minus_beta2,
                adjusted_epsilon,
                step_scale
            )
        elif value.is_contiguous() and native.metal_device_f32(value) >= int32(0)
            // A gradient can arrive as a strided view (Math's matmul
            // backward gives an FC weight one). The fused kernel reads dense
            // tensors, so copy it on the device; the values do not change.
            if not dense.is_contiguous()
                dense = dense.contiguous()
            native_status = native.adam_metal_update(
                value,
                dense,
                &first32[index],
                &second32[index],
                &next32[index],
                first_decay,
                second_decay,
                one_minus_beta1,
                one_minus_beta2,
                adjusted_epsilon,
                step_scale
            )
        if native_status == int32(0)
            return
        if native_status >= int32(6)
            return error("nn.Adam.update failed during computation at " + paths32[index] + "; model and optimizer state are unspecified; reload a checkpoint and create a new optimizer", code = "NN_UPDATE_FAILED")
        tensor<real32> first = first32[index]
        tensor<real32> second = second32[index]

        real32 beta1_32 = real32(first_decay)
        real32 beta2_32 = real32(second_decay)
        real32 one_minus_beta1_32 = real32(1.0 - first_decay)
        real32 one_minus_beta2_32 = real32(1.0 - second_decay)
        real32 adjusted_epsilon32 = real32(adjusted_epsilon)
        real32 step_scale32 = real32(step_scale)
        tensor<real32> next_first = (
            first * beta1_32
            + dense * one_minus_beta1_32
        )
        tensor<real32> next_second = (
            second * beta2_32
            + dense * dense * one_minus_beta2_32
        )
        tensor<real32> denominator = (
            math.sqrt(next_second) + adjusted_epsilon32
        )
        next32[index] = value - (next_first / denominator) * step_scale32
        first32[index] = next_first
        second32[index] = next_second
        return


    private void .commit32(nat index, Parameter<real32> &parameter)
        steps32[index] += 1
        first_corrections32[index] = advanced(first_corrections32[index], first_decay)
        second_corrections32[index] = advanced(second_corrections32[index], second_decay)
        tensor<real32> next = next32[index]
        next32[index] = parameter.raw()
        .parameter.replace(next)
    private void | error .compute64(
        nat index,
        tensor<real64> value,
        tensor<real64> gradient
    )
        nat coefficient = .coefficients(steps64[index] + 1, first_corrections64[index], second_corrections64[index])
        real64 step_scale = coefficient_scales[coefficient]
        real64 adjusted_epsilon = coefficient_epsilons[coefficient]
        real64 one_minus_beta1 = 1.0 - first_decay
        real64 one_minus_beta2 = 1.0 - second_decay
        int32 native_status = int32(-1)
        if native.is_cpu_floating<real64>(value) == int32(1)
            native_status = native.adam_update<real64>(
                value,
                gradient,
                &first64[index],
                &second64[index],
                &next64[index],
                first_decay,
                second_decay,
                one_minus_beta1,
                one_minus_beta2,
                adjusted_epsilon,
                step_scale
            )
        if native_status == int32(0)
            return
        if native_status >= int32(6)
            return error("nn.Adam.update failed during computation at " + paths64[index] + "; model and optimizer state are unspecified; reload a checkpoint and create a new optimizer", code = "NN_UPDATE_FAILED")
        tensor<real64> first = first64[index]
        tensor<real64> second = second64[index]

        tensor<real64> next_first = (
            first * first_decay
            + gradient * one_minus_beta1
        )
        tensor<real64> next_second = (
            second * second_decay
            + gradient * gradient * one_minus_beta2
        )
        tensor<real64> denominator = (
            math.sqrt(next_second) + adjusted_epsilon
        )
        next64[index] = value - (next_first / denominator) * step_scale
        first64[index] = next_first
        second64[index] = next_second
        return


    private void .commit64(nat index, Parameter<real64> &parameter)
        steps64[index] += 1
        first_corrections64[index] = advanced(first_corrections64[index], first_decay)
        second_corrections64[index] = advanced(second_corrections64[index], second_decay)
        tensor<real64> next = next64[index]
        next64[index] = parameter.raw()
        .parameter.replace(next)

    void | error .update()
        try check_binding("update")
        try check_gradients("update")
        coefficient_used = 0
        for Parameter<real16> &parameter = &reflect.each<Parameter<real16>>(&model)[nat index]
            if parameter.has_grad()
                try .compute16(index, parameter.raw(), parameter.gradient().untrack())
                if native.optimizer_update_completed() != int32(0)
                    return error("nn.Adam.update failed during computation at " + paths16[index] + "; model and optimizer state are unspecified; reload a checkpoint and create a new optimizer", code = "NN_UPDATE_FAILED")
                .commit16(index, &parameter)
                .parameter.clear_grad()
        for Parameter<real16b> &parameter = &reflect.each<Parameter<real16b>>(&model)[nat index]
            if parameter.has_grad()
                try .compute16b(index, parameter.raw(), parameter.gradient().untrack())
                if native.optimizer_update_completed() != int32(0)
                    return error("nn.Adam.update failed during computation at " + paths16b[index] + "; model and optimizer state are unspecified; reload a checkpoint and create a new optimizer", code = "NN_UPDATE_FAILED")
                .commit16b(index, &parameter)
                .parameter.clear_grad()
        for Parameter<real32> &parameter = &reflect.each<Parameter<real32>>(&model)[nat index]
            if parameter.has_grad()
                try .compute32(index, parameter.raw(), parameter.gradient().untrack())
                if native.optimizer_update_completed() != int32(0)
                    return error("nn.Adam.update failed during computation at " + paths32[index] + "; model and optimizer state are unspecified; reload a checkpoint and create a new optimizer", code = "NN_UPDATE_FAILED")
                .commit32(index, &parameter)
                .parameter.clear_grad()
        for Parameter<real64> &parameter = &reflect.each<Parameter<real64>>(&model)[nat index]
            if parameter.has_grad()
                try .compute64(index, parameter.raw(), parameter.gradient().untrack())
                if native.optimizer_update_completed() != int32(0)
                    return error("nn.Adam.update failed during computation at " + paths64[index] + "; model and optimizer state are unspecified; reload a checkpoint and create a new optimizer", code = "NN_UPDATE_FAILED")
                .commit64(index, &parameter)
                .parameter.clear_grad()
        return
void | error checkpoint<M>(M &model, Adam<M> optimizer, string path)
    try optimizer.save(&model, path)
    return

void | error resume<M>(M &model, Adam<M> &optimizer, string path)
    try .optimizer.load(&model, path)
    return
