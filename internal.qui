import math
import native = "./native.qui"

// Private implementation helpers for nn.main.qui.
// This module is imported without `public`, so these functions are not part
// of the source-visible nn package API.

// NN's exact ReLU and GELU source expressions. They define the activation
// semantics; fused kernels must reproduce them.
tensor<real32> relu_expression(tensor<real32> value)
    return (value + math.abs(value)) / 2.0

tensor<real32> gelu_expression(tensor<real32> value)
    tensor<real32> cubic = value * value * value
    tensor<real32> inner = (
        value + cubic * real32(0.044715)
    ) * real32(0.7978845608028654)
    tensor<real32> lifted = (
        inner - 20.0 + math.abs(inner + 20.0)
    ) / 2.0
    tensor<real32> limited = (
        lifted + 20.0 - math.abs(lifted - 20.0)
    ) / 2.0
    tensor<real32> exponent = math.exp(limited * 2.0)
    tensor<real32> hyperbolic = (exponent - 1.0) / (exponent + 1.0)
    return value * 0.5 * (1.0 + hyperbolic)

// Fused activation for CPU and Metal real32 tensors, tracked or not: one
// package-native kernel plus one custom autograd node with first- and
// second-order callbacks. A tracked non-contiguous tensor is never
// materialized (that would cut its graph); it and every other backend keep
// the compositional expression.
tensor<real32> fused_activation(tensor<real32> value, int activation)
    int32 device = native.fused_device_f32(value)
    if device >= int32(-1)
        tensor<real32> input = value
        bool dense = input.is_contiguous()
        if not dense and not input.is_tracked()
            input = input.contiguous()
            dense = true
        if dense
            // The device output is write-only (the kernel stores every
            // element); the CPU output stays zeroed.
            tensor<real32> output
            if device == int32(-1)
                output = tensor.zeros<real32>(input.shape())
            else
                output = tensor<real32>(input.shape(), gpu = nat(device))
            if native.activation_f32(input, &output, int64(activation)) == int32(0)
                return output
    if activation == 1
        return relu_expression(value)
    return gelu_expression(value)

tensor<real32> relu_fused(tensor<real32> value)
    return fused_activation(value, 1)

tensor<real32> gelu_fused(tensor<real32> value)
    return fused_activation(value, 2)

// Compiler-selected last-use target. Core proves ownership/liveness only;
// NN owns the ReLU semantics and the actual in-place package-native mutation.
// CPU uses the native loop; CUDA uses NN's exact package-owned PTX epilogue.
// Other devices and tracked values stay compositional.
tensor<real32> relu_reuse(tensor<real32> value)
    if value.is_tracked() or not value.is_contiguous()
        return relu_fused(value)
    if native.is_cpu_f32(value) == int32(1)
        int32 status = native.relu_reuse_f32(&value)
        if status != int32(0)
            error("nn compiler memory-reuse target failed", code = "NN_INTERNAL")
        return value
    if native.cuda_device_f32(value) >= int32(0)
        int32 status = native.cuda_activation_inplace_f32(&value, 1)
        if status == int32(0)
            return value
    return relu_fused(value)

// Compiler-selected training target for statically-known tracked contiguous
// CPU real32 tensors. NN owns the activation and custom-autograd semantics;
// Core only proves the generic replacement constraints.
tensor<real32> relu_training(tensor<real32> value)
    tensor<real32> input = value
    if not input.is_tracked() or not input.is_contiguous() or native.is_cpu_f32(input) != int32(1)
        return relu_fused(input)
    tensor<real32> output = tensor.zeros<real32>(input.shape())
    int32 status = native.relu_training_f32(input, &output)
    if status != int32(0)
        error("nn compiler training ReLU target failed", code = "NN_INTERNAL")
    return output

tensor<real32> mean_all(tensor<real32> value)
    int[] shape = int(value.shape())
    int count = 1
    for auto dimension = shape[]
        if dimension < 0
            error("nn internal mean received an invalid tensor shape", code = "NN_INTERNAL")
        if dimension != 0 and count > 9223372036854775807 / dimension
            error("nn internal mean element count overflows int", code = "NN_SIZE")
        count = count * dimension
    if count == 0
        error("nn internal mean is undefined for an empty tensor", code = "NN_SHAPE")

    // Numerical reduction semantics belong to Math; NN owns only the
    // surrounding model/loss meaning.
    return math.mean(value)

class StateChecksum()

    int first
    int second
    first = 1
    second = 0

    void .update(string text)
        nat8[] bytes = nat8[](text.utf8())
        for auto byte = bytes[]
            first = (first + int(byte)) % 65521
            second = (second + first) % 65521
        first = (first + 10) % 65521
        second = (second + first) % 65521

    string value()
        return second.string() + ":" + first.string()

void | error write_checked_line(
    file.Handle &output,
    StateChecksum &checksum,
    string text
)
    .checksum.update(text)
    try .output.write_line(text)
    return

string | error read_required_line(file.Handle &input, string context)
    string | none | error line = .input.read_line()
    match line
        string
            return line
        none
            return error("nn.load encountered unexpected end of state file while reading " + context, code = "NN_CHECKPOINT_FILE")
        error problem
            return problem

string | error read_checked_line(
    file.Handle &input,
    StateChecksum &checksum,
    string context
)
    string text = try read_required_line(&input, context)
    .checksum.update(text)
    return text

int | error parse_nonnegative_state_int(string text, string context)
    int | error parsed = int.parse(text)
    int value = 0
    match parsed
        int number
            value = number
        error problem
            return error("nn.load invalid " + context, code = "NN_CHECKPOINT_FILE", cause = problem)
    if value < 0
        return error("nn.load encountered a negative " + context, code = "NN_CHECKPOINT_FILE")
    return value

void | error write_state_entry<T: floating>(
    file.Handle &output,
    StateChecksum &checksum,
    string kind,
    string dtype,
    string path,
    tensor<T> value
)
    tensor<T> raw = value
    if raw.is_tracked()
        raw = raw.untrack()
    nat[] shape = raw.shape()
    try write_checked_line(&output, &checksum, kind)
    try write_checked_line(&output, &checksum, dtype)
    try write_checked_line(&output, &checksum, path)
    try write_checked_line(&output, &checksum, len(shape).string())

    int count = 1
    for auto dimension = shape[]
        if dimension > 9223372036854775807
            return error("nn.save tensor dimension exceeds the storage limit", code = "NN_SIZE")
        int extent = int(dimension)
        if extent > 0 and count > 9223372036854775807 / extent
            return error("nn.save tensor element count overflows int", code = "NN_SIZE")
        try write_checked_line(&output, &checksum, dimension.string())
        count = count * extent

    tensor<T> flat = raw.contiguous().reshape([nat(count)])
    try write_checked_line(&output, &checksum, count.string())
    for 0 <= int index < count
        try write_checked_line(
            &output,
            &checksum,
            flat[index].item().string()
        )
    return

// One Parameter's Adam step count (the updates it took) and bias
// corrections c = 1 - beta^count. The model+Adam state stores
// them before the Parameter's moments, in an AdamStep entry: "AdamStep", the
// Parameter's path, the count, and the beta1 and beta2 corrections.
class AdamStep()
    nat count
    real64 first_correction
    real64 second_correction

AdamStep adam_step(nat count, real64 first_correction, real64 second_correction)
    AdamStep step = AdamStep()
    step.count = count
    step.first_correction = first_correction
    step.second_correction = second_correction
    return step

// An error unless the corrections are those of `count` steps: none before
// the first step, and in (0, 1] after it.
void | error check_adam_step(
    nat count,
    real64 first_correction,
    real64 second_correction
)
    if not math.is_finite(first_correction) or not math.is_finite(second_correction)
        return error("nn.Adam.load bias correction must be finite", code = "NN_CHECKPOINT_FILE")
    if count == 0
        if first_correction != 0.0 or second_correction != 0.0
            return error("nn.Adam.load zero-iteration correction state is invalid", code = "NN_CHECKPOINT_FILE")
    else
        if first_correction <= 0.0 or first_correction > 1.0 or second_correction <= 0.0 or second_correction > 1.0
            return error("nn.Adam.load bias correction must be in (0, 1]", code = "NN_CHECKPOINT_FILE")
    return

void | error write_adam_step(
    file.Handle &output,
    StateChecksum &checksum,
    string path,
    nat count,
    real64 first_correction,
    real64 second_correction
)
    try write_checked_line(&output, &checksum, "AdamStep")
    try write_checked_line(&output, &checksum, path)
    try write_checked_line(&output, &checksum, count.string())
    try write_checked_line(&output, &checksum, first_correction.string())
    try write_checked_line(&output, &checksum, second_correction.string())
    return

void | error finish_state_write(
    file.Handle &output,
    StateChecksum checksum
)
    try .output.write_line("ADLER65521-V1")
    try .output.write_line(checksum.value())
    try .output.flush()
    return

void | error verify_state_checksum(
    file.Handle &input,
    StateChecksum checksum
)
    string algorithm = try read_required_line(&input, "checksum algorithm")
    if algorithm != "ADLER65521-V1"
        return error("nn.load state file uses an unsupported checksum algorithm", code = "NN_CHECKPOINT_FILE")
    string expected = try read_required_line(&input, "checksum")
    if expected != checksum.value()
        return error("nn.load state checksum does not match payload", code = "NN_CHECKPOINT_FILE")

    string | none | error trailing = .input.read_line()
    match trailing
        string
            return error("nn.load state file contains trailing data", code = "NN_CHECKPOINT_FILE")
        none
            return
        error problem
            return problem

class StateEntrySchema(local string kind_initial, local string dtype_initial, local string path_initial, local nat[] shape_initial)

    string kind
    string dtype
    string path
    nat[] shape
    kind = kind_initial
    dtype = dtype_initial
    path = path_initial
    shape = shape_initial

class StoredTensor<T: floating>(local StateEntrySchema schema_initial, local tensor<T> value_initial)

    StateEntrySchema schema
    tensor<T> value
    schema = schema_initial
    value = value_initial

string shape_text(nat[] shape)
    string result = "["
    for auto dimension = shape[nat index]
        if index != 0
            result = result + ", "
        result = result + dimension.string()
    return result + "]"

string checkpoint_display_path(string path);

string schema_text(StateEntrySchema entry)
    return checkpoint_display_path(entry.path) + "  " + entry.kind + "<" + entry.dtype + "> " + shape_text(entry.shape)

string difference_group(string title, string[] lines)
    if len(lines) == 0
        return ""
    string result = NL + "  " + title + " (" + len(lines).string() + "):"
    for auto line = lines[nat index]
        if len(lines) > 20 and index >= 10 and index < len(lines) - 10
            if index == 10
                result = result + NL + "    … " + (len(lines) - 20).string() + " more …"
        else
            result = result + NL + "    " + line
    return result

nat | none schema_index(StateEntrySchema[] entries, string path)
    for auto entry = entries[nat index]
        if entry.path == path
            return index
    return none

string schema_rename_hint(StateEntrySchema[] expected, StateEntrySchema[] actual)
    if len(expected) == 0 or len(expected) != len(actual)
        return ""
    string[] first_model = expected[0].path.split(".")
    for auto first_file = actual[]
        string[] file_parts = first_file.path.split(".")
        if len(file_parts) != len(first_model)
            continue
        nat changed = 0
        nat position = 0
        for 0 <= nat index < len(first_model)
            if first_model[index] != file_parts[index]
                changed += 1
                position = index
        if changed != 1
            continue
        string old_name = file_parts[position].split("[")[0]
        string new_name = first_model[position].split("[")[0]
        if old_name == "" or new_name == ""
            continue
        bool old_is_index = false
        nat | error old_index = nat.parse(old_name)
        match old_index
            nat
                old_is_index = true
            error
                old_is_index = false
        bool new_is_index = false
        nat | error new_index = nat.parse(new_name)
        match new_index
            nat
                new_is_index = true
            error
                new_is_index = false
        if old_is_index or new_is_index
            continue
        bool matches = true
        for auto model_entry = expected[]
            string[] model_parts = model_entry.path.split(".")
            bool found = false
            for auto file_entry = actual[]
                string[] parts = file_entry.path.split(".")
                if len(parts) != len(model_parts) or len(parts) <= position
                    continue
                if parts[position].split("[")[0] != old_name or model_parts[position].split("[")[0] != new_name
                    continue
                parts[position] = new_name + parts[position][len(old_name):]
                if parts == model_parts and file_entry.kind == model_entry.kind and file_entry.dtype == model_entry.dtype and file_entry.shape == model_entry.shape
                    found = true
            if not found
                matches = false
        if matches
            return NL + "  likely a renamed field: " + old_name + " -> " + new_name
    return ""

void | error compare_state_schema(
    StateEntrySchema[] expected,
    StateEntrySchema[] actual,
    string file_root,
    string model_root,
    string operation,
    string file_path
)
    string[] missing = []
    string[] unexpected = []
    string[] dtype = []
    string[] shape = []
    StateEntrySchema[] missing_entries = []
    StateEntrySchema[] unexpected_entries = []
    for auto model_entry = expected[nat index]
        for 0 <= nat previous < index
            if expected[previous].path == model_entry.path
                return error(operation + ": model has duplicate checkpoint path '" + model_entry.path + "'; nothing was loaded", code = "NN_CHECKPOINT")
        nat | none found = schema_index(actual, model_entry.path)
        match found
            nat file_index
                StateEntrySchema file_entry = actual[file_index]
                if file_entry.kind != model_entry.kind or file_entry.dtype != model_entry.dtype
                    dtype = dtype.append(checkpoint_display_path(model_entry.path) + "  file " + file_entry.kind + "<" + file_entry.dtype + ">, model " + model_entry.kind + "<" + model_entry.dtype + ">")
                if file_entry.shape != model_entry.shape
                    shape = shape.append(checkpoint_display_path(model_entry.path) + "  file " + shape_text(file_entry.shape) + ", model " + shape_text(model_entry.shape))
            none
                missing = missing.append(schema_text(model_entry))
                missing_entries = missing_entries.append(model_entry)
    for auto file_entry = actual[nat index]
        bool duplicate = false
        for 0 <= nat previous < index
            if actual[previous].path == file_entry.path
                duplicate = true
        nat | none found = schema_index(expected, file_entry.path)
        match found
            nat
                if duplicate
                    unexpected = unexpected.append(schema_text(file_entry) + " (duplicate path)")
                    unexpected_entries = unexpected_entries.append(file_entry)
            none
                unexpected = unexpected.append(schema_text(file_entry))
                unexpected_entries = unexpected_entries.append(file_entry)
    if len(missing) == 0 and len(unexpected) == 0 and len(dtype) == 0 and len(shape) == 0 and file_root == model_root
        return
    string message = operation + ": " + DQ + file_path + DQ + " does not match the model; nothing was loaded"
    message = message + difference_group("missing from the file", missing)
    message = message + difference_group("not in the model", unexpected)
    message = message + difference_group("dtype differs", dtype)
    message = message + difference_group("shape differs", shape)
    if file_root != model_root
        message = message + NL + "  root type differs: file " + file_root + ", model " + model_root
    message = message + schema_rename_hint(missing_entries, unexpected_entries)
    return error(message, code = "NN_CHECKPOINT")

real32 | error parse_state_real32(string text, string context);
real64 | error parse_state_real64(string text, string context);

StoredTensor<real32> | error read_stored_tensor32(file.Handle &input, StateChecksum &checksum)
    string kind = try read_checked_line(&input, &checksum, "field kind")
    string field_type = try read_checked_line(&input, &checksum, "field type")
    string dtype = try read_checked_line(&input, &checksum, "field dtype")
    string path = try read_checked_line(&input, &checksum, "field path")
    if kind != "Parameter" and kind != "State" and kind != "AdamFirst" and kind != "AdamSecond"
        return error("nn.load has an unknown state entry kind", code = "NN_CHECKPOINT_FILE")
    if dtype != "float32" or field_type != kind + "<float32>"
        return error("nn.load has an invalid legacy state entry type", code = "NN_CHECKPOINT_FILE")
    int rank = try parse_nonnegative_state_int(try read_checked_line(&input, &checksum, "tensor rank"), "tensor rank")
    nat[] shape = []
    int expected_count = 1
    for 0 <= int axis < rank
        int dimension = try parse_nonnegative_state_int(try read_checked_line(&input, &checksum, "tensor dimension"), "tensor dimension")
        if dimension > 9223372036854775807
            return error("nn.load tensor dimension exceeds the storage limit", code = "NN_CHECKPOINT_FILE")
        if dimension > 0 and expected_count > 9223372036854775807 / dimension
            return error("nn.load tensor element count overflows the storage limit", code = "NN_CHECKPOINT_FILE")
        expected_count = expected_count * dimension
        shape = shape.append(nat(dimension))
    int count = try parse_nonnegative_state_int(try read_checked_line(&input, &checksum, "tensor element count"), "tensor element count")
    if count != expected_count
        return error("nn.load tensor element count does not match its shape", code = "NN_CHECKPOINT_FILE")
    tensor<real32> flat = tensor.zeros<real32>([nat(count)])
    for 0 <= int index < count
        string value_text = try read_checked_line(&input, &checksum, "tensor value")
        flat[index] = try parse_state_real32(value_text, "tensor value at " + path + "[" + index.string() + "]")
    StateEntrySchema schema = StateEntrySchema(kind_initial = kind, dtype_initial = "real32", path_initial = path, shape_initial = shape)
    return StoredTensor<real32>(schema_initial = schema, value_initial = flat.reshape(shape))

StoredTensor<real64> | error read_stored_tensor64(file.Handle &input, StateChecksum &checksum)
    string kind = try read_checked_line(&input, &checksum, "field kind")
    string field_type = try read_checked_line(&input, &checksum, "field type")
    string dtype = try read_checked_line(&input, &checksum, "field dtype")
    string path = try read_checked_line(&input, &checksum, "field path")
    if kind != "Parameter" and kind != "State" and kind != "AdamFirst" and kind != "AdamSecond"
        return error("nn.load has an unknown state entry kind", code = "NN_CHECKPOINT_FILE")
    if dtype != "float" or field_type != kind + "<float>"
        return error("nn.load has an invalid legacy state entry type", code = "NN_CHECKPOINT_FILE")
    int rank = try parse_nonnegative_state_int(try read_checked_line(&input, &checksum, "tensor rank"), "tensor rank")
    nat[] shape = []
    int expected_count = 1
    for 0 <= int axis < rank
        int dimension = try parse_nonnegative_state_int(try read_checked_line(&input, &checksum, "tensor dimension"), "tensor dimension")
        if dimension > 9223372036854775807
            return error("nn.load tensor dimension exceeds the storage limit", code = "NN_CHECKPOINT_FILE")
        if dimension > 0 and expected_count > 9223372036854775807 / dimension
            return error("nn.load tensor element count overflows the storage limit", code = "NN_CHECKPOINT_FILE")
        expected_count = expected_count * dimension
        shape = shape.append(nat(dimension))
    int count = try parse_nonnegative_state_int(try read_checked_line(&input, &checksum, "tensor element count"), "tensor element count")
    if count != expected_count
        return error("nn.load tensor element count does not match its shape", code = "NN_CHECKPOINT_FILE")
    tensor<real64> flat = tensor.zeros<real64>([nat(count)])
    for 0 <= int index < count
        string value_text = try read_checked_line(&input, &checksum, "tensor value")
        flat[index] = try parse_state_real64(value_text, "tensor value at " + path + "[" + index.string() + "]")
    StateEntrySchema schema = StateEntrySchema(kind_initial = kind, dtype_initial = "real64", path_initial = path, shape_initial = shape)
    return StoredTensor<real64>(schema_initial = schema, value_initial = flat.reshape(shape))

tensor<T> | error select_stored_tensor<T: floating>(const StoredTensor<T>[] entries, string path)
    for auto entry = entries[]
        if entry.schema.path == path
            return entry.value
    return error("nn.load validated checkpoint entry was not found: " + path, code = "NN_INTERNAL")


class StoredAdamStep(local string path_initial, local AdamStep step_initial)

    string path
    AdamStep step
    path = path_initial
    step = step_initial

StoredAdamStep | error read_stored_adam_step(file.Handle &input, StateChecksum &checksum)
    string kind = try read_checked_line(&input, &checksum, "Adam step kind")
    if kind != "AdamStep"
        return error("nn.Adam.load expected an AdamStep entry", code = "NN_CHECKPOINT_FILE")
    string path = try read_checked_line(&input, &checksum, "Adam step path")
    int count = try parse_nonnegative_state_int(try read_checked_line(&input, &checksum, "Adam step count"), "Adam step count")
    real64 first = try parse_state_real64(try read_checked_line(&input, &checksum, "Adam beta1 correction"), "Adam beta1 correction")
    real64 second = try parse_state_real64(try read_checked_line(&input, &checksum, "Adam beta2 correction"), "Adam beta2 correction")
    return StoredAdamStep(path_initial = path, step_initial = adam_step(nat(count), first, second))

AdamStep | error select_adam_step(StoredAdamStep[] entries, string path)
    for auto entry = entries[]
        if entry.path == path
            return entry.step
    return error("nn.Adam.load checked Adam step is missing: " + path, code = "NN_INTERNAL")

StateEntrySchema adam_state_schema(StateEntrySchema entry, string component)
    return StateEntrySchema(kind_initial = entry.kind, dtype_initial = entry.dtype, path_initial = entry.path + " (Adam " + component + ")", shape_initial = entry.shape)

string checkpoint_display_path(string path)
    string[] parts = path.split(" (Adam ")
    if len(parts) > 1
        return parts[0] + " (Adam state)"
    return path


real32 | error parse_state_real32(string text, string context)
    real32 | error parsed = real32.parse(text)
    match parsed
        real32 value
            return value
        error problem
            return error("nn.load invalid " + context, code = "NN_CHECKPOINT_FILE", cause = problem)


real64 | error parse_state_real64(string text, string context)
    real64 | error parsed = real64.parse(text)
    match parsed
        real64 value
            return value
        error problem
            return error("nn.load invalid " + context, code = "NN_CHECKPOINT_FILE", cause = problem)


// Format 5 metadata is read once, independently of the target model. Unknown
// dtype names keep their schema and skip exactly their declared value lines.
class TensorPayload(local StateEntrySchema schema_initial, local int count_initial)

    StateEntrySchema schema
    int count
    schema = schema_initial
    count = count_initial

TensorPayload | error read_tensor_payload(file.Handle &input, StateChecksum &checksum, string expected_kind)
    string kind = try read_checked_line(&input, &checksum, "field kind")
    string dtype = try read_checked_line(&input, &checksum, "field dtype")
    string path = try read_checked_line(&input, &checksum, "field path")
    if expected_kind == ""
        if kind != "Parameter" and kind != "State"
            return error("nn.load has an unknown model entry kind", code = "NN_CHECKPOINT_FILE")
    else
        if kind != expected_kind
            return error("nn.Adam.load expected an " + expected_kind + " entry", code = "NN_CHECKPOINT_FILE")
    int rank = try parse_nonnegative_state_int(try read_checked_line(&input, &checksum, "tensor rank"), "tensor rank")
    nat[] shape = []
    int count = 1
    for 0 <= int axis < rank
        int dimension = try parse_nonnegative_state_int(try read_checked_line(&input, &checksum, "tensor dimension"), "tensor dimension")
        if dimension > 9223372036854775807
            return error("nn.load tensor dimension exceeds the storage limit", code = "NN_CHECKPOINT_FILE")
        if dimension > 0 and count > 9223372036854775807 / dimension
            return error("nn.load tensor element count overflows the storage limit", code = "NN_CHECKPOINT_FILE")
        count = count * dimension
        shape = shape.append(nat(dimension))
    int stored_count = try parse_nonnegative_state_int(try read_checked_line(&input, &checksum, "tensor element count"), "tensor element count")
    if stored_count != count
        return error("nn.load tensor element count does not match its shape", code = "NN_CHECKPOINT_FILE")
    return TensorPayload(schema_initial = StateEntrySchema(kind_initial = kind, dtype_initial = dtype, path_initial = path, shape_initial = shape), count_initial = count)

real16 | error parse_state_real16(string text, string context)
    real16 | error parsed = real16.parse(text)
    match parsed
        real16 value
            return value
        error problem
            return error("nn.load invalid " + context, code = "NN_CHECKPOINT_FILE", cause = problem)

StoredTensor<real16> | error read_tensor_values16(file.Handle &input, StateChecksum &checksum, TensorPayload payload)
    tensor<real16> flat = tensor.zeros<real16>([nat(payload.count)])
    for 0 <= int index < payload.count
        string text = try read_checked_line(&input, &checksum, "tensor value")
        flat[index] = try parse_state_real16(text, "tensor value at " + payload.schema.path + "[" + index.string() + "]")
    return StoredTensor<real16>(schema_initial = payload.schema, value_initial = flat.reshape(payload.schema.shape))

real16b | error parse_state_real16b(string text, string context)
    real16b | error parsed = real16b.parse(text)
    match parsed
        real16b value
            return value
        error problem
            return error("nn.load invalid " + context, code = "NN_CHECKPOINT_FILE", cause = problem)

StoredTensor<real16b> | error read_tensor_values16b(file.Handle &input, StateChecksum &checksum, TensorPayload payload)
    tensor<real16b> flat = tensor.zeros<real16b>([nat(payload.count)])
    for 0 <= int index < payload.count
        string text = try read_checked_line(&input, &checksum, "tensor value")
        flat[index] = try parse_state_real16b(text, "tensor value at " + payload.schema.path + "[" + index.string() + "]")
    return StoredTensor<real16b>(schema_initial = payload.schema, value_initial = flat.reshape(payload.schema.shape))

StoredTensor<real32> | error read_tensor_values32(file.Handle &input, StateChecksum &checksum, TensorPayload payload)
    tensor<real32> flat = tensor.zeros<real32>([nat(payload.count)])
    for 0 <= int index < payload.count
        string text = try read_checked_line(&input, &checksum, "tensor value")
        flat[index] = try parse_state_real32(text, "tensor value at " + payload.schema.path + "[" + index.string() + "]")
    return StoredTensor<real32>(schema_initial = payload.schema, value_initial = flat.reshape(payload.schema.shape))

StoredTensor<real64> | error read_tensor_values64(file.Handle &input, StateChecksum &checksum, TensorPayload payload)
    tensor<real64> flat = tensor.zeros<real64>([nat(payload.count)])
    for 0 <= int index < payload.count
        string text = try read_checked_line(&input, &checksum, "tensor value")
        flat[index] = try parse_state_real64(text, "tensor value at " + payload.schema.path + "[" + index.string() + "]")
    return StoredTensor<real64>(schema_initial = payload.schema, value_initial = flat.reshape(payload.schema.shape))

class StateTable()
    StateEntrySchema[] schemas = []
    StoredTensor<real16>[] values16 = []
    StoredTensor<real16b>[] values16b = []
    StoredTensor<real32>[] values32 = []
    StoredTensor<real64>[] values64 = []

    void | error .read_entry(file.Handle &input, StateChecksum &checksum, string expected_kind = "")
        TensorPayload payload = try read_tensor_payload(&input, &checksum, expected_kind)
        schemas = schemas.append(payload.schema)
        if payload.schema.dtype == "real16"
            StoredTensor<real16> entry = try read_tensor_values16(&input, &checksum, payload)
            values16 = values16.append(entry)
        elif payload.schema.dtype == "real16b"
            StoredTensor<real16b> entry = try read_tensor_values16b(&input, &checksum, payload)
            values16b = values16b.append(entry)
        elif payload.schema.dtype == "real32"
            StoredTensor<real32> entry = try read_tensor_values32(&input, &checksum, payload)
            values32 = values32.append(entry)
        elif payload.schema.dtype == "real64"
            StoredTensor<real64> entry = try read_tensor_values64(&input, &checksum, payload)
            values64 = values64.append(entry)
        else
            for 0 <= int index < payload.count
                string ignored = try read_checked_line(&input, &checksum, "unknown dtype value")
        return

    void | error .read_legacy32(file.Handle &input, StateChecksum &checksum, string expected_kind)
        StoredTensor<real32> entry = try read_stored_tensor32(&input, &checksum)
        if entry.schema.kind != expected_kind
            return error("nn.load has an invalid legacy entry kind", code = "NN_CHECKPOINT_FILE")
        schemas = schemas.append(entry.schema)
        values32 = values32.append(entry)
        return

    void | error .read_legacy64(file.Handle &input, StateChecksum &checksum, string expected_kind)
        StoredTensor<real64> entry = try read_stored_tensor64(&input, &checksum)
        if entry.schema.kind != expected_kind
            return error("nn.load has an invalid legacy entry kind", code = "NN_CHECKPOINT_FILE")
        schemas = schemas.append(entry.schema)
        values64 = values64.append(entry)
        return

StateTable | error read_model_entries(file.Handle &input, StateChecksum &checksum, string version)
    StateTable table = StateTable()
    if version == "5"
        int count = try parse_nonnegative_state_int(try read_checked_line(&input, &checksum, "model entry count"), "model entry count")
        for 0 <= int index < count
            try .table.read_entry(&input, &checksum)
    else
        int count32 = try parse_nonnegative_state_int(try read_checked_line(&input, &checksum, "Parameter<real32> count"), "Parameter<real32> count")
        int count64 = try parse_nonnegative_state_int(try read_checked_line(&input, &checksum, "Parameter<real64> count"), "Parameter<real64> count")
        int state32 = try parse_nonnegative_state_int(try read_checked_line(&input, &checksum, "State<real32> count"), "State<real32> count")
        int state64 = try parse_nonnegative_state_int(try read_checked_line(&input, &checksum, "State<real64> count"), "State<real64> count")
        for 0 <= int index < count32
            try .table.read_legacy32(&input, &checksum, "Parameter")
        for 0 <= int index < count64
            try .table.read_legacy64(&input, &checksum, "Parameter")
        for 0 <= int index < state32
            try .table.read_legacy32(&input, &checksum, "State")
        for 0 <= int index < state64
            try .table.read_legacy64(&input, &checksum, "State")
    return table

void | error validate_model_schema(StateEntrySchema[] entries, string operation)
    for auto entry = entries[nat index]
        for 0 <= nat previous < index
            if entries[previous].path == entry.path
                return error(operation + ": model has duplicate checkpoint path '" + entry.path + "'; nothing was loaded", code = "NN_CHECKPOINT")
    return

StateEntrySchema adam_step_schema(StoredAdamStep entry)
    return StateEntrySchema(kind_initial = "AdamStep", dtype_initial = "real64", path_initial = entry.path + " (Adam step)", shape_initial = [])
