// nn.Adam on Metal against the existing update, after EVERY step, for the
// parameter, the first moment m, the second moment v, the step count and the
// bias corrections:
//   - NN's fused, batched Metal update against the element-wise Adam
//     expressions evaluated with Core/Math Metal kernels (NN's portable
//     path, which nn.Adam also takes when a fused encode is refused);
//   - the same fused update against NN's CPU kernel;
//   - two identical fused runs against each other (determinism).
// Gradients are exact (loss = sum(p * G) with a fixed G per step), so every
// run sees bit-identical gradients and only optimizer arithmetic is compared.
// Parameter d receives its gradient as a strided (transposed) view, as
// nn.FC's weight does from Math's matmul backward.
// Optimizer state is read back from nn.Adam.save after every step.
//
// It also covers optimizers stepping concurrently under task.all and a
// Parameter reached through two fields (tied weights).
//
// Run by real_gpu_integration.sh on a Metal GPU; each check prints one line
// ending in "true" when it passes.
import nn
import math

cli args
    int device = option(default = 0)
    int steps = option(default = 60)
    string scratch = option(default = ".")

// Tolerances. A value passes when |x - reference| <= atol + rtol *
// |reference| for every element after every step; the run prints the
// largest differences it saw.
//   Fused Metal vs element-wise Metal: the same operations in the same order
//   with the same float32 roundings (Core/Math compile their element-wise
//   kernels with fast math, and the fused kernel uses the same square root
//   and division), so bitwise equality is required.
//   Metal vs CPU: the same formula and state transitions, but the CPU
//   compiler may contract multiply-adds into FMAs and the Metal division is
//   not correctly rounded, so last bits differ. The bounds below cover that
//   for this scenario's shapes, gradient scales and Adam settings, also over
//   runs much longer than the default 60 steps.
class Tolerance
    float atol
    float rtol

Tolerance tolerance(float atol, float rtol)
    Tolerance limit
    limit.atol = atol
    limit.rtol = rtol
    return limit

Tolerance bitwise()
    return tolerance(0.0, 0.0)

// Parameter: the two updates stay within about one ulp of the largest |p|,
// which atol 5e-7 with rtol 1e-6 covers.
Tolerance cpu_parameter()
    return tolerance(0.0000005, 0.000001)

// m: m can cancel to ~0, so its error is absolute and grows with the
// gradient magnitude. atol 5e-7 covers this test's gradients (|g| <= 3);
// much larger gradients would need a proportionally larger atol.
Tolerance cpu_first()
    return tolerance(0.0000005, 0.000001)

// v: a decaying sum of g^2 >= 0, so its error is relative and accumulates
// slowly with beta2 = 0.999; rtol 5e-6 covers it without an absolute term.
// v can still be ~0 (masked entries stay 0, the 1e-3-scale gradients give
// v <= 1e-9 after the first step), so the bound keeps an absolute floor,
// 1e-12, far below those values. An atol near the parameter's 5e-7 would
// accept any error of the 1e-3-scale tensor's v.
Tolerance cpu_second()
    return tolerance(0.000000000001, 0.000005)

class Model
    nn.Parameter<float32> a
    nn.Parameter<float32> b
    nn.Parameter<float32> c
    nn.Parameter<float32> d

void report(string name, bool passed)
    print("{name} {passed}{NL}")

int element_count(tensor<float32> value)
    int count = 1
    for extent in value.shape()
        count = count * extent
    return count

tensor<float32> uniform(int[] shape, float scale, int seed)
    int count = 1
    for extent in shape
        count = count * extent
    tensor<float32> samples = nn.uniform_weights(count, scale, seed)
    return samples.reshape(shape)

tensor<float32> host_vector(tensor<float32> value)
    return value.cpu().reshape([element_count(value)])

// The GPU of this run for task.all operations, which take no arguments.
int test_device()
    string | none index = environment.get("QUIDRA_REAL_GPU_INDEX")
    match index
        string
            return int.parse(index)
        none
            return 0

tensor<float32> place(tensor<float32> value, int device)
    if device >= 0
        return value.gpu(device)
    return value

Model make_model(int device)
    Model model
    model.a = nn.Parameter<float32>(value = place(uniform([16, 9], 1.0, 11), device))
    model.b = nn.Parameter<float32>(value = place(uniform([37], 1.0, 12), device))
    model.c = nn.Parameter<float32>(value = place(uniform([2, 4], 1.0, 13), device))
    model.d = nn.Parameter<float32>(value = place(uniform([3, 5], 1.0, 14), device))
    return model

// The gradients of step `step`: large, tiny (v ~ 1e-6), partly zero (v
// stays exactly 0, the update must stay 0) and the transpose of d's.
tensor<float32>[] step_gradients(int step)
    tensor<float32> mask = tensor.zeros<float32>([2, 4])
    mask[0, 0] = float32(1)
    mask[0, 2] = float32(1)
    mask[1, 1] = float32(1)
    mask[1, 3] = float32(1)
    return [
        uniform([16, 9], 3.0, 1000 + step),
        uniform([37], 0.001, 2000 + step),
        uniform([2, 4], 1.0, 3000 + step) * mask,
        uniform([5, 3], 0.5, 4000 + step)
    ]

void train_step(Model &model, nn.Adam &optimizer, tensor<float32>[] gradients, int device)
    tensor<float32> a = model.a.track()
    tensor<float32> b = model.b.track()
    tensor<float32> c = model.c.track()
    tensor<float32> d = model.d.track()
    // d's gradient is gradients[3] transposed: a strided view.
    tensor<float32> loss = (
        math.sum(a * place(gradients[0], device))
        + math.sum(b * place(gradients[1], device))
        + math.sum(c * place(gradients[2], device))
        + math.sum(d.transpose(0, 1) * place(gradients[3], device))
    )
    optimizer.zero_grad(&model)
    loss.backward(&model)
    optimizer.step(&model)

// The element-wise Adam update exactly as nn.Adam writes it (bias correction
// recurrence, folded coefficients, float32 expressions), on `device`.
class Replica
    tensor<float32>[] parameters
    tensor<float32>[] first
    tensor<float32>[] second
    int iteration
    float first_correction
    float second_correction

Replica make_replica(Model model)
    Replica replica
    replica.parameters = [model.a.raw(), model.b.raw(), model.c.raw(), model.d.raw()]
    replica.first = []
    replica.second = []
    for parameter in replica.parameters
        tensor<float32> zero = parameter * float32(0)
        replica.first = replica.first.append(zero)
        replica.second = replica.second.append(zero)
    replica.iteration = 0
    replica.first_correction = 0.0
    replica.second_correction = 0.0
    return replica

void replica_step(Replica &replica, tensor<float32>[] gradients, float rate, int device)
    float first_decay = 0.9
    float second_decay = 0.999
    float stability = 0.00000001
    replica.iteration = replica.iteration + 1
    float one_minus_beta1 = 1.0 - first_decay
    float one_minus_beta2 = 1.0 - second_decay
    replica.first_correction = (
        replica.first_correction
        + (1.0 - replica.first_correction) * one_minus_beta1
    )
    replica.second_correction = (
        replica.second_correction
        + (1.0 - replica.second_correction) * one_minus_beta2
    )
    float correction2_root = math.sqrt(replica.second_correction)
    float step_scale = rate * correction2_root / replica.first_correction
    float adjusted_epsilon = stability * correction2_root
    float32 beta1_32 = float32(first_decay)
    float32 beta2_32 = float32(second_decay)
    float32 one_minus_beta1_32 = float32(1.0 - first_decay)
    float32 one_minus_beta2_32 = float32(1.0 - second_decay)
    float32 adjusted_epsilon32 = float32(adjusted_epsilon)
    float32 step_scale32 = float32(step_scale)
    for index in range(len(replica.parameters))
        tensor<float32> gradient = place(gradients[index], device)
        if index == 3
            gradient = gradient.transpose(0, 1)
        tensor<float32> first = (
            replica.first[index] * beta1_32
            + gradient * one_minus_beta1_32
        )
        tensor<float32> second = (
            replica.second[index] * beta2_32
            + gradient * gradient * one_minus_beta2_32
        )
        tensor<float32> denominator = (
            math.sqrt(second) + adjusted_epsilon32
        )
        replica.parameters[index] = (
            replica.parameters[index] - (first / denominator) * step_scale32
        )
        replica.first[index] = first
        replica.second[index] = second

// Adam state as written by nn.Adam.save (round-trip decimal text).
class AdamState
    tensor<float32>[] parameters
    tensor<float32>[] first
    tensor<float32>[] second
    int iteration
    float first_correction
    float second_correction

tensor<float32> | error read_block(string[] lines, int start)
    // kind, type, dtype, path, rank, extents..., count, values...
    int rank = try int.parse(lines[start + 4])
    int count = try int.parse(lines[start + 5 + rank])
    tensor<float32> samples = tensor.zeros<float32>([count])
    int first_value = start + 6 + rank
    for index in range(count)
        samples[index] = float32(try float.parse(lines[first_value + index]))
    return samples

AdamState | error read_state(string path)
    file.Handle input = try file.open(path)
    string[] lines = []
    bool reading = true
    while reading
        string | none | error line = input.read_line()
        match line
            string
                lines = lines.append(line)
            none
                reading = false
            error problem
                return problem
    AdamState state
    state.parameters = []
    state.first = []
    state.second = []
    state.iteration = -1
    state.first_correction = 0.0
    state.second_correction = 0.0
    for index in range(len(lines) - 1)
        string kind = lines[index]
        string type_name = lines[index + 1]
        if kind == "Parameter" and type_name == "Parameter<float32>"
            state.parameters = state.parameters.append(try read_block(lines, index))
        elif kind == "AdamFirst" and type_name == "AdamFirst<float32>"
            state.first = state.first.append(try read_block(lines, index))
        elif kind == "AdamSecond" and type_name == "AdamSecond<float32>"
            state.second = state.second.append(try read_block(lines, index))
        elif kind == "Adam" and index + 7 < len(lines)
            state.iteration = try int.parse(lines[index + 5])
            state.first_correction = try float.parse(lines[index + 6])
            state.second_correction = try float.parse(lines[index + 7])
    return state

AdamState | error saved_state(Model model, nn.Adam optimizer, string path)
    try optimizer.save(model, path)
    return try read_state(path)

class Difference
    float absolute
    float relative

float max_abs(tensor<float32> left, tensor<float32> right)
    return float(math.max_all(math.abs(host_vector(left) - host_vector(right))).item())

// Largest |x - reference| - rtol * |reference| over all elements; a value is
// within tolerance when this is <= atol.
float excess(tensor<float32> value, tensor<float32> reference, float rtol)
    tensor<float32> x = host_vector(value)
    tensor<float32> r = host_vector(reference)
    float32 factor = float32(rtol)
    return float(math.max_all(math.abs(x - r) - math.abs(r) * factor).item())

bool identical(tensor<float32> left, tensor<float32> right)
    tensor<float32> a = host_vector(left)
    tensor<float32> b = host_vector(right)
    if element_count(a) != element_count(b)
        return false
    for index in range(element_count(a))
        if a[index].item() != b[index].item()
            return false
    return true

class Tally
    Tolerance parameter_limit
    Tolerance first_limit
    Tolerance second_limit
    float parameter_abs
    float first_abs
    float second_abs
    bool within
    int mismatched_steps

Tally make_tally(Tolerance parameter_limit, Tolerance first_limit, Tolerance second_limit)
    Tally tally
    tally.parameter_limit = parameter_limit
    tally.first_limit = first_limit
    tally.second_limit = second_limit
    tally.parameter_abs = 0.0
    tally.first_abs = 0.0
    tally.second_abs = 0.0
    tally.within = true
    tally.mismatched_steps = 0
    return tally

bool within(tensor<float32> value, tensor<float32> reference, float atol, float rtol)
    if atol == 0.0 and rtol == 0.0
        return identical(value, reference)
    return excess(value, reference, rtol) <= atol

void add(Tally &tally, tensor<float32>[] parameters, tensor<float32>[] first, tensor<float32>[] second, AdamState reference)
    bool bitwise_step = true
    for index in range(len(parameters))
        tally.parameter_abs = math.max(tally.parameter_abs, max_abs(parameters[index], reference.parameters[index]))
        tally.first_abs = math.max(tally.first_abs, max_abs(first[index], reference.first[index]))
        tally.second_abs = math.max(tally.second_abs, max_abs(second[index], reference.second[index]))
        tally.within = tally.within and within(parameters[index], reference.parameters[index], tally.parameter_limit.atol, tally.parameter_limit.rtol)
        tally.within = tally.within and within(first[index], reference.first[index], tally.first_limit.atol, tally.first_limit.rtol)
        tally.within = tally.within and within(second[index], reference.second[index], tally.second_limit.atol, tally.second_limit.rtol)
        bitwise_step = bitwise_step and identical(parameters[index], reference.parameters[index])
        bitwise_step = bitwise_step and identical(first[index], reference.first[index])
        bitwise_step = bitwise_step and identical(second[index], reference.second[index])
    if not bitwise_step
        tally.mismatched_steps = tally.mismatched_steps + 1

void | error state_checks(int device, int steps, string scratch)
    float rate = 0.01
    Model host = make_model(-1)
    Model metal = make_model(device)
    Model again = make_model(device)
    nn.Adam host_optimizer = try nn.Adam(rate = rate)
    nn.Adam metal_optimizer = try nn.Adam(rate = rate)
    nn.Adam again_optimizer = try nn.Adam(rate = rate)
    Replica replica = make_replica(metal)
    Tally versus_elementwise = make_tally(bitwise(), bitwise(), bitwise())
    Tally versus_cpu = make_tally(cpu_parameter(), cpu_first(), cpu_second())
    bool bookkeeping = true
    bool deterministic = true
    bool zero_gradient_fixed = true
    tensor<float32> c_initial = metal.c.raw().cpu()
    for step in range(steps)
        tensor<float32>[] gradients = step_gradients(step)
        train_step(&host, &host_optimizer, gradients, -1)
        train_step(&metal, &metal_optimizer, gradients, device)
        train_step(&again, &again_optimizer, gradients, device)
        replica_step(&replica, gradients, rate, device)

        AdamState host_state = try saved_state(host, host_optimizer, "{scratch}/adam_host.state")
        AdamState metal_state = try saved_state(metal, metal_optimizer, "{scratch}/adam_metal.state")
        AdamState again_state = try saved_state(again, again_optimizer, "{scratch}/adam_again.state")

        // Step count and bias corrections are host float64 values: exact.
        bool counters = (
            metal_state.iteration == step + 1
            and host_state.iteration == metal_state.iteration
            and metal_state.first_correction == replica.first_correction
            and metal_state.second_correction == replica.second_correction
            and host_state.first_correction == metal_state.first_correction
            and host_state.second_correction == metal_state.second_correction
        )
        bookkeeping = bookkeeping and counters and len(metal_state.parameters) == 4 and len(metal_state.first) == 4 and len(metal_state.second) == 4 and len(host_state.parameters) == 4

        add(&versus_elementwise, replica.parameters, replica.first, replica.second, metal_state)
        add(&versus_cpu, host_state.parameters, host_state.first, host_state.second, metal_state)
        for index in range(4)
            deterministic = deterministic and identical(metal_state.parameters[index], again_state.parameters[index])
            deterministic = deterministic and identical(metal_state.first[index], again_state.first[index])
            deterministic = deterministic and identical(metal_state.second[index], again_state.second[index])
        // Entries whose gradient is always 0 keep m = v = 0 and never move.
        tensor<float32> c_now = metal.c.raw().cpu()
        zero_gradient_fixed = zero_gradient_fixed and c_now[0, 1].item() == c_initial[0, 1].item() and c_now[1, 2].item() == c_initial[1, 2].item()

    print("adam metal-fused vs metal-elementwise over {steps} steps: max abs parameter {versus_elementwise.parameter_abs} m {versus_elementwise.first_abs} v {versus_elementwise.second_abs}; steps not bitwise {versus_elementwise.mismatched_steps}{NL}")
    print("adam metal-fused vs cpu over {steps} steps: max abs parameter {versus_cpu.parameter_abs} m {versus_cpu.first_abs} v {versus_cpu.second_abs}; steps not bitwise {versus_cpu.mismatched_steps}{NL}")
    report("metal adam step count and corrections", bookkeeping)
    report("metal adam matches elementwise metal", versus_elementwise.within)
    report("metal adam matches cpu", versus_cpu.within)
    report("metal adam deterministic", deterministic)
    report("metal adam zero gradients", zero_gradient_fixed)
    return

// Independent optimizers stepping at the same time must not see each other's
// batches: the parallel results equal the serial ones bit for bit.
class Small
    nn.Parameter<float32> a
    nn.Parameter<float32> b

float train_small(int seed)
    int device = test_device()
    Small model
    model.a = nn.Parameter<float32>(value = uniform([64], 1.0, seed).gpu(device))
    model.b = nn.Parameter<float32>(value = uniform([16], 1.0, seed + 1).gpu(device))
    nn.Adam optimizer = nn.Adam(rate = 0.01)
    for step in range(60)
        tensor<float32> a = model.a.track()
        tensor<float32> b = model.b.track()
        tensor<float32> loss = math.sum(a * a) + math.sum(b * b * b * b)
        optimizer.zero_grad(&model)
        loss.backward(&model)
        optimizer.step(&model)
    return float(math.sum(model.a.raw()).cpu().item()) + float(math.sum(model.b.raw()).cpu().item())

float train1()
    return train_small(11)

float train2()
    return train_small(21)

float train3()
    return train_small(31)

float train4()
    return train_small(41)

void concurrency_check()
    float[] serial = [train1(), train2(), train3(), train4()]
    bool same = true
    for round in range(3)
        float[] parallel = task.all([train1, train2, train3, train4])
        for index in range(4)
            same = same and parallel[index] == serial[index]
    report("metal adam concurrent optimizers", same)

// One Parameter reached through two fields is updated once per occurrence,
// each reading the previous occurrence's result (the sequential update).
class Tied
    nn.Parameter<float32> first
    nn.Parameter<float32> second

tensor<float32> train_tied(int device)
    nn.Parameter<float32> shared = nn.Parameter<float32>(value = place(uniform([8], 1.0, 5), device))
    Tied model
    model.first = shared
    model.second = shared
    nn.Adam optimizer = nn.Adam(rate = 0.1)
    for step in range(5)
        tensor<float32> value = model.first.track()
        tensor<float32> loss = math.sum(value * value)
        optimizer.zero_grad(&model)
        loss.backward(&model)
        optimizer.step(&model)
    return model.first.raw().cpu()

void tied_check(int device)
    tensor<float32> host = train_tied(-1)
    tensor<float32> metal = train_tied(device)
    report("metal adam tied parameters", max_abs(host, metal) <= 0.000001)

void | error run(int device, int steps, string scratch)
    try state_checks(device, steps, scratch)
    concurrency_check()
    tied_check(device)
    return

run(args.device, args.steps, args.scratch)
