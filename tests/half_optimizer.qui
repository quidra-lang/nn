// Independent elementwise real32 reference, with one narrowing store.
import nn
import math
import probe = "../native.qui"

cli args
    int device = option(default = -1)
    bool metal = flag()

void report(string name, bool result)
    print("{name} {result}{NL}")

tensor<T> placed<T: floating>(tensor<T> value, int device)
    if device >= 0
        return value.gpu(nat(device))
    return value

bool same_bits<T: floating>(tensor<T> left, tensor<T> right)
    tensor<real32> a = real32(left.cpu())
    tensor<real32> b = real32(right.cpu())
    if a.shape() != b.shape()
        return false
    for 0 <= nat i < a.shape()[0]
        if probe.real32_bits(a[i].item()) != probe.real32_bits(b[i].item())
            return false
    return true

void check<T: floating>(string label, tensor<T> seed, tensor<T> gradient, int device, bool metal)
    tensor<T> reference = seed
    tensor<T> parameter = placed(seed, device)
    tensor<T> g = placed(gradient, device)
    tensor<real32> first = placed(tensor.zeros<real32>(seed.shape()), device)
    tensor<real32> second = placed(tensor.zeros<real32>(seed.shape()), device)
    tensor<real32> reference_first = tensor.zeros<real32>(seed.shape())
    tensor<real32> reference_second = tensor.zeros<real32>(seed.shape())
    tensor<T> next = placed(tensor.zeros<T>(seed.shape()), device)
    bool equal = true
    for 0 <= int step < 8
        tensor<real32> dense = real32(gradient)
        reference_first = reference_first * real32(0.5) + dense * real32(0.5)
        reference_second = reference_second * real32(0.5) + (dense * dense) * real32(0.5)
        tensor<real32> denominator = math.sqrt(reference_second) + real32(0.125)
        reference = T(real32(reference) - (reference_first / denominator) * real32(0.125))
        int32 status = 0
        if device >= 0 and not metal
            tensor<real32> dense_device = real32(g)
            first = first * real32(0.5) + dense_device * real32(0.5)
            second = second * real32(0.5) + (dense_device * dense_device) * real32(0.5)
            next = T(real32(parameter) - (first / (math.sqrt(second) + real32(0.125))) * real32(0.125))
        else
            status = probe.adam_half_update<T>(parameter, g, &first, &second, &next,
                0.5, 0.5, 0.5, 0.5, 0.125, 0.125)
        equal = equal and status == 0 and same_bits(next, reference)
        equal = equal and same_bits(first, reference_first) and same_bits(second, reference_second)
        tensor<T> old = parameter
        parameter = next
        next = old
    report(label + " Adam state every step", equal)
    tensor<T> expected = T(real32(seed) - real32(gradient) * real32(0.125))
    int32 status = 1
    if metal
        status = probe.sgd_half_metal_update<T>(placed(seed, device), g, &next, 0.125)
    elif device < 0
        status = probe.sgd_update<T>(seed, gradient, &next, 0.125)
    else
        // The fake backend exercises the portable expression, not Metal.
        next = T(real32(placed(seed, device)) - real32(g) * real32(0.125))
        status = 0
    report(label + " SGD one store", status == 0 and same_bits(next, expected))

real32[] weights = [real32(-0.0), real32(0.0), real32(1.0), real32(-1.0), real32(0.5), real32(-0.5)]
real32[] gradients = [real32(0.0), real32(-0.0), real32(0.25), real32(-0.25),
    real32(0.000000059604644775390625), real32(-0.000000059604644775390625)]
tensor<real32> weight = tensor.zeros<real32>([6])
tensor<real32> gradient = tensor.zeros<real32>([6])
for 0 <= nat i < 6
    weight[i] = weights[i]
    gradient[i] = gradients[i]
if args.metal
    int64 enabled = probe.half_exact_probe(int64(args.device), int32(1))
    report("Metal exact probe enabled", enabled == 0)
check<real16>("real16", real16(weight), real16(gradient), args.device, args.metal)
gradient[4] = real32(0.00000000000000000000000000000000000000009183549615799121)
gradient[5] = real32(-0.00000000000000000000000000000000000000009183549615799121)
check<real16b>("real16b", real16b(weight), real16b(gradient), args.device, args.metal)
if args.metal
    int64 exact_count = probe.half_exact_probe(int64(args.device), int32(2))
    report("Metal integer path exercised", exact_count > 0)
    int64 disabled = probe.half_exact_probe(int64(args.device), int32(0))
    report("Metal exact probe disabled", disabled == 0)
report("half signed zeros", probe.half_widen(nat16(32768), int32(0)) == nat32(2147483648)
    and probe.half_narrow(nat32(2147483648), int32(0)) == int64(32768))
report("half subnormal boundary", probe.half_widen(nat16(1), int32(0)) == nat32(864026624)
    and probe.half_narrow(nat32(864026624), int32(0)) == int64(1))
report("half halfway ties even", probe.half_narrow(nat32(1065357312), int32(0)) == int64(15360)
    and probe.half_narrow(nat32(1065365504), int32(0)) == int64(15362))
report("half carry and overflow", probe.half_narrow(nat32(1199562752), int32(0)) == int64(31743)
    and probe.half_narrow(nat32(1199566848), int32(0)) == int64(-1))
report("bfloat subnormal and carry", probe.half_widen(nat16(1), int32(1)) == nat32(65536)
    and probe.half_narrow(nat32(65536), int32(1)) == int64(1)
    and probe.half_narrow(nat32(1065320448), int32(1)) == int64(16256))
