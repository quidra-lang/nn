import nn
import math

class FCModel()
    nn.FC dense

class ConvModel()
    nn.Conv2D convolution

class NormModel()
    nn.BatchNorm normalization

class ParameterModel()
    nn.Parameter<real32> value

bool near(real32 a, real32 b)
    real32 d = a - b
    return d > real32(-0.0005) and d < real32(0.0005)

int | error run()
    nn.Parameter<real32> cpu_linear_weight = nn.Parameter<real32>(value = tensor.ones<real32>([1, 2]))
    nn.Parameter<real32> cpu_linear_bias = nn.Parameter<real32>(value = tensor.zeros<real32>([1]))
    nn.FC cpu_linear = nn.FC(
        2, 1,
        initial_weight = cpu_linear_weight, initial_bias = cpu_linear_bias
    )
    nn.Parameter<real32> gpu_linear_weight = nn.Parameter<real32>(value = tensor.ones<real32>([1, 2], gpu = 0))
    nn.Parameter<real32> gpu_linear_bias = nn.Parameter<real32>(value = tensor.zeros<real32>([1], gpu = 0))
    nn.FC gpu_linear = nn.FC(
        2, 1,
        initial_weight = gpu_linear_weight, initial_bias = gpu_linear_bias
    )
    FCModel cpu_linear_model = FCModel()
    cpu_linear_model.dense = cpu_linear
    FCModel gpu_linear_model = FCModel()
    gpu_linear_model.dense = gpu_linear
    tensor<real32> cpu_samples = tensor.ones<real32>([1, 2])
    tensor<real32> gpu_samples = cpu_samples.gpu(0)
    tensor<real32> cpu_linear_out = .cpu_linear_model.dense.forward(cpu_samples)
    tensor<real32> gpu_linear_out = .gpu_linear_model.dense.forward(gpu_samples).cpu()
    print(near(cpu_linear_out[0, 0].item(), gpu_linear_out[0, 0].item()))
    print(NL)

    tensor<real32> cpu_linear_target = tensor.zeros<real32>([1, 1])
    tensor<real32> gpu_linear_target = cpu_linear_target.gpu(0)
    tensor<real32> cpu_linear_loss = nn.mse(
        .cpu_linear_model.dense.forward(cpu_samples.track()), cpu_linear_target
    )
    tensor<real32> gpu_linear_loss = nn.mse(
        .gpu_linear_model.dense.forward(gpu_samples.track()), gpu_linear_target
    )
    auto cpu_linear_sgd = try nn.SGD(&cpu_linear_model, rate = 0.1)
    auto gpu_linear_sgd = try nn.SGD(&gpu_linear_model, rate = 0.1)
    cpu_linear_loss.backward(&cpu_linear_model)
    gpu_linear_loss.backward(&gpu_linear_model)
    .cpu_linear_sgd.update()
    .gpu_linear_sgd.update()
    tensor<real32> gpu_linear_weight_updated = gpu_linear_model.dense.weight.raw().cpu()
    tensor<real32> gpu_linear_bias_updated = gpu_linear_model.dense.bias.raw().cpu()
    print(
        near(cpu_linear_model.dense.weight.raw()[0, 0].item(), gpu_linear_weight_updated[0, 0].item())
        and near(cpu_linear_model.dense.bias.raw()[0].item(), gpu_linear_bias_updated[0].item())
    )
    print(NL)

    nn.Parameter<real32> cpu_conv_weight = nn.Parameter<real32>(value = tensor.ones<real32>([1, 1, 1, 1]))
    nn.Parameter<real32> cpu_conv_bias = nn.Parameter<real32>(value = tensor.zeros<real32>([1]))
    nn.Conv2D cpu_conv = nn.Conv2D(
        1, 1, 1, stride = 1, padding = 0, groups = 1,
        initial_weight = cpu_conv_weight, initial_bias = cpu_conv_bias
    )
    nn.Parameter<real32> gpu_conv_weight = nn.Parameter<real32>(value = tensor.ones<real32>([1, 1, 1, 1], gpu = 0))
    nn.Parameter<real32> gpu_conv_bias = nn.Parameter<real32>(value = tensor.zeros<real32>([1], gpu = 0))
    nn.Conv2D gpu_conv = nn.Conv2D(
        1, 1, 1, stride = 1, padding = 0, groups = 1,
        initial_weight = gpu_conv_weight, initial_bias = gpu_conv_bias
    )
    ConvModel cpu_conv_model = ConvModel()
    cpu_conv_model.convolution = cpu_conv
    ConvModel gpu_conv_model = ConvModel()
    gpu_conv_model.convolution = gpu_conv
    tensor<real32> cpu_pixels = tensor.ones<real32>([1, 1, 2, 2])
    tensor<real32> gpu_pixels = cpu_pixels.gpu(0)
    tensor<real32> cpu_conv_out = .cpu_conv_model.convolution.forward(cpu_pixels)
    tensor<real32> gpu_conv_out = .gpu_conv_model.convolution.forward(gpu_pixels).cpu()
    print(near(cpu_conv_out[0, 0, 1, 1].item(), gpu_conv_out[0, 0, 1, 1].item()))
    print(NL)

    tensor<real32> cpu_zero_image = tensor.zeros<real32>([1, 1, 2, 2])
    tensor<real32> gpu_zero_image = cpu_zero_image.gpu(0)
    tensor<real32> cpu_conv_loss = nn.mse(
        .cpu_conv_model.convolution.forward(cpu_pixels.track()), cpu_zero_image
    )
    tensor<real32> gpu_conv_loss = nn.mse(
        .gpu_conv_model.convolution.forward(gpu_pixels.track()), gpu_zero_image
    )
    auto cpu_conv_sgd = try nn.SGD(&cpu_conv_model, rate = 0.1)
    auto gpu_conv_sgd = try nn.SGD(&gpu_conv_model, rate = 0.1)
    cpu_conv_loss.backward(&cpu_conv_model)
    gpu_conv_loss.backward(&gpu_conv_model)
    .cpu_conv_sgd.update()
    .gpu_conv_sgd.update()
    tensor<real32> gpu_conv_weight_updated = gpu_conv_model.convolution.weight.raw().cpu()
    tensor<real32> gpu_conv_bias_updated = gpu_conv_model.convolution.bias.raw().cpu()
    print(
        near(cpu_conv_model.convolution.weight.raw()[0, 0, 0, 0].item(), gpu_conv_weight_updated[0, 0, 0, 0].item())
        and near(cpu_conv_model.convolution.bias.raw()[0].item(), gpu_conv_bias_updated[0].item())
    )
    print(NL)

    nn.Parameter<real32> cpu_norm_scale = nn.Parameter<real32>(value = tensor.ones<real32>([2]))
    nn.Parameter<real32> cpu_norm_bias = nn.Parameter<real32>(value = tensor.zeros<real32>([2]))
    nn.State<real32> cpu_norm_running_mean = nn.State<real32>(value = tensor.zeros<real32>([2]))
    nn.State<real32> cpu_norm_running_variance = nn.State<real32>(value = tensor.ones<real32>([2]))
    real32 cpu_norm_running_momentum = 0.1
    real32 cpu_norm_variance_epsilon = 0.00001
    nn.BatchNorm cpu_norm = nn.BatchNorm(
        2,
        initial_scale = cpu_norm_scale, initial_bias = cpu_norm_bias,
        initial_mean = cpu_norm_running_mean, initial_variance = cpu_norm_running_variance,
        initial_momentum = cpu_norm_running_momentum, initial_epsilon = cpu_norm_variance_epsilon
    )
    nn.Parameter<real32> gpu_norm_scale = nn.Parameter<real32>(value = tensor.ones<real32>([2], gpu = 0))
    nn.Parameter<real32> gpu_norm_bias = nn.Parameter<real32>(value = tensor.zeros<real32>([2], gpu = 0))
    nn.State<real32> gpu_norm_running_mean = nn.State<real32>(value = tensor.zeros<real32>([2], gpu = 0))
    nn.State<real32> gpu_norm_running_variance = nn.State<real32>(value = tensor.ones<real32>([2], gpu = 0))
    real32 gpu_norm_running_momentum = 0.1
    real32 gpu_norm_variance_epsilon = 0.00001
    nn.BatchNorm gpu_norm = nn.BatchNorm(
        2,
        initial_scale = gpu_norm_scale, initial_bias = gpu_norm_bias,
        initial_mean = gpu_norm_running_mean, initial_variance = gpu_norm_running_variance,
        initial_momentum = gpu_norm_running_momentum, initial_epsilon = gpu_norm_variance_epsilon
    )
    NormModel cpu_norm_model = NormModel()
    cpu_norm_model.normalization = cpu_norm
    NormModel gpu_norm_model = NormModel()
    gpu_norm_model.normalization = gpu_norm
    tensor<real32> cpu_norm_input = tensor.zeros<real32>([2, 2])
    cpu_norm_input[0, 0] = real32(1)
    cpu_norm_input[0, 1] = real32(2)
    cpu_norm_input[1, 0] = real32(3)
    cpu_norm_input[1, 1] = real32(5)
    tensor<real32> gpu_norm_input = cpu_norm_input.gpu(0)
    tensor<real32> cpu_norm_out = .cpu_norm_model.normalization.forward(cpu_norm_input.track())
    tensor<real32> gpu_norm_out = .gpu_norm_model.normalization.forward(gpu_norm_input.track())
    tensor<real32> cpu_norm_values = cpu_norm_out.untrack()
    tensor<real32> gpu_norm_values = gpu_norm_out.untrack().cpu()
    print(
        near(cpu_norm_values[0, 0].item(), gpu_norm_values[0, 0].item())
        and near(cpu_norm_values[1, 1].item(), gpu_norm_values[1, 1].item())
    )
    print(NL)
    tensor<real32> cpu_norm_loss = math.mean(cpu_norm_out * cpu_norm_out)
    tensor<real32> gpu_norm_loss = math.mean(gpu_norm_out * gpu_norm_out)
    auto cpu_norm_sgd = try nn.SGD(&cpu_norm_model, rate = 0.1)
    auto gpu_norm_sgd = try nn.SGD(&gpu_norm_model, rate = 0.1)
    cpu_norm_loss.backward(&cpu_norm_model)
    gpu_norm_loss.backward(&gpu_norm_model)
    .cpu_norm_sgd.update()
    .gpu_norm_sgd.update()
    tensor<real32> gpu_norm_scale_updated = gpu_norm_model.normalization.scale.raw().cpu()
    tensor<real32> gpu_norm_bias_updated = gpu_norm_model.normalization.bias.raw().cpu()
    tensor<real32> cpu_norm_infer = .cpu_norm_model.normalization.infer(cpu_norm_input)
    tensor<real32> gpu_norm_infer = .gpu_norm_model.normalization.infer(gpu_norm_input).cpu()
    print(
        near(cpu_norm_model.normalization.scale.raw()[0].item(), gpu_norm_scale_updated[0].item())
        and near(cpu_norm_model.normalization.bias.raw()[1].item(), gpu_norm_bias_updated[1].item())
        and near(cpu_norm_infer[0, 0].item(), gpu_norm_infer[0, 0].item())
        and near(cpu_norm_infer[1, 1].item(), gpu_norm_infer[1, 1].item())
    )
    print(NL)

    ParameterModel cpu_dropout_model = ParameterModel()
    cpu_dropout_model.value = nn.Parameter<real32>(value = tensor.ones<real32>([2, 2]))
    ParameterModel gpu_dropout_model = ParameterModel()
    gpu_dropout_model.value = nn.Parameter<real32>(value = tensor.ones<real32>([2, 2], gpu = 0))
    nn.Dropout cpu_dropout = nn.Dropout(rate = 0.5, seed = 29)
    nn.Dropout gpu_dropout = nn.Dropout(rate = 0.5, seed = 29)
    tensor<real32> cpu_dropout_out = .cpu_dropout.forward(.cpu_dropout_model.value.track())
    tensor<real32> gpu_dropout_out = .gpu_dropout.forward(.gpu_dropout_model.value.track())
    tensor<real32> cpu_dropout_values = cpu_dropout_out.untrack()
    tensor<real32> gpu_dropout_values = gpu_dropout_out.untrack().cpu()
    tensor<real32> cpu_dropout_next = .cpu_dropout.forward(.cpu_dropout_model.value.track())
    tensor<real32> gpu_dropout_next = .gpu_dropout.forward(.gpu_dropout_model.value.track())
    tensor<real32> cpu_dropout_next_values = cpu_dropout_next.untrack()
    tensor<real32> gpu_dropout_next_values = gpu_dropout_next.untrack().cpu()
    print(
        near(cpu_dropout_values[0, 0].item(), gpu_dropout_values[0, 0].item())
        and near(cpu_dropout_values[0, 1].item(), gpu_dropout_values[0, 1].item())
        and near(cpu_dropout_values[1, 0].item(), gpu_dropout_values[1, 0].item())
        and near(cpu_dropout_values[1, 1].item(), gpu_dropout_values[1, 1].item())
        and near(cpu_dropout_next_values[0, 0].item(), gpu_dropout_next_values[0, 0].item())
        and near(cpu_dropout_next_values[0, 1].item(), gpu_dropout_next_values[0, 1].item())
        and near(cpu_dropout_next_values[1, 0].item(), gpu_dropout_next_values[1, 0].item())
        and near(cpu_dropout_next_values[1, 1].item(), gpu_dropout_next_values[1, 1].item())
    )
    print(NL)
    tensor<real32> cpu_dropout_loss = math.mean(cpu_dropout_out)
    tensor<real32> gpu_dropout_loss = math.mean(gpu_dropout_out)
    auto cpu_dropout_sgd = try nn.SGD(&cpu_dropout_model, rate = 0.1)
    auto gpu_dropout_sgd = try nn.SGD(&gpu_dropout_model, rate = 0.1)
    cpu_dropout_loss.backward(&cpu_dropout_model)
    gpu_dropout_loss.backward(&gpu_dropout_model)
    .cpu_dropout_sgd.update()
    .gpu_dropout_sgd.update()
    tensor<real32> gpu_dropout_weight = gpu_dropout_model.value.raw().cpu()
    print(
        near(cpu_dropout_model.value.raw()[0, 0].item(), gpu_dropout_weight[0, 0].item())
        and near(cpu_dropout_model.value.raw()[0, 1].item(), gpu_dropout_weight[0, 1].item())
        and near(cpu_dropout_model.value.raw()[1, 0].item(), gpu_dropout_weight[1, 0].item())
        and near(cpu_dropout_model.value.raw()[1, 1].item(), gpu_dropout_weight[1, 1].item())
    )
    print(NL)

    nn.Parameter<real32> cpu_adam_layer_weight = nn.Parameter<real32>(value = tensor.ones<real32>([1, 1]))
    nn.Parameter<real32> cpu_adam_layer_bias = nn.Parameter<real32>(value = tensor.zeros<real32>([1]))
    nn.FC cpu_adam_layer = nn.FC(
        1, 1,
        initial_weight = cpu_adam_layer_weight, initial_bias = cpu_adam_layer_bias
    )
    nn.Parameter<real32> gpu_adam_layer_weight = nn.Parameter<real32>(value = tensor.ones<real32>([1, 1], gpu = 0))
    nn.Parameter<real32> gpu_adam_layer_bias = nn.Parameter<real32>(value = tensor.zeros<real32>([1], gpu = 0))
    nn.FC gpu_adam_layer = nn.FC(
        1, 1,
        initial_weight = gpu_adam_layer_weight, initial_bias = gpu_adam_layer_bias
    )
    FCModel cpu_adam_model = FCModel()
    cpu_adam_model.dense = cpu_adam_layer
    FCModel gpu_adam_model = FCModel()
    gpu_adam_model.dense = gpu_adam_layer
    tensor<real32> cpu_adam_input = tensor.ones<real32>([1, 1])
    tensor<real32> gpu_adam_input = cpu_adam_input.gpu(0)
    tensor<real32> cpu_adam_target = tensor.zeros<real32>([1, 1])
    tensor<real32> gpu_adam_target = cpu_adam_target.gpu(0)
    tensor<real32> cpu_adam_loss = nn.mse(
        .cpu_adam_model.dense.forward(cpu_adam_input.track()), cpu_adam_target
    )
    tensor<real32> gpu_adam_loss = nn.mse(
        .gpu_adam_model.dense.forward(gpu_adam_input.track()), gpu_adam_target
    )
    auto cpu_adam = try nn.Adam(&cpu_adam_model, rate = 0.1)
    auto gpu_adam = try nn.Adam(&gpu_adam_model, rate = 0.1)
    cpu_adam_loss.backward(&cpu_adam_model)
    gpu_adam_loss.backward(&gpu_adam_model)
    .cpu_adam.update()
    .gpu_adam.update()
    tensor<real32> gpu_adam_weight = gpu_adam_model.dense.weight.raw().cpu()
    tensor<real32> gpu_adam_bias = gpu_adam_model.dense.bias.raw().cpu()
    bool first_adam_match = near(
        cpu_adam_model.dense.weight.raw()[0, 0].item(),
        gpu_adam_weight[0, 0].item()
    ) and near(
        cpu_adam_model.dense.bias.raw()[0].item(),
        gpu_adam_bias[0].item()
    )
    tensor<real32> cpu_adam_loss2 = nn.mse(
        .cpu_adam_model.dense.forward(cpu_adam_input.track()), cpu_adam_target
    )
    tensor<real32> gpu_adam_loss2 = nn.mse(
        .gpu_adam_model.dense.forward(gpu_adam_input.track()), gpu_adam_target
    )
    cpu_adam_loss2.backward(&cpu_adam_model)
    gpu_adam_loss2.backward(&gpu_adam_model)
    .cpu_adam.update()
    .gpu_adam.update()
    tensor<real32> gpu_adam_weight2 = gpu_adam_model.dense.weight.raw().cpu()
    tensor<real32> gpu_adam_bias2 = gpu_adam_model.dense.bias.raw().cpu()
    print(
        first_adam_match
        and near(cpu_adam_model.dense.weight.raw()[0, 0].item(), gpu_adam_weight2[0, 0].item())
        and near(cpu_adam_model.dense.bias.raw()[0].item(), gpu_adam_bias2[0].item())
    )
    print(NL)

    ParameterModel cpu_accumulation_model = ParameterModel()
    cpu_accumulation_model.value = nn.Parameter<real32>(value = tensor.ones<real32>([1]))
    ParameterModel gpu_accumulation_model = ParameterModel()
    gpu_accumulation_model.value = nn.Parameter<real32>(value = tensor.ones<real32>([1], gpu = 0))
    tensor<real32> cpu_accumulation_value = .cpu_accumulation_model.value.track()
    tensor<real32> gpu_accumulation_value = .gpu_accumulation_model.value.track()
    tensor<real32> cpu_accumulation_loss = math.mean(cpu_accumulation_value + cpu_accumulation_value)
    tensor<real32> gpu_accumulation_loss = math.mean(gpu_accumulation_value + gpu_accumulation_value)
    auto cpu_accumulation_sgd = try nn.SGD(&cpu_accumulation_model, rate = 0.1)
    auto gpu_accumulation_sgd = try nn.SGD(&gpu_accumulation_model, rate = 0.1)
    cpu_accumulation_loss.backward(&cpu_accumulation_model)
    gpu_accumulation_loss.backward(&gpu_accumulation_model)
    .cpu_accumulation_sgd.update()
    .gpu_accumulation_sgd.update()
    real32 cpu_accumulation_after = cpu_accumulation_model.value.raw()[0].item()
    real32 gpu_accumulation_after = gpu_accumulation_model.value.raw()[0].item()
    print(
        near(cpu_accumulation_after, gpu_accumulation_after)
        and cpu_accumulation_after > real32(0.7999)
        and cpu_accumulation_after < real32(0.8001)
    )
    print(NL)

    // CPU ReLU/GELU run NN's fused kernels; the test backend keeps the
    // compositional expression. Values and gradients must agree.
    tensor<real32> activation_input = tensor.zeros<real32>([1, 6])
    activation_input[0, 0] = real32(-3)
    activation_input[0, 1] = real32(-0.5)
    activation_input[0, 2] = real32(0)
    activation_input[0, 3] = real32(0.25)
    activation_input[0, 4] = real32(1.5)
    activation_input[0, 5] = real32(7)
    bool activation_values_match = true
    bool activation_gradients_match = true
    for 0 <= nat activation < 2
        tensor<real32> cpu_activation_input = activation_input.track()
        tensor<real32> gpu_activation_input = activation_input.gpu(0).track()
        tensor<real32> cpu_activation_output
        tensor<real32> gpu_activation_output
        if activation == 0
            cpu_activation_output = nn.relu(cpu_activation_input)
            gpu_activation_output = nn.relu(gpu_activation_input)
        else
            cpu_activation_output = nn.gelu(cpu_activation_input)
            gpu_activation_output = nn.gelu(gpu_activation_input)
        math.mean(cpu_activation_output * cpu_activation_output).backward(&cpu_activation_input)
        math.mean(gpu_activation_output * gpu_activation_output).backward(&gpu_activation_input)
        tensor<real32> cpu_activation_values = cpu_activation_output.untrack()
        tensor<real32> gpu_activation_values = gpu_activation_output.untrack().cpu()
        tensor<real32> cpu_activation_gradient = cpu_activation_input.grad.untrack()
        tensor<real32> gpu_activation_gradient = gpu_activation_input.grad.untrack().cpu()
        for 0 <= nat column < 6
            activation_values_match = activation_values_match and near(cpu_activation_values[0, column].item(), gpu_activation_values[0, column].item())
            activation_gradients_match = activation_gradients_match and near(cpu_activation_gradient[0, column].item(), gpu_activation_gradient[0, column].item())
    print(activation_values_match)
    print(NL)
    print(activation_gradients_match)
    print(NL)
    return 0

auto | error result = run()
match result
    int
        int ignored = result
    error problem
        print(problem)
        print(NL)
