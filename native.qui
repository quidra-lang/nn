// Private package-native bridge. Tensor arguments are explicit borrowed
// references; native code receives opaque handles and uses Core's stable
// qcore tensor ABI rather than private runtime structures.
extern int32 is_cpu_f32(
    const tensor<real32> input
) = "nn_native_is_cpu_f32"

extern int32 relu_reuse_f32(
    tensor<real32> &value
) = "nn_native_relu_reuse_f32"

extern int32 relu_training_f32(
    const tensor<real32> input,
    tensor<real32> &output
) = "nn_native_relu_training_f32"

extern int32 cuda_device_f32(
    const tensor<real32> input
) = "nn_native_cuda_device_f32"

// Device index of a real32 tensor on a Metal GPU (any layout), or -1. NN's
// Metal kernels are compiled only on macOS; other platforms always answer -1.
extern int32 metal_device_f32(
    const tensor<real32> input
) = "nn_native_metal_device_f32"

// Exact package-owned CUDA activation epilogue. The activation id is private
// NN policy: 1 = ReLU expression, 2 = GELU expression.
extern int32 cuda_activation_inplace_f32(
    tensor<real32> &value,
    int64 activation
) = "nn_cuda_activation_inplace_f32"

// Package-owned fused kernels for real32 tensors, tracked or not.
// fused_device_f32 answers -1 for CPU, the Metal device index, or -2 when no
// fused NN kernel serves the tensor's backend. The activation id is NN
// policy shared with the CUDA epilogue: 1 = ReLU expression, 2 = GELU.
extern int32 fused_device_f32(
    const tensor<real32> input
) = "nn_native_fused_device_f32"

extern int32 activation_f32(
    const tensor<real32> input,
    tensor<real32> &output,
    int64 activation
) = "nn_native_activation_f32"

extern int32 global_average_pool2d_f32(
    const tensor<real32> input,
    tensor<real32> &output
) = "nn_native_global_average_pool2d_f32"

extern int32 fc_relu_inference_f32(
    const tensor<real32> input,
    const tensor<real32> weight,
    const tensor<real32> bias,
    tensor<real32> &output
) = "nn_native_fc_relu_inference_f32"

extern int32 fc_gelu_inference_f32(
    const tensor<real32> input,
    const tensor<real32> weight,
    const tensor<real32> bias,
    tensor<real32> &output
) = "nn_native_fc_gelu_inference_f32"

extern int32 conv2d_cuda_f32(
    const tensor<real32> input,
    const tensor<real32> weight,
    const tensor<real32> bias,
    tensor<real32> &output,
    int64 stride,
    int64 padding,
    int64 groups
) = "nn_native_conv2d_cuda_f32"

// NN-owned direct convolution with one custom autograd node. The native
// dispatcher selects the CPU or Metal kernel from the tensors' backend.
extern int32 conv2d_f32(
    const tensor<real32> input,
    const tensor<real32> weight,
    const tensor<real32> bias,
    tensor<real32> &output,
    int64 stride,
    int64 padding,
    int64 groups
) = "nn_native_conv2d_f32"

// Metal Conv2D followed by an NN activation (1 = ReLU, 2 = GELU) in one GPU
// round trip, with the same two custom autograd nodes as the separate
// operations. Other backends answer an error.
extern int32 conv2d_activation_f32(
    const tensor<real32> input,
    const tensor<real32> weight,
    const tensor<real32> bias,
    tensor<real32> &conv_output,
    tensor<real32> &activation_output,
    int64 stride,
    int64 padding,
    int64 groups,
    int64 activation
) = "nn_native_conv2d_activation_f32"

extern int32 conv2d_relu_inference_f32(
    const tensor<real32> input,
    const tensor<real32> weight,
    const tensor<real32> bias,
    tensor<real32> &output,
    int64 stride,
    int64 padding,
    int64 groups
) = "nn_native_conv2d_relu_inference_f32"

extern int32 conv2d_gelu_inference_f32(
    const tensor<real32> input,
    const tensor<real32> weight,
    const tensor<real32> bias,
    tensor<real32> &output,
    int64 stride,
    int64 padding,
    int64 groups
) = "nn_native_conv2d_gelu_inference_f32"

extern int32 im2col_f32(
    const tensor<real32> input,
    tensor<real32> &output,
    int64 channels,
    int64 height,
    int64 width,
    int64 kernel_height,
    int64 kernel_width,
    int64 stride,
    int64 output_height,
    int64 output_width
) = "nn_native_im2col_f32"


// Package-owned NCCL bridge. Generic tensor externs keep dtype specialization
// in Quidra while the C ABI remains one opaque tensor-handle signature.
extern int32 nccl_begin(int64 count) = "nn_native_nccl_begin"

extern int32 nccl_register<T: floating>(
    const tensor<T> value,
    int64 destination,
    int64 rank
) = "nn_native_nccl_register"

extern int32 nccl_commit() = "nn_native_nccl_commit"
extern int32 nccl_cancel() = "nn_native_nccl_cancel"
extern int32 nccl_group_start() = "nn_native_nccl_group_start"

extern int32 nccl_all_reduce<T: floating>(
    tensor<T> &value,
    int64 rank
) = "nn_native_nccl_all_reduce"

extern int32 nccl_group_end() = "nn_native_nccl_group_end"

// One call owns the complete group and validation reservations. Status1 means
// no collective was queued; other nonzero statuses cannot use a fallback.
extern int32 nccl_collective<T: floating>(tensor<T>[] &values) = "nn_native_nccl_collective"

// Called with a fresh readonly borrow only after the existing group closes.
extern int32 nccl_validate_output<T: floating>(const tensor<T> value) = "nn_native_nccl_validate_output"


// Metal fused Adam update of one real32 Parameter, encoded into Core's
// command stream: moments are updated in place, and the next Parameter is
// written to its scratch buffer. Statuses 1..5 refuse before computation;
// statuses >=6 may follow writes and must not retry the update.
extern int32 adam_metal_update(
    const tensor<real32> parameter,
    const tensor<real32> gradient,
    tensor<real32> &first,
    tensor<real32> &second,
    tensor<real32> &next_parameter,
    real64 beta1,
    real64 beta2,
    real64 one_minus_beta1,
    real64 one_minus_beta2,
    real64 adjusted_epsilon,
    real64 step_scale
) = "nn_native_adam_metal_update"

// CPU fused Adam update with the same contract as the Metal one. Parameter
// replacement remains explicit in NN Quidra code.
extern int32 is_cpu_floating<T: floating>(
    const tensor<T> value
) = "nn_native_is_cpu_floating"

extern int32 adam_update<T: floating>(
    const tensor<T> parameter,
    const tensor<T> gradient,
    tensor<T> &first,
    tensor<T> &second,
    tensor<T> &next_parameter,
    real64 beta1,
    real64 beta2,
    real64 one_minus_beta1,
    real64 one_minus_beta2,
    real64 adjusted_epsilon,
    real64 step_scale
) = "nn_native_adam_update"

// Explicit fixture hook; disabled unless a test arms a positive countdown.
extern void optimizer_failure_after(int64 updates) = "nn_native_optimizer_failure_after"
extern int32 optimizer_update_completed() = "nn_native_optimizer_update_completed"

extern int32 sgd_update<T: floating>(const tensor<T> parameter, const tensor<T> gradient, tensor<T> &next_parameter, real64 rate) = "nn_native_sgd_update"
extern int32 sgd_metal_update(const tensor<real32> parameter, const tensor<real32> gradient, tensor<real32> &next_parameter, real64 rate) = "nn_native_sgd_metal_update"

extern int32 adam_half_update<T: floating>(const tensor<T> parameter, const tensor<T> gradient, tensor<real32> &first, tensor<real32> &second, tensor<T> &next_parameter, real64 beta1, real64 beta2, real64 one_minus_beta1, real64 one_minus_beta2, real64 epsilon, real64 scale) = "nn_native_adam_half_update"
extern int32 sgd_half_metal_update<T: floating>(const tensor<T> parameter, const tensor<T> gradient, tensor<T> &next_parameter, real64 rate) = "nn_native_sgd_half_metal_update"
extern nat32 half_widen(nat16 value, int32 bfloat) = "nn_native_half_widen"
extern int64 half_narrow(nat32 value, int32 bfloat) = "nn_native_half_narrow"

// Explicit Metal test probe: enable/reset=1, read=2, disable=0.
extern int64 half_exact_probe(int64 device, int32 mode) = "nn_native_half_exact_probe"
extern nat32 real32_bits(real32 value) = "nn_native_real32_bits"

// Integer encodings only: 1 widen, 2 narrow (65536 means rejected),
// 3 add, 4 multiply, 5 divide, 6 sqrt; bfloat selects the storage format.
extern int32 half_probe_words(const tensor<nat32> left, const tensor<nat32> right, tensor<nat32> &output, int32 operation, int32 bfloat) = "nn_native_half_probe_words"
