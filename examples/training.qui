import nn

class Model()
    nn.FC hidden
    nn.FC output

void train()
    model := Model()
    model.hidden = nn.FC(features_in = 2, features_out = 4)
    model.output = nn.FC(features_in = 4, features_out = 1, seed = 2)
    optimizer := nn.SGD(&model, rate = 0.1)

    tensor<real32> samples := tensor.ones([1, 2])
    tensor<real32> targets := tensor.ones([1, 1])

    first := nn.mse(
        .model.output.forward(
            nn.relu(.model.hidden.forward(samples.track()))
        ),
        targets
    )
    print.line(first.item())

    latest := first.item()
    for 0 <= nat iteration < 100
        activated := nn.relu(
            .model.hidden.forward(samples.track())
        )
        loss := nn.mse(.model.output.forward(activated), targets)

        loss.backward(&model)
        .optimizer.update()

        latest = loss.item()

    print.line(latest)
    print.line(latest < first.item())

if main
    train()
